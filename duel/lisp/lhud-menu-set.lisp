;;;; lhud-menu-set.lisp — SETTINGS and CONTROLS drawn by Lisp (docs/duel/DUEL_LISP_HUD.md §15; menu.css #s-settings, #s-controls,
;;;; .side-title, .set, .opt, .drops, .tabs, .kbd, .binds, .phone; menu.js renderSettings / renderControls / buildKbd / PHONE_SVG).
;;;; Each screen: a system (the focus bar, the help line's height, the arrows, each option's slab and colour, the drops; the tabs'
;;;; slabs, the capture's pulse) from the model (V1 the cursor, V40-47 the settings, V9 / V10 / V50-57 the controls) and a view.
(in-package :duel)

;;; ---------------------------------------------------------------- the side title (.side-title: the kanji, the h1, the paragraph)
(defun-fast lm-side-title (k h1 para)
  "menu.css .side-title at *LM-G* [7] x / [8] top: K (800 clamp(28px, 4vw, 52px) Mincho blood .1em), H1 (900 [9] / .8 upper -.01em),
PARA (400 14px / 1.75 steel, [10] wide; none when 0), 18 apart."
  (declare (simple-string k h1 para))
  (let* ((d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))) (x (f-floor+ (lmg 7))) (y (lmg 8))
         (kz (css (if narrow 28f0 (f-max 28f0 (f-min (* 0.04f0 (lm-cw)) 52f0))))) (hz (lmg 9)) (pw (lmg 10)))
    (declare (single-float d x y kz hz pw))
    (paint-reset)
    (lm-text k +f-kanji+ +c-blood+ x (f-floor+ (lm-base y +f-kanji+ kz 1f0)) kz :spacing 0.1f0)
    (setf y (+ y kz (css 18f0)))
    (lm-text h1 +f-display+ +c-paper+ x (f-floor+ (lm-base y +f-display+ hz 0.8f0)) hz :spacing -0.01f0)
    (setf y (+ y (* 0.8f0 hz) (css 18f0)))
    (when (> pw 0f0)
      (paint-pen! x (f-floor+ y) (css 14f0) :edge +es4+)
      (paint-paragraph para +f-sans+ +c-steel+ :width pw :lh 1.75f0))
    nil))

;;; ---------------------------------------------------------------- SETTINGS
(defconstant +set-k+ 15 "Transitions a SETTINGS row: [0] the focus bar, [1] the help's max-height (0..60 CSS px), [2] the arrows,
[3 + 2j] option j's slab, [4 + 2j] its colour (a drop: [3 + 2j] on, [4 + 2j] current).")
(declaim (type f32vec *lm-set-tr*))
(defvar *lm-set-tr* (make-transitions (* +lm-set-rows+ +set-k+) 0f0) "SETTINGS' transitions (+SET-K+ a row).")
(defparameter +c-drop+ (rgba #x3a3f4e))

(defun-fast lm-settings-update ()
  "SETTINGS' system: the cursor's bar (.3s ease-out), help (max-height .4s ease-out) and arrows (.2s); each option's slab (.3s
ease-out) and colour (.2s); the drops' on / current (.25s)."
  (when (= (uv 0) 3)
    (let* ((now (aref *ui-clock* 0)) (tr *lm-set-tr*) (cur (uv 1)) (snap (lm-entered-p)))
      (declare (single-float now) (fixnum cur))
      (macrolet ((to (i v dur curve) `(trans-to tr ,i ,v now (if snap 0f0 ,dur) ,curve)))
        (dotimes (i +lm-set-rows+)
          (let* ((b (* i +set-k+)) (f (if (= i cur) 1f0 0f0)))
            (declare (fixnum b) (single-float f))
            (to b f 0.3f0 +ease-out+) (to (+ b 1) (* 60f0 f) 0.4f0 +ease-out+) (to (+ b 2) f 0.2f0 +ease+)
            (when (< i (length *lm-settings*))
              (let* ((row (svref *lm-settings* i)) (v (uv (+ 40 i))) (drops (third row)))
                (declare (fixnum v))
                (dotimes (j (length (the simple-vector (second row))))
                  (if drops
                      (progn (to (+ b 3 (* 2 j)) (if (<= j v) 1f0 0f0) 0.25f0 +ease+) (to (+ b 4 (* 2 j)) (if (= j v) 1f0 0f0) 0.25f0 +ease-out+))
                      (progn (to (+ b 3 (* 2 j)) (if (= j v) 1f0 0f0) 0.3f0 +ease-out+) (to (+ b 4 (* 2 j)) (if (= j v) 1f0 0f0) 0.2f0 +ease+)))))))))))
  nil)

(defun-fast lm-choices-w (i)
  "Row I's .choices width (device px): the arrows (28, desktop), its options (15px .12em + 24) or drops (5-6 x 9, 7 apart, padded 10),
2 apart: into *LM-G2* [12] (a float returned would be boxed)."
  (declare (fixnum i))
  (let* ((row (svref *lm-settings* i)) (opts (second row)) (n (length (the simple-vector opts))) (narrow (lm-narrow-p (lm-cw)))
         (w (if narrow 0f0 (+ (css 56f0) (css 4f0)))))
    (declare (fixnum n) (single-float w))
    (if (third row)
        (incf w (+ (css 20f0) (* (i->f n) (css 9f0)) (* (i->f (1- n)) (css 7f0))))
        (dotimes (j n) (incf w (+ (lm-dw (svref opts j) (css 15f0) 0.12f0) (css 24f0) (if (> j 0) (css 2f0) 0f0)))))
    (setf (aref *lm-g2* 12) w)
    nil))

(defun-fast lm-set-row-w (i)
  "Row I's width (device px, *LM-G2* [14]) and its help's line count ([15]): the list's width [5], or on a narrow window with V41 = 1
(menu.js's `left` class: justify-items: start) its fit-content, min(the list's width, the max-content of the label + 18 + the choices
or of the help line, + the padding); the help wraps inside it (12px sans)."
  (declare (fixnum i))
  (let* ((narrow (lm-narrow-p (lm-cw))) (setting (< i (length *lm-settings*)))
         (row (if setting (svref *lm-settings* i) (svref *lm-set-extra* (- i (length *lm-settings*)))))
         (lab (first row)) (help (if setting (fourth row) (second row))) (pl (css (if narrow 16f0 20f0))) (pr (css (if narrow 10f0 18f0)))
         (lz (css (if narrow 19f0 22f0))) (cw (if setting (progn (lm-choices-w i) (aref *lm-g2* 12)) 0f0)) (w (lmg 5)))
    (declare (single-float pl pr lz cw w))
    (when (and narrow (= (uv 41) 1))
      (setf w (f-min w (+ pl (f-max (+ (lm-dw lab lz 0.08f0) (css 18f0) cw) (if help (text-w help +f-sans+ (css 12f0) 0f0) 0f0)) pr))))
    (setf (aref *lm-g2* 14) w (aref *lm-g2* 15) 0f0)
    (when help
      (paint-pen! 0f0 0f0 (css 12f0))
      (setf (aref *lm-g2* 15) (i->f (paint-measure-paragraph help +f-sans+ :width (- w pl pr)))))
    nil))

(defun-fast lm-set-row (i)
  "SETTINGS row I at its top *LM-G* [16 + I] (the list's left [4], width [5]): the focus wash and bar, the label, the choices (arrows,
options with their slabs or the drops), the help line clipped to its max-height, the rule; hot boxes for the row, each option and
arrow."
  (declare (fixnum i))
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (tr *lm-set-tr*) (b (* i +set-k+)) (narrow (lm-narrow-p (lm-cw))) (cmp (aref *lm-g* 11))
         (setting (< i (length *lm-settings*))) (row (if setting (svref *lm-settings* i) (svref *lm-set-extra* (- i (length *lm-settings*)))))
         (lab (first row)) (help (if setting (fourth row) (second row)))
         (pt (css (if narrow 9f0 (if (> cmp 0f0) 10f0 14f0)))) (pl (css (if narrow 16f0 20f0))) (pr (css (if narrow 10f0 18f0)))
         (lz (css (if narrow 19f0 22f0))) (mainh (css (if setting (if (third row) 28f0 31f0) (if narrow 19f0 22f0))))
         (kh (aref *lm-g2* i))
         (x (lmg 4)) (y (* d (aref *lm-g* (+ 16 i)))) (w (progn (lm-set-row-w i) (aref *lm-g2* 14)))
         (cw (if setting (progn (lm-choices-w i) (aref *lm-g2* 12)) 0f0))
         (h (* d (lm-set-row-h i cmp kh))) (kb (trans-value tr b now)) (foc (= i (uv 1))))
    (declare (fixnum b) (single-float now d cmp pt pl pr lz mainh kh x y w cw h kb))
    (paint-reset)
    (lm-hot 3 i x y (+ x w) (+ y h))
    (when foc
      (lm-set! *lm-pts* x y (+ x w) y (+ x w) (+ y h) x (+ y h))
      (paint-clip! x y (+ x w) (+ y h)) (paint-grad! x 0f0 (+ x (* 0.7f0 w)) 0f0)
      (paint-poly *lm-pts* 4 +c-set-wash+ +c-set-wash0+))
    (when (> kb 0.002f0)                                  ; the bar: 3 px, inset by the padding, scaleY from its middle
      (let* ((bt (+ y pt)) (bb (- (+ y h) pt (if (< i 9) 0f0 0f0))) (bm (* 0.5f0 (+ bt bb))) (bh (* kb 0.5f0 (- bb bt))))
        (declare (single-float bt bb bm bh))
        (paint-rect x (- bm bh) (css 3f0) (* 2f0 bh) +c-blood+)))
    (paint-rect x (- (+ y h) d) w d +c-rule+)
    (let* ((cy (+ y pt (* 0.5f0 (f-max mainh lz)))))
      (declare (single-float cy))
      (lm-text lab +f-display+ (if setting +c-paper+ +c-stone+) (f-floor+ (+ x pl)) (f-floor+ (+ (- cy (* 0.5f0 lz)) (line-baseline +f-display+ lz 1f0)))
               lz :spacing 0.08f0 :edge +ed8+)
      (when setting
        (let* ((opts (second row)) (n (length (the simple-vector opts))) (v (uv (+ 40 i))) (cx (- (+ x w) pr cw)) (ka (trans-value tr (+ b 2) now)))
          (declare (fixnum n v) (single-float cx ka))
          (macrolet ((arrow (s dir)
                       `(progn
                          (lm-hot 5 (+ (* 10 i) ,dir) cx (- cy (css 14f0)) (+ cx (css 28f0)) (+ cy (css 14f0)))
                          (when (> ka 0.002f0)
                            (with-col (c +c-stone+) (col-alpha! c ka)
                              (lm-lane! (+ cx (css 14f0)) cy (css 11f0)) (lm-shape-glyph ,s 0 c)))
                          (setf cx (+ cx (css 28f0) (css 2f0))))))
            (unless narrow (arrow (lhud-shape "◀") 0))
            (if (third row)
                (let* ((dx (+ cx (css 10f0))))                 ; the drops: 9 wide, 10 + 4j tall, bottom-aligned in 28
                  (declare (single-float dx))
                  (dotimes (j n)
                    (let* ((on (trans-value tr (+ b 3 (* 2 j)) now)) (ck (trans-value tr (+ b 4 (* 2 j)) now))
                           (dh (css (+ 10f0 (* 4f0 (i->f j))))) (sc (+ 1f0 (* 0.15f0 ck))) (bot (+ (- cy (css 14f0)) (css 28f0)))
                           (c (col-mix! *lhud-mix* +c-drop+ +c-paper+ on)))
                      (declare (single-float on ck dh sc bot))
                      (lm-hot 4 (+ (* 10 i) j) (- dx (css 3.5f0)) (- cy (css 14f0)) (+ dx (css 12.5f0)) (+ cy (css 14f0)))
                      (with-col (cc c)
                        (let* ((bl +c-blood+)) (declare (type f32vec bl))
                          (dotimes (q 4) (setf (aref cc q) (+ (aref cc q) (* ck (- (aref bl q) (aref cc q)))))))
                        (paint-ellipse! (+ dx (css 4.5f0)) (- bot (* 0.5f0 dh sc)) (* sc (css 4.5f0)) (* 0.5f0 sc dh) cc))
                      (setf dx (+ dx (css 9f0) (css 7f0)))))
                  (setf cx (+ dx (css -7f0) (css 10f0) (css 2f0))))
                (dotimes (j n)                                ; the options: 800 15px .12em, padded 8 12, the slab under the current
                  (let* ((s (svref opts j)) (ow (+ (lm-dw s (css 15f0) 0.12f0) (css 24f0))) (ks (trans-value tr (+ b 3 (* 2 j)) now))
                         (kc (trans-value tr (+ b 4 (* 2 j)) now)) (oy (- cy (css 15.5f0))))
                    (declare (single-float ow ks kc oy))
                    (lm-hot 4 (+ (* 10 i) j) cx oy (+ cx ow) (+ oy (css 31f0)))
                    (lm-lane! cx oy (+ cx ow) (+ oy (css 31f0)))
                    (lm-slab ks +c-paper+)
                    (lm-text s +f-display+ (col-mix! *lhud-mix* +c-stone+ +c-ink+ kc) (f-floor+ (+ cx (css 12f0))) (f-floor+ (+ oy (css 8f0) (line-baseline +f-display+ (css 15f0) 1f0)))
                             (css 15f0) :spacing 0.12f0 :edge +ed8+)
                    (setf cx (+ cx ow (css 2f0))))))
            (unless narrow (arrow (lhud-shape "▶") 1)))))
      ;; the help: 400 12px / 1.6 stone, under the row's first line (gap 6), clipped to its max-height
      (when (and help (> kh 0.002f0))
        (let* ((hy (+ y pt (f-max mainh lz) (css 6f0))))
          (declare (single-float hy))
          (paint-push)
          (paint-scissor! -1f5 hy 1f5 (+ hy (* kh (css 19.2f0))))
          (paint-pen! (f-floor+ (+ x pl)) (f-floor+ hy) (css 12f0) :edge +es4+)
          (paint-paragraph help +f-sans+ +c-stone+ :width (- w pl pr) :lh 1.6f0)
          (paint-pop)))))
  nil)

(defun-fast lm-settings ()
  "SETTINGS: the side title (設定, SETTINGS, the paragraph) and the nine rows (the seven settings, RESET LEARNING, BACK)."
  (lm-begin-geom)
  (let* ((hv *lm-g2*) (now (aref *ui-clock* 0)))
    (declare (single-float now) (type f32vec hv))
    (dotimes (i +lm-set-rows+)                            ; (the help's height: min(its lines x 19.2, the max-height tween), in lines)
      (lm-set-row-w i)
      (setf (aref hv i) (/ (f-min (* 19.2f0 (aref *lm-g2* 15)) (trans-value *lm-set-tr* (+ 1 (* i +set-k+)) now)) 19.2f0)))
    (lm-set-geom! *lm-g* (lm-cw) (lm-ch) hv))
  (lm-side-title (bigkj "設定") "SETTINGS" *lm-set-p*)
  (dotimes (i +lm-set-rows+) (lm-set-row i))
  nil)

;;; ---------------------------------------------------------------- CONTROLS
(declaim (type f32vec *lm-ctl-tr* *lm-thumb*))
(defvar *lm-ctl-tr* (make-transitions 8 0f0) "CONTROLS: [0..3] the column tabs' slabs (.3s ease-out), [4..7] their colour (.2s).")
(defparameter *lm-thumb* (make-tween '((0 nil 0 0) (0.12 nil 0 0) (0.16 nil 0 1) (0.3 nil 0 1) (0.4 nil -46 1) (0.46 nil -46 0) (1 nil -46 0))
                                     :dur 4.8 :iter -1 :curve +ease-cut+ :base '(0 0))
  "menu.css thumb: the phone card's thumb rises 46 px and fades, 4.8s ease-cut infinite (y CSS px, opacity).")
(defparameter +c-phone+ (rgba #x0e1016)) (defparameter +c-zone-hi+ (rgba #xe81e3a 0.12)) (defparameter +c-zone-lo+ (rgba #xeeeeea 0.06))
(defparameter +c-zone-lo-line+ (rgba #x5a6072)) (defparameter +c-thumb+ (rgba #xeeeeea 0.18))

(defun-fast lm-controls-update ()
  "CONTROLS' system: the column tabs' slabs and colours (V9 mod 10)."
  (when (= (uv 0) 4)
    (let* ((now (aref *ui-clock* 0)) (col (mod (max 0 (uv 9)) 10)) (snap (lm-entered-p)))
      (declare (single-float now) (fixnum col))
      (dotimes (k 4)
        (trans-to *lm-ctl-tr* k (if (= k col) 1f0 0f0) now (if snap 0f0 0.3f0) +ease-out+)
        (trans-to *lm-ctl-tr* (+ 4 k) (if (= k col) 1f0 0f0) now (if snap 0f0 0.2f0) +ease+))))
  nil)

(defun-fast-inline lm-dashed-rect (x y w h col)
  "A dashed 1 px outline (stroke-dasharray 4 5) of the rect at X Y W H (device px; the dashes in CSS px times *LM-A* [15], the card's
scale)."
  (declare (single-float x y w h) (type f32vec col))
  (let* ((on (* (lma 15) (css 4f0))) (step (* (lma 15) (css 9f0))) (p *lm-pts*) (lw (lay-dpr)))
    (declare (single-float on step lw) (type f32vec p))
    (macrolet ((side (ax ay bx by)
                 `(let* ((len (f-hypot (- ,bx ,ax) (- ,by ,ay))) (ux (/ (- ,bx ,ax) len)) (uy (/ (- ,by ,ay) len)) (s 0f0))
                    (declare (single-float len ux uy s))
                    (loop while (< s len)
                          do (let* ((e (f-min len (+ s on))))
                               (declare (single-float e))
                               (lm-set! p (+ ,ax (* ux s)) (+ ,ay (* uy s)) (+ ,ax (* ux e)) (+ ,ay (* uy e)))
                               (paint-stroke! p 2 lw col)
                               (setf s (+ s step)))))))
      (side x y (+ x w) y) (side (+ x w) y (+ x w) (+ y h)) (side (+ x w) (+ y h) x (+ y h)) (side x (+ y h) x y))
    nil))

(defun-fast lm-phone-card ()
  "menu.js PHONE_SVG (the 560 x 330 card) at *LM-G* [4] x / [6] top, scaled [11]: the rounded card, the SP / ATTACK zones (dashed),
the gesture list, the thumb rising over the ATTACK zone (thumb, 4.8s)."
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (sc (* d (aref *lm-g* 11))) (x (lmg 4)) (y (lmg 6)) (st (aref *lm-t* 1))
         (ty (twv *lm-thumb* st now 0)) (top (twv *lm-thumb* st now 1)) (p *lm-pts*))
    (declare (single-float now d sc x y st ty top) (type f32vec p))
    (paint-reset)
    (macrolet ((vx (u) `(+ x (* sc ,u))) (vy (u) `(+ y (* sc ,u))))
      (paint-box! (vx 280f0) (vy 165f0) (* sc 279f0) (* sc 164f0) (* sc 28f0) 1f0 0f0 +c-cap-line+)
      (paint-box! (vx 280f0) (vy 165f0) (- (* sc 279f0) d) (- (* sc 164f0) d) (- (* sc 28f0) d) 1f0 0f0 +c-phone+)
      (paint-box! (vx 416f0) (vy 98f0) (* sc 116f0) (* sc 64f0) (* sc 6f0) 1f0 0f0 +c-zone-hi+)
      (paint-box! (vx 416f0) (vy 230f0) (* sc 116f0) (* sc 64f0) (* sc 6f0) 1f0 0f0 +c-zone-lo+)
      (setf (lma 15) (/ sc d))
      (lm-dashed-rect (vx 300f0) (vy 34f0) (* sc 232f0) (* sc 128f0) +c-blood+)
      (lm-dashed-rect (vx 300f0) (vy 166f0) (* sc 232f0) (* sc 128f0) +c-zone-lo-line+)
      (dolist (tx *lm-phone*)
        (destructuring-bind (ux uy kind s) tx
          (let* ((px (vx (i->f ux))) (py (vy (i->f uy))))
            (declare (single-float px py))
            (case kind
              (:big (lm-text s +f-display+ +c-paper+ px py (* sc 22f0) :spacing 0.14f0 :edge +ed8+))
              (:zh (lm-text s +f-sans+ +c-stone+ px py (* sc 11f0) :spacing 0.1f0 :edge +es4+))
              (:red (lm-text s +f-mono+ +c-steel+ px py (* sc 12f0) :spacing 0.1f0))   ; (.phone text's fill wins over the attribute)
              (t (lm-text s +f-mono+ +c-steel+ px py (* sc 12f0) :spacing 0.1f0))))))
      (when (> top 0.002f0)
        (paint-push) (paint-opacity! top) (paint-transform! 0f0 0f0 :dy (* sc ty))
        (paint-ellipse! (vx 460f0) (vy 250f0) (* sc 22f0) (* sc 22f0) +c-thumb+)
        (paint-ellipse! (vx 460f0) (vy 250f0) (* sc 22f0) (* sc 22f0) +c-paper+ :thick d)
        (lm-set! p (vx 460f0) (vy 232f0) (vx 460f0) (vy 206f0)) (paint-stroke! p 2 (* sc 2f0) +c-paper+)
        (lm-set! p (vx 453f0) (vy 214f0) (vx 460f0) (vy 206f0) (vx 467f0) (vy 214f0)) (paint-stroke! p 3 (* sc 2f0) +c-paper+)
        (paint-pop)))
    nil))

(defun-fast lm-kbd (pad)
  "menu.js buildKbd: the 640 x 196 key map at lane [0] x / [1] top, scale lane [2] (device px a unit): 40 px caps 6 apart (SHIFT 70,
the blood-stroked modifier), rows indented 18, SPACE 250 x 34; the caps bound in this column (a KEYS column) paper; the labels at 482."
  (declare (fixnum pad))
  (let* ((x0 (lma 0)) (y0 (lma 1)) (sc (lma 2)) (d (lay-dpr)) (y 8f0) (tz (* sc 13f0)))
    (declare (single-float x0 y0 sc d y tz))
    (macrolet ((hot-p (name) `(and (= pad 0) (loop for i from 50 below 58 thereis (equal ,name (lm-bind-name (uv i) nil)))))
               (cap (name cx cy cw ch mod)
                 `(let* ((hot (hot-p ,name)) (bx (+ x0 (* sc ,cx))) (by (+ y0 (* sc ,cy))) (bw (* sc ,cw)) (bh (* sc ,ch)))
                    (declare (single-float bx by bw bh))
                    (paint-box! (+ bx (* 0.5f0 bw)) (+ by (* 0.5f0 bh)) (* 0.5f0 bw) (* 0.5f0 bh) (* sc 4f0) 1f0 0f0
                                (if ,mod +c-blood+ (if hot +c-paper+ +c-cap-line+)))   ; (.cap.mod's stroke wins over .hot's)
                    (paint-box! (+ bx (* 0.5f0 bw)) (+ by (* 0.5f0 bh)) (- (* 0.5f0 bw) d) (- (* 0.5f0 bh) d) (f-max 0f0 (- (* sc 4f0) d)) 1f0 0f0
                                (if hot +c-paper+ +c-ptr-bg+))
                    (lm-text ,name +f-mono+ (if hot +c-ink+ +c-steel+) (f-floor+ (+ bx (* 0.5f0 bw))) (f-floor+ (+ by (* sc 25f0)))
                             tz :align :center))))
      (let* ((ri 0))
        (declare (fixnum ri))
        (dolist (r *lm-kbd-rows*)
          (let* ((cx (+ 8f0 (* 18f0 (i->f ri)))))
            (declare (single-float cx))
            (dolist (k r)
              (let* ((cw (if (equal k "SHIFT") 70f0 40f0)))
                (declare (single-float cw))
                (cap k cx y cw 40f0 (equal k "SHIFT"))
                (setf cx (+ cx cw 6f0)))))
          (setf y (+ y 46f0)) (incf ri)))
      (cap "SPACE" 150f0 y 250f0 34f0 nil))
    ;; the labels (400 10px mono stone .1em): the bound names then their roles, two runs (no string made)
    (let* ((lz (* sc 10f0)) (lx (f-floor+ (+ x0 (* sc 482f0)))))
      (declare (single-float lz lx))
      (macrolet ((lbl (uy shift i word)
                   `(let* ((by (f-floor+ (+ y0 (* sc ,uy)))))
                      (declare (single-float by))
                      (paint-pen! lx by lz :spacing 0.1f0 :edge +em4+)
                      ,@(when shift `((lm-lane! (+ lx (* 0.5f0 lz)) (- by (* 0.36f0 lz)) lz) (lm-shape-glyph (lhud-shape "⇧") 0 +c-stone+)
                                      (paint-pen! (+ lx lz) by lz :spacing 0.1f0 :edge +em4+) (paint-text " + " +f-mono+ +c-stone+)))
                      (paint-text (lm-bind-name (uv (+ 50 ,i)) (= pad 1)) +f-mono+ +c-stone+)
                      (paint-text ,word +f-mono+ +c-stone+))))
        (lbl 25f0 nil 7 " · BURST") (lbl 41f0 t 7 " · AWAKEN") (lbl 71f0 nil 4 " · ATTACK") (lbl 87f0 t 4 " · SP")
        (lbl 125f0 nil 6 " · FUNCTION") (lbl 160f0 nil 5 " · STEP") (lbl 176f0 t 5 " · HOHO")))
    nil))

(defparameter *lm-pulse1* (make-tween '((0 nil 0.25 0.7) (0.5 nil 1 1) (1 nil 0.25 0.7)) :dur 1 :iter -1 :curve +ease-in-out+ :base '(1 1))
  "menu.css pulse at 1s (the capture's key cap).")
(declaim (type f32vec *lm-pulse1*))

(defun-fast lm-controls ()
  "CONTROLS: the side title (操作, CONTROLS, the paragraph), then the keys page (the column tabs, the key map, the ⇧ combos, the ten
binding rows in two columns, the capture's PRESS) or, on a phone (V10), the gestures card."
  (lm-begin-geom)
  (let* ((phone (uv 10)) (now (aref *ui-clock* 0)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))))
    (declare (fixnum phone) (single-float now d))
    (lm-ctl-geom! *lm-g* (lm-cw) (lm-ch) phone)
    (lm-side-title (bigkj "操作") "CONTROLS" (if (= phone 1) *lm-ctl-p-phone* *lm-ctl-p*))
    (if (= phone 1)
        (lm-phone-card)
        (let* ((col (mod (max 0 (uv 9)) 10)) (cap (>= (uv 9) 10)) (pad (if (oddp col) 1 0)) (x (lmg 4)) (y (lmg 6)) (bw (lmg 5)) (tz (css 18f0)))
          (declare (fixnum col pad) (single-float x y bw tz))
          (paint-reset)
          ;; the tabs
          (let* ((tx x))
            (declare (single-float tx))
            (dotimes (k 4)
              (let* ((s (svref *lm-cols* k)) (ow (+ (lm-dw s tz 0.12f0) (css 32f0))))
                (declare (single-float ow))
                (lm-hot 6 k tx y (+ tx ow) (+ y (css 38f0)))
                (lm-lane! tx y (+ tx ow) (+ y (css 38f0)))
                (lm-slab (trans-value *lm-ctl-tr* k now) +c-paper+)
                (lm-text s +f-display+ (col-mix! *lhud-mix* +c-stone+ +c-ink+ (trans-value *lm-ctl-tr* (+ 4 k) now)) (f-floor+ (+ tx (css 16f0)))
                         (f-floor+ (+ y (css 10f0) (line-baseline +f-display+ tz 1f0))) tz :spacing 0.12f0 :edge +ed8+)
                (setf tx (+ tx ow (css 4f0))))))
          (setf y (+ y (css 52f0)))
          (lm-lane! x y (* d (aref *lm-g* 11)))
          (lm-kbd pad)
          (setf y (+ y (* d 196f0 (aref *lm-g* 11))))
          ;; the combos: ⇧ + the cap and the word, 18 apart (12px / 1.6 sans steel)
          (let* ((cx x) (wz (css (if narrow 11f0 12f0))))
            (declare (single-float cx wz))
            (dotimes (k 3)
              (let* ((cb (svref *lm-combos* k)))
                (lm-lane! cx y) (lm-key-cap (lhud-shape "⇧") +f-mono+) (setf cx (+ cx (lma 2) (css 6f0)))
                (lm-text "+" +f-sans+ +c-steel+ (f-floor+ cx) (f-floor+ (+ y (css 15f0))) wz) (setf cx (+ cx (text-w "+" +f-sans+ wz 0f0) (css 6f0)))
                (lm-lane! cx y) (lm-key-cap (if (equal (car cb) " ") (lhud-shape "␣") (car cb)) +f-mono+) (setf cx (+ cx (lma 2) (css 6f0)))
                (lm-text (cdr cb) +f-sans+ +c-steel+ (f-floor+ cx) (f-floor+ (+ y (css 15f0))) wz :edge +es4+)
                (setf cx (+ cx (text-w (cdr cb) +f-sans+ wz 0f0) (css (if narrow 10f0 18f0)))))))
          (setf y (+ y (css 22f0) (css 14f0)))
          ;; the bindings: two columns 18 apart, rows 52.4 (narrow 47.4 / no small line) 2 apart
          (let* ((cw (* 0.5f0 (- bw (css (if narrow 10f0 18f0))))) (rh (css (if narrow 33f0 52.4f0))) (az (css (if narrow 13f0 15f0))) (sz (css 11f0)))
            (declare (single-float cw rh az sz))
            (dotimes (i 10)
              (let* ((bx (+ x (* (i->f (mod i 2)) (+ cw (css (if narrow 10f0 18f0)))))) (by (+ y (* (i->f (floor i 2)) (+ rh (css 2f0)))))
                     (r (svref *lm-binds* i)) (foc (= i (uv 1))) (extra (>= i 8)) (capt (and cap foc (< i 8))))
                (declare (single-float bx by))
                (lm-hot 7 i bx by (+ bx cw) (+ by rh))
                (when foc
                  (paint-rect bx by cw rh +c-bind-foc+)
                  (paint-rect bx (+ by (css 8f0)) (css 3f0) (- rh (css 16f0)) +c-blood+))
                (paint-rect bx (- (+ by rh) d) cw d +c-rule+)
                (let* ((ay (+ by (css (if narrow 8f0 9f0)))))
                  (declare (single-float ay))
                  (lm-text (first r) +f-display+ (if extra +c-stone+ +c-paper+) (f-floor+ (+ bx (css 12f0))) (f-floor+ (lm-base ay +f-display+ az 1.2f0)) az
                           :spacing 0.1f0 :edge +ed7+)
                  (unless narrow
                    (lm-text (second r) +f-sans+ +c-stone+ (f-floor+ (+ bx (css 12f0))) (f-floor+ (lm-base (+ ay (* 1.2f0 az)) +f-sans+ sz 1.4f0)) sz
                             :spacing 0.1f0 :edge +es4+)))
                ;; the key: the binding's name (PRESS while capturing, pulsing in blood), ↺ / K for the two extra rows
                (let* ((name (cond (capt "PRESS") ((= i 8) (lhud-shape "↺")) ((= i 9) "K") (t (lm-bind-name (uv (+ 50 i)) (= pad 1)))))
                       (kw (f-max (css 22f0) (+ (if (lm-shape-char-p name) (* (i->f (length name)) (css 10f0)) (text-w name +f-mono+ (css 10f0) 0f0)) (css 12f0))))
                       (kx (- (+ bx cw) (css 12f0) kw)) (ky (+ by (* 0.5f0 (- rh (css 22f0))))))
                  (declare (single-float kw kx ky))
                  (if capt
                      (let* ((op (twv *lm-pulse1* (aref *lm-t* 1) now 0)))
                        (declare (single-float op))
                        (paint-box! (+ kx (* 0.5f0 kw)) (+ ky (css 11f0)) (* 0.5f0 kw) (css 11f0) (css 3f0) 1f0 d +c-blood+)
                        (with-col (c +c-blood+) (col-alpha! c op)
                          (lm-text name +f-mono+ c (f-floor+ (+ kx (* 0.5f0 kw))) (f-floor+ (+ ky (css 10.5f0) (css 3.6f0))) (css 10f0) :align :center)))
                      (progn (lm-lane! kx ky) (lm-key-cap name +f-mono+)))))))))
    nil))
