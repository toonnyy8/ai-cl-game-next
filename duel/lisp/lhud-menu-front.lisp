;;;; lhud-menu-front.lisp — TITLE, MODE and RESULTS drawn by Lisp (docs/duel/DUEL_LISP_HUD.md §15; menu.css #s-title, #s-mode,
;;;; #s-results; menu.js renderTitle / renderMode / renderResults). Each screen: a system (its rows' focus transitions, its animation
;;;; starts, from the model V k and the UI clock) and a view (the model + that state + the layout of lhud-menu-geom.lisp -> paint
;;;; calls). The rows (.row: the brush, the label, the seal) are shared by MODE and RESULTS (LM-ROW).
(in-package :duel)

;;; ---------------------------------------------------------------- the menu row (menu.css .row)
(defun-fast lm-row (en zh seal tr base kind i)
  "One .row: the hot box (KIND, I), the brush (scaleX tween TR [BASE]), the label EN (800 display, .92 line box) and ZH (500 12px sans
.24em at .7, padded .35em down), the seal SEAL (TR [BASE + 1]: scale 0 -> 1, rotate -14 -> -6), the colour steel -> ink (TR [BASE
+ 2]). Lane: [0] x0 [1] y0 [2] x1 [3] y1 the row's box, [4] the .en size, [5] the seal's size, [6] the padding-left, [7] the
padding-right, [8] 1 = the right hand's narrow row (the seal first, the brush from the right), [9] the padding-top (device px)."
  (declare (simple-string en zh seal) (type f32vec tr) (fixnum base kind i))
  (let* ((now (aref *ui-clock* 0)) (x0 (lma 0)) (y0 (lma 1)) (x1 (lma 2)) (y1 (lma 3)) (ez (lma 4)) (ss (lma 5)) (pl (lma 6)) (pr (lma 7))
         (flip (> (lma 8) 0.5f0)) (pt (lma 9)) (kb (trans-value tr base now)) (ks (trans-value tr (+ base 1) now))
         (kc (trans-value tr (+ base 2) now)) (zz (css 12f0)) (ex (if flip (+ x0 pl ss (css 18f0)) (+ x0 pl))) (ew (lm-dw en ez 0.01f0))
         (cy (* 0.5f0 (+ y0 y1))))
    (declare (single-float now x0 y0 x1 y1 ez ss pl pr pt kb ks kc zz ex ew cy))
    (lm-hot kind i x0 y0 x1 y1)
    (if flip
        (lm-lane! (- x0 (css 10f0)) (- y0 (css 4f0)) (+ x1 (css 14f0)) (+ y1 (css 2f0)))
        (lm-lane! (- x0 (css 14f0)) (- y0 (css 4f0)) (+ x1 (css 10f0)) (+ y1 (css 2f0))))
    (lm-brush kb flip)
    (let* ((c (col-mix! *lhud-mix* +c-steel+ +c-ink+ kc)))
      (lm-text en +f-display+ c (f-floor+ ex) (f-floor+ (+ y0 pt (line-baseline +f-display+ ez 0.92f0))) ez :spacing 0.01f0 :edge +ed8+)
      (with-col (z c)
        (col-alpha! z (* 0.7f0 (aref c 3)))
        (lm-text zh +f-sans+ z (f-floor+ (+ ex ew (css 12f0))) (f-floor+ (+ y0 pt (* 0.35f0 zz) (line-baseline +f-sans+ zz 1.3f0))) zz :spacing 0.24f0)))
    (lm-lane! (if flip (+ x0 pl (* 0.5f0 ss)) (- x1 pr (* 0.5f0 ss))) cy ss (* ss 0.5f0))
    (lm-seal seal ks (+ -14f0 (* 8f0 ks)))
    nil))

(defmacro lm-row-trans (tr base focus now delay-seal)
  "Retarget a row's three transitions to FOCUS (menu.css: the brush .34s ease-out, the seal .3s ease-out after .08s on focusing, the
colour .18s ease); snap when the screen just came up."
  `(let* ((%f (if ,focus 1f0 0f0)) (%snap (lm-entered-p)))
     (declare (single-float %f))
     (trans-to ,tr ,base %f ,now (if %snap 0f0 0.34f0) +ease-out+)
     (trans-to ,tr (+ ,base 1) %f ,now (if %snap 0f0 0.3f0) +ease-out+ (if (and ,focus ,delay-seal (not %snap)) 0.08f0 0f0))
     (trans-to ,tr (+ ,base 2) %f ,now (if %snap 0f0 0.18f0) +ease+)))

(defun-fast-inline lm-row-box (x0 y0 rowh en zh)
  "A row's box into lane [0..9] (LM-ROW's layout) at X0 / Y0 (CSS px, the list's left and the row's top), ROWH tall, for the form:
desktop full width (*LM-G* [13]), the seal at the right; narrow: the right hand's full-width row with its seal first, or, V41 = 1
(menu.js's `left` class), the row as wide as its content (justify-items: start)."
  (declare (single-float x0 y0 rowh) (simple-string en zh))
  (let* ((d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))) (ez (* d (aref *lm-g* 15))) (ss (css (if narrow 28f0 34f0)))
         (pl (css (if narrow 16f0 22f0))) (pr (css (if narrow 20f0 28f0))) (left (= (uv 41) 1)) (flip (and narrow (not left)))
         (x (* d x0)) (w (* d (aref *lm-g* 13))))
    (declare (single-float d ez ss pl pr x w))
    (when (and narrow left)
      (setf w (+ pl (lm-dw en ez 0.01f0) (css 12f0) (text-w zh +f-sans+ (css 12f0) 0.24f0) (css 18f0) ss pr)))
    (lm-lane! x (* d y0) (+ x w) (* d (+ y0 rowh)) ez ss pl pr (if flip 1f0 0f0) (css (if narrow 9f0 12f0)))
    nil))

;;; ---------------------------------------------------------------- TITLE
(defparameter *lm-rise* (make-tween '((0 nil 0) (1 nil 1)) :dur 0.9 :curve +ease-out+ :fill 3 :base '(1))
  "menu.css rise: clip-path inset(100% 0 0 0) + translateY(.2em) -> inset(0), .9s ease-out, both (progress).")
(defparameter *lm-slash* (make-tween '((0 nil 0) (1 nil 1)) :dur 0.46 :delay 0.5 :curve +ease-cut+ :fill 1 :base '(0))
  "menu.css slash: scaleX(0) -> 1 under rotate(-5deg), .46s .5s ease-cut forwards.")
(defparameter *lm-pulse* (make-tween '((0 nil 0.25 0.7) (0.5 nil 1 1) (1 nil 0.25 0.7)) :dur 2.4 :iter -1 :curve +ease-in-out+ :base '(1 1))
  "menu.css pulse: opacity .25 -> 1 -> .25, scale .7 -> 1 -> .7, 2.4s ease-in-out infinite.")
(declaim (type f32vec *lm-rise* *lm-slash* *lm-pulse* *lm-ft-tr*))
(defvar *lm-ft-tr* (make-transitions 4 0f0) "[0] TITLE's PRESS shown (V11: opacity .35s), [1] RESULTS' menu shown (V11).")
(defparameter *lm-slash-pts* (let* ((v (make-f32 10))) (replace v '(0f0 0.62f0 0.06f0 0.30f0 1f0 0f0 0.96f0 1f0 0.08f0 0.92f0)) v)
  "The slash's clip-path polygon (box fractions).")
(defparameter +c-kanji-dot+ (rgba #xbcc1cc))

(defun-fast lm-press-frame (s)
  "menu.css .press at lane [0] x [1] top (device px): padding 16 26 16 20, the 8 px blood dot pulsing, S 800 22px display .3em paper,
the frame skewX(-12deg) with a 1 px rgba(238,238,234,.22) border. Lane [2] := its width."
  (declare (simple-string s))
  (let* ((now (aref *ui-clock* 0)) (x (lma 0)) (y (lma 1)) (fz (css 22f0)) (tw (lm-dw s fz 0.3f0))
         (w (+ (css 20f0) (css 8f0) (css 14f0) tw (css 26f0))) (h (css 54f0)) (sk (* 0.2126f0 0.5f0 h)) (p *lm-pts*)
         (st (aref *lm-t* 1)) (op (twv *lm-pulse* st now 0)) (sc (twv *lm-pulse* st now 1)))
    (declare (single-float now x y fz tw w h sk st op sc) (type f32vec p))
    (lm-set! p (+ x sk) y (+ x w sk) y (- (+ x w) sk) (+ y h) (- x sk) (+ y h) (+ x sk) y)
    (paint-stroke! p 5 (lay-dpr) +c-press-line+)
    (with-col (c +c-blood+) (col-alpha! c op)
      (paint-ellipse! (+ x (css 24f0)) (+ y (* 0.5f0 h)) (* sc (css 4f0)) (* sc (css 4f0)) c))
    (lm-text s +f-display+ +c-paper+ (f-floor+ (+ x (css 42f0))) (f-floor+ (+ y (css 16f0) (line-baseline +f-display+ fz 1f0))) fz :spacing 0.3f0 :edge +ed8+)
    (setf (lma 2) w)
    nil))

(defun-fast lm-title ()
  "TITLE: the wordmark (SOUL, DUEL outlined 2 px, NEXT in blood, each rising out of its clip; the blood slash), the two sub lines,
PRESS J / A / TAP TO BEGIN (shown once V11 says ready), the halftone 魂 and the vertical line (desktop)."
  (lm-begin-geom)
  (lm-title-geom! *lm-g* (lm-cw) (lm-ch))
  (let* ((now (aref *ui-clock* 0)) (st (aref *lm-t* 1)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw)))
         (x0 (lmg 0)) (wf (lmg 4)) (top (lmg 5)) (lh (* 0.76f0 wf)) (colw (- (lmg 2) x0 (if narrow 0f0 (lmg 6))))
         (nz (* 0.26f0 wf)) (wmh (+ (* 2f0 lh) nz (* 0.3f0 nz))) (ds (aref *glyph-dscale* 1)))
    (declare (single-float now st d x0 wf top lh colw nz wmh ds))
    (paint-reset)
    ;; 魂: slate under a 6 px steel halftone (background-clip: text), .9 (narrow .55); then the vertical line
    (let* ((kz (lmg 6)) (kx (lmg 7)) (ky (lmg 8)) (op (if narrow 0.55f0 0.9f0)))
      (declare (single-float kz kx ky op))
      (paint-push) (paint-opacity! op)
      (lm-text (bigkj "魂") +f-kanji+ +c-slate+ kx (+ ky (line-baseline +f-kanji+ kz 0.9f0)) kz)
      (paint-dots! (css 6f0) (css 1.35f0))
      (lm-text (bigkj "魂") +f-kanji+ +c-kanji-dot+ kx (+ ky (line-baseline +f-kanji+ kz 0.9f0)) kz)
      (paint-pop)
      (when (>= (aref *lm-g* 9) 0f0)
        (paint-pen! (f-floor+ (lmg 9)) (lmg 10) (css 13f0) :spacing 0.6f0 :edge +ek6+)
        (paint-vertical *lm-title-vert* +f-kanji+ +c-stone+)))
    ;; the wordmark's lines: rise from their clip (delay 0 / .12 / .24 s), DUEL outlined, NEXT spaced .5em
    (macrolet ((line (s ltop lhh fz x delay col &key (edge 0.5f0) (outline 0f0) (spacing 0f0))
                 `(let* ((p (twv *lm-rise* (+ st ,delay) now 0)) (ty ,ltop) (hh ,lhh))
                    (declare (single-float p ty hh))
                    (when (> p 0.001f0)
                      (paint-push)
                      (paint-transform! 0f0 0f0 :dy (* 0.2f0 ,fz (- 1f0 p)))
                      (paint-scissor! -1f5 (+ ty (* hh (- 1f0 p))) 1f5 (+ ty hh))
                      (paint-pen! ,x (+ ty (line-baseline +f-display+ ,fz (/ hh ,fz))) ,fz :spacing ,spacing :edge ,edge :outline ,outline)
                      (paint-text ,s +f-display+ ,col)
                      (paint-pop)))))
      (line "DUEL" (+ top lh) lh wf (+ x0 (* 0.62f0 wf)) 0.12f0 +c-paper+ :edge (- 0.5f0 (* d (/ ds wf))) :outline (* 2f0 d (/ ds wf)) :spacing -0.012f0)
      (line "NEXT" (+ top (* 2f0 lh) (* 0.3f0 nz)) nz nz (+ x0 (* 2.4f0 nz)) 0.24f0 +c-blood+ :spacing 0.5f0)
      ;; the slash: (left -3 %, top 47 %, 175 % x .085em) of the wordmark, rotate(-5deg) scaleX(k) about its left middle
      (let* ((k (twv *lm-slash* st now 0)))
        (declare (single-float k))
        (when (> k 0.002f0)
          (let* ((sx (- x0 (* 0.03f0 colw))) (sy (+ top (* 0.47f0 wmh))) (sw (* 1.75f0 colw)) (sh (* 0.085f0 wf)) (p *lm-pts*)
                 (fr *lm-slash-pts*))
            (declare (single-float sx sy sw sh) (type f32vec p fr))
            (dotimes (i 5) (setf (aref p (* 2 i)) (+ sx (* sw (aref fr (* 2 i)))) (aref p (1+ (* 2 i))) (+ sy (* sh (aref fr (1+ (* 2 i)))))))
            (paint-push)
            (paint-transform! sx (+ sy (* 0.5f0 sh)) :rot -0.08727f0 :sx k)
            (paint-clip! -1f6 -1f6 1f6 1f6)
            (paint-poly p 5 +c-blood+ +c-blood+)
            (paint-pop))))
      (line "SOUL" top lh wf x0 0f0 +c-paper+ :spacing -0.012f0))
    ;; the sub lines: 500 13px / 1.6 sans .14em steel, 22 px apart
    (let* ((sz (css 13f0)) (sy (f-floor+ (+ (lmg 11) (line-baseline +f-sans+ sz 1.6f0)))) (s0 (svref *lm-title-sub* 0)))
      (declare (single-float sz sy))
      (lm-text s0 +f-sans+ +c-steel+ (f-floor+ x0) sy sz :spacing 0.14f0)
      (lm-text (svref *lm-title-sub* 1) +f-sans+ +c-steel+ (f-floor+ (+ x0 (text-w s0 +f-sans+ sz 0.14f0) (css 22f0))) sy sz :spacing 0.14f0))
    ;; PRESS: gated by V11 (opacity .35s)
    (let* ((op (trans-value *lm-ft-tr* 0 now)))
      (declare (single-float op))
      (when (> op 0.002f0)
        (paint-push) (paint-opacity! op)
        (lm-lane! x0 (lmg 12))
        (lm-press-frame (case (lm-input) (2 "TAP TO BEGIN") (1 "PRESS A") (t "PRESS J")))
        (paint-pop)))
    nil))

;;; ---------------------------------------------------------------- MODE
(declaim (type f32vec *lm-mode-tr* *lm-inkin*) (type (simple-array fixnum (*)) *lm-mode-i*))
(defvar *lm-mode-tr* (make-transitions 21 0f0) "MODE's rows: 3 a row (LM-ROW: the brush, the seal, the colour).")
(defvar *lm-mode-i* (make-array 2 :element-type 'fixnum :initial-element -1) "[0] the kanji's mode shown (a change restarts inkin).")
(defvar *lm-mode-t* (make-array 1 :element-type 'single-float :initial-element -100f0) "[0] inkin's start.")
(declaim (type f32vec *lm-mode-t*))
(defparameter *lm-inkin* (make-tween '((0 nil 0 1 -14) (1 nil 1 0 0)) :dur 0.42 :curve +ease-out+ :fill 2 :base '(1 0 0))
  "menu.css inkin: from opacity 0, blur(8px), translateY(-14px) (opacity, blur 0..1, y CSS px), .42s ease-out.")

(defun-fast lm-mode-update ()
  "MODE's system: the rows' focus (V1), the kanji's swap (a new mode, or the screen coming up)."
  (when (= (uv 0) 2)
    (let* ((now (aref *ui-clock* 0)) (tr *lm-mode-tr*) (cur (uv 1)) (iv *lm-mode-i*))
      (declare (single-float now) (fixnum cur))
      (dotimes (i 7) (lm-row-trans tr (* 3 i) (= i cur) now t))
      (when (or (/= cur (aref iv 0)) (lm-entered-p))
        (setf (aref iv 0) cur (aref *lm-mode-t* 0) now))))
  nil)

(defun-fast lm-mode ()
  "MODE: the vertical kanji (inkin on a swap), the torn paper card (MODE 0n / 07, the heading, the paragraph, the tags), the seven
rows with the brush and the seal on the cursor."
  (lm-begin-geom)
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (cur (max 0 (min 6 (uv 1)))) (m (svref *lm-modes* cur)) (narrow (lm-narrow-p (lm-cw)))
         (text (fifth m)) (meta (sixth m)) (pz (if narrow 13f0 15f0)) (cw 0f0) (lines 1) (tagrows 1))
    (declare (single-float now d pz cw) (fixnum cur lines tagrows))
    ;; the card's width first (desktop 34ch = 349.9, narrow the rest of the hero), then its paragraph's lines and the tags' rows
    (lm-mode-geom! *lm-g* (lm-cw) (lm-ch) 2 1)
    (setf cw (- (aref *lm-g* 9) 48f0))
    (paint-pen! 0f0 0f0 (* d pz))
    (setf lines (paint-measure-paragraph text +f-sans+ :width (* d cw)))
    (let* ((x 0f0) (tz (css 10f0)))
      (declare (single-float x tz))
      (dolist (tg meta)
        (let* ((tw (+ (text-w tg +f-mono+ tz 0.12f0) (css 18f0))))
          (declare (single-float tw))
          (when (and (> x 0f0) (> (+ x tw) (* d cw))) (incf tagrows) (setf x 0f0))
          (setf x (+ x tw (css 8f0))))))
    (lm-mode-geom! *lm-g* (lm-cw) (lm-ch) lines tagrows)
    (paint-reset)
    ;; the kanji: vertical, letter-spacing -.04em, paper; inkin
    (let* ((kz (lmg 4)) (t0 (aref *lm-mode-t* 0)) (op (twv *lm-inkin* t0 now 0)) (bl (twv *lm-inkin* t0 now 1)) (dy (twv *lm-inkin* t0 now 2)))
      (declare (single-float kz t0 op bl dy))
      (with-col (c +c-paper+) (col-alpha! c op)
        (paint-pen! (f-floor+ (+ (lmg 5) (* 0.5f0 kz))) (+ (lmg 6) (* d dy)) kz :spacing -0.04f0 :soft (+ 1f0 (* 16f0 bl)))
        (paint-vertical (third m) +f-kanji+ c)))
    ;; the card: torn paper, its text 22 24 24 in
    (let* ((cx (lmg 7)) (cy (lmg 8)) (cwd (lmg 9)) (ch (lmg 10)) (tx (f-floor+ (+ cx (css 24f0)))) (y (+ cy (css 22f0))) (ez (css 10f0)))
      (declare (single-float cx cy cwd ch tx y ez))
      (lm-lane! cx cy (+ cx cwd) (+ cy ch) (css 3f0))
      (lm-torn +c-paper+ t 4)
      (lm-text "MODE 0" +f-mono+ +c-paper-eye+ tx (f-floor+ (lm-base y +f-mono+ ez 1f0)) ez :spacing 0.2f0 :edge +em4+)
      (paint-int (1+ cur) +f-mono+ +c-paper-eye+) (paint-text " / 07" +f-mono+ +c-paper-eye+)
      (setf y (+ y ez))
      (when (> (aref *lm-g* 18) 0.5f0)
        (let* ((hz (css (f-max 26f0 (f-min (* 0.03f0 (lm-cw)) 38f0)))))
          (declare (single-float hz))
          (lm-text (first m) +f-display+ +c-ink+ tx (f-floor+ (lm-base (+ y (css 10f0)) +f-display+ hz 1f0)) hz :spacing 0.02f0 :edge +ed8+)
          (setf y (+ y (css 10f0) hz (css 12f0)))))
      (paint-pen! tx (f-floor+ y) (* d pz) :edge +es4+)
      (paint-paragraph text +f-sans+ +c-desc+ :width (* d cw) :lh (/ (aref *lm-g* 17) pz))
      (setf y (+ y (* (i->f lines) (* d (aref *lm-g* 17))) (css 16f0)))
      (let* ((x tx) (tz (css 10f0)) (th (css 24f0)))
        (declare (single-float x tz th))
        (dolist (tg meta)
          (let* ((tw (+ (text-w tg +f-mono+ tz 0.12f0) (css 18f0))))
            (declare (single-float tw))
            (when (and (> x tx) (> (+ (- x tx) tw) (* d cw))) (setf x tx y (+ y th (css 8f0))))
            (paint-box! (+ x (* 0.5f0 tw)) (+ y (* 0.5f0 th)) (* 0.5f0 tw) (* 0.5f0 th) 0f0 1f0 d +c-tag-line+)
            (lm-text tg +f-mono+ +c-lm-dim+ (f-floor+ (+ x (css 9f0))) (f-floor+ (+ y (* 0.5f0 th) (* 0.36f0 tz))) tz :spacing 0.12f0 :edge +em4+)
            (setf x (+ x tw (css 8f0)))))))
    ;; the rows
    (let* ((rowh (aref *lm-g* 14)) (lx (aref *lm-g* 11)) (ly (aref *lm-g* 12)))
      (declare (single-float rowh lx ly))
      (dotimes (i 7)
        (let* ((r (svref *lm-modes* i)))
          (paint-reset)
          (lm-row-box lx (+ ly (* (i->f i) (+ rowh 2f0))) rowh (first r) (second r))
          (lm-row (first r) (second r) (fourth r) *lm-mode-tr* (* 3 i) 1 i))))
    nil))

;;; ---------------------------------------------------------------- RESULTS
(declaim (type f32vec *lm-res-tr* *lm-hanko*))
(defvar *lm-res-tr* (make-transitions 9 0f0) "RESULTS' three rows (LM-ROW's three transitions each).")
(defparameter *lm-hanko* (make-tween '((0 nil 2.4 -26 0) (0.6 nil 0.92 -10 1) (1 nil 1 -12 1)) :dur 0.6 :delay 0.3 :curve +ease-out+ :fill 3 :base '(1 -12 1))
  "menu.css hanko: scale 2.4 rotate -26deg opacity 0 -> .92 / -10 / 1 at 60 % -> 1 / -12, .6s .3s ease-out both.")
(defparameter +c-soul-lost+ (rgba #x3a3f4e))

(defun-fast lm-results-update ()
  "RESULTS' system: the rows' focus (V1), the menu's gate (V11, .35s); TITLE's PRESS gate rides here too (V11)."
  (let* ((now (aref *ui-clock* 0)) (scr (uv 0)) (ready (if (= (uv 11) 1) 1f0 0f0)) (snap (lm-entered-p)))
    (declare (single-float now ready) (fixnum scr))
    (when (member scr '(1 6)) (trans-to *lm-ft-tr* (if (= scr 1) 0 1) ready now (if snap 0f0 0.35f0) +ease+))
    (when (= scr 6) (dotimes (i 3) (lm-row-trans *lm-res-tr* (* 3 i) (= i (uv 1)) now t))))
  nil)

(defun-fast lm-results ()
  "RESULTS: WINNER · Pn · K.O. (DRAW · TIME UP), the winner's name, DEFEATED + the loser, the 勝 hanko stamping in, the nine soul
eggs (KONPAKU 魂魄, the lost ones as rings), the four stats (TIME, BEST COMBO, KIKON 毀魂技, PERFECT HOHO), the three rows (gated)."
  (lm-begin-geom)
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))) (w (uv 20)) (draw (= w 2))
         (win (if (= w 1) (uv 4) (uv 3))) (lose (if (= w 1) (uv 3) (uv 4))) (o (if (= w 1) 27 22))
         (x0 (aref *lm-g* 0)) (y0 (aref *lm-g* 1)) (x1 (aref *lm-g* 2)) (y1 (aref *lm-g* 3))
         (colw (if narrow (- x1 x0) (* (- x1 x0 (* 0.05f0 (lm-cw))) (/ 1.2f0 2.2f0))))
         (nz (f-max 70f0 (f-min (* 0.12f0 (lm-cw)) 190f0))) (en (if narrow 32f0 (f-max 30f0 (f-min (* 0.044f0 (lm-cw)) 54f0))))
         (rowh (+ (* 0.92f0 en) (if narrow 18f0 24f0)))
         (hgt (+ 11f0 14f0 (* 0.8f0 nz) 14f0 21.5f0 14f0 22f0 14f0 10f0 157f0 14f0 22f0 (* 3f0 rowh) 4f0))
         (top (if narrow (f-max y0 (- y1 hgt 18f0)) (+ y0 (f-max 0f0 (* 0.5f0 (- (- y1 y0) hgt))))))
         (x (* d x0)) (y (* d top)))
    (declare (single-float now d x0 y0 x1 y1 colw nz en rowh hgt top x y) (fixnum w win lose o))
    (setf (aref *lm-g* 13) colw (aref *lm-g* 15) en (aref *lm-g* 31) (if narrow (+ (* 1.14f0 hgt) 18f0) hgt))   ; ([31] the stack: LM-FIT-K; narrow, the hanko 14 % above it)
    (paint-reset)
    ;; who, the name, DEFEATED …
    (let* ((wz (css 11f0)))
      (declare (single-float wz))
      (lm-text (if draw "DRAW · TIME UP" (if (= w 1) "WINNER · P2 · K.O." "WINNER · P1 · K.O.")) +f-mono+ +c-stone+ (f-floor+ x)
               (f-floor+ (lm-base y +f-mono+ wz 1f0)) wz :spacing 0.24f0 :edge +em4+)
      (setf y (+ y wz (css 14f0))))
    (let* ((z (* d nz)))
      (declare (single-float z))
      (lm-text (if draw "DRAW" (lm-card-name win)) +f-display+ +c-paper+ (f-floor+ x) (f-floor+ (lm-base y +f-display+ z 0.8f0)) z :spacing -0.01f0)
      (setf y (+ y (* 0.8f0 z) (css 10f0))))
    (let* ((rz (css 13f0)))
      (declare (single-float rz))
      (unless draw
        (lm-text "DEFEATED " +f-mono+ +c-stone+ (f-floor+ x) (f-floor+ (lm-base y +f-mono+ rz 1.5f0)) rz :spacing 0.08f0 :edge +em4+)
        (paint-text (lm-card-name lose) +f-mono+ +c-paper+))
      (setf y (+ y (* 1.5f0 rz) (css 20f0))))
    ;; the hanko: right 2 % (narrow 0), top 0 (narrow -14 %) of the block, clamp(96px, 13vw, 176px), 勝 clamp(62px, 8.4vw, 116px)
    (unless draw
      (let* ((hs (css (f-max 96f0 (f-min (* 0.13f0 (lm-cw)) 176f0)))) (kz (css (f-max 62f0 (f-min (* 0.084f0 (lm-cw)) 116f0))))
             (hx (- (* d (+ x0 colw)) (if narrow 0f0 (* 0.02f0 d colw)) (* 0.5f0 hs))) (hy (+ (* d top) (if narrow (* -0.14f0 d hgt) 0f0) (* 0.5f0 hs)))
             (st (aref *lm-t* 1)) (sc (twv *lm-hanko* st now 0)) (rot (twv *lm-hanko* st now 1)) (op (twv *lm-hanko* st now 2)))
        (declare (single-float hs kz hx hy st sc rot op))
        (when (> op 0.002f0)
          (paint-push)
          (paint-transform! hx hy :sx sc :sy sc :rot (* 0.017453f0 rot))
          (paint-opacity! op)
          (paint-box! hx hy (* 0.5f0 hs) (* 0.5f0 hs) (css 12f0) 1f0 (css 6f0) +c-blood+)
          (lm-text (bigkj "勝") +f-kanji+ +c-blood+ (f-floor+ hx) (+ hy (* 0.36f0 kz)) kz :align :center)
          (paint-pop))))
    ;; the souls: KONPAKU 魂魄 then nine 18 x 22 eggs, 10 apart (lost: a 1.5 px ring)
    (let* ((ez (css 10f0)) (cy (+ y (css 11f0))) (sx (+ x (text-w (zh "KONPAKU 魂魄") +f-mono+ ez 0.2f0) (css 16f0))) (kon (uv (+ o 4))))
      (declare (single-float ez cy sx) (fixnum kon))
      (lm-text (zh "KONPAKU 魂魄") +f-mono+ +c-stone+ (f-floor+ x) (f-floor+ (+ cy (* 0.36f0 ez))) ez :spacing 0.2f0 :edge +em4+)
      (dotimes (i 9)
        (let* ((ex (+ sx (css 9f0) (* (i->f i) (css 28f0)))))
          (declare (single-float ex))
          (if (< i kon)
              (paint-ellipse! ex cy (css 9f0) (css 11f0) +c-paper+)
              (paint-ellipse! ex cy (css 9f0) (css 11f0) +c-soul-lost+ :thick (css 1.5f0)))))
      (setf y (+ y (css 22f0) (css 14f0) (css 10f0))))
    ;; the stats: a 2 x 2 grid (gap 1 on #23262f, max 520), each 14 16 padded: the eyebrow, the number 800 34px tabular, its unit
    (let* ((gw (* d (f-min 520f0 colw))) (cwd (* 0.5f0 (- gw d))) (chh (css 78f0)) (ez (css 10f0)) (bz (css 34f0)) (uz (css 12f0)))
      (declare (single-float gw cwd chh ez bz uz))
      (paint-rect x y gw (+ (* 2f0 chh) d) +c-rule+)
      (dotimes (k 4)
        (let* ((cx (+ x (* (i->f (mod k 2)) (+ cwd d)))) (cy (+ y (* (i->f (floor k 2)) (+ chh d))))
               (tx (f-floor+ (+ cx (css 16f0)))) (base (f-floor+ (+ cy (css 14f0) ez (css 6f0) (line-baseline +f-display+ bz 1f0)))))
          (declare (single-float cx cy tx base))
          (paint-rect cx cy cwd chh +c-ink+)
          (lm-text (case k (0 "TIME") (1 "BEST COMBO") (2 (zh "KIKON 毀魂技")) (t "PERFECT HOHO")) +f-mono+ +c-stone+ tx
                   (f-floor+ (lm-base (+ cy (css 14f0)) +f-mono+ ez 1f0)) ez :spacing 0.2f0 :edge +em4+)
          (paint-push) (paint-transform! tx 0f0 :sx +wd8+)
          (paint-pen! tx base bz :spacing 0.02f0 :edge +ed8+)
          (case k
            (0 (paint-int-tab (floor (uv 21) 60) +f-display+ +c-paper+) (paint-text ":" +f-display+ +c-paper+)
               (paint-int-tab (mod (uv 21) 60) +f-display+ +c-paper+ 2))
            (1 (paint-int-tab (max 0 (uv (+ o 3))) +f-display+ +c-paper+))
            (2 (paint-int-tab (max 0 (uv (+ o 1))) +f-display+ +c-paper+))
            (t (paint-int-tab (max 0 (uv (+ o 2))) +f-display+ +c-paper+)))
          (paint-pop)
          (let* ((ux (+ tx (* +wd8+ (- (aref *paint-pen* 0) tx)) (css 4f0))))
            (declare (single-float ux))
            (case k
              (0 (lm-text "/ 5:00" +f-mono+ +c-stone+ ux base uz :edge +em4+))
              (1 (lm-text "HITS" +f-mono+ +c-stone+ ux base uz :edge +em4+))))))
      (setf y (+ y (* 2f0 chh) d (css 14f0) (css 22f0))))
    ;; the rows (gated by V11)
    (let* ((op (trans-value *lm-ft-tr* 1 now)))
      (declare (single-float op))
      (when (> op 0.002f0)
        (dotimes (i 3)
          (let* ((r (svref *lm-rmenu* i)))
            (paint-reset) (paint-opacity! op)
            (lm-row-box x0 (+ (/ y d) (* (i->f i) (+ rowh 2f0))) rowh (first r) (second r))
            (lm-row (first r) (second r) (third r) *lm-res-tr* (* 3 i) 2 i)))))
    nil))
