;;;; lhud-fx.lisp — the battle screen's passing elements (docs/duel/DUEL_LISP_HUD.md §13; hud.css .combo .callout .prompt .fx, hud.js
;;;; renderPlate / renderPrompt / renderTouch): the combo under the attacker's plate (each hit stamps it), the move's name (hd-cut),
;;;; the prompt (the Kikon's hold ring), the touch ink (ripple, brush trail, the gesture's word, the hold ring), and the layer fades
;;;; (cinematic, paused: .hudl .3, the deck and 爆 out, the canvas greyed).
;;;; Each element: a system (…-UPDATE: the model's serials and flags -> its component state, at the UI clock) and a view (draws
;;;; from the model, that state and the clock). The touch ink is a fixed ring of slots (no nodes made); 0 B a frame.
(in-package :duel)

;;; ---------------------------------------------------------------- the layers' fades and the paused grade
(defun-fast lhud-layers-update ()
  "The layer fades from V0 (2 cinematic, 4 paused): opacity .3 s (CSS ease), the canvas grade .5 s ease-out; the grade itself is
written into *GRADE-DESAT* here (the one HUD write outside the paint stream: the engine's composite grade, which draw.lisp zeroes
each frame and a cinematic owns)."
  (let* ((now (aref *ui-clock* 0)) (v0 (hv 0)) (cine (logtest v0 2)) (paused (logtest v0 4)) (tr *lhud-lay-tr*))
    (declare (single-float now) (fixnum v0) (type f32vec tr))
    (trans-to tr 0 (cond (cine 0f0) (paused 0.3f0) (t 1f0)) now 0.3f0 +ease+)
    (trans-to tr 1 (if (or cine paused) 0f0 1f0) now 0.3f0 +ease+)
    (trans-to tr 2 (if paused 0f0 1f0) now 0.3f0 +ease+)
    (let* ((g (trans-to tr 3 (if paused 1f0 0f0) now 0.5f0 +ease-out+)))   ; filter: grayscale(.9) brightness(.45) contrast(1.1)
      (declare (single-float g))
      (when (and (> g 0f0) (not *cine*)) (setf *grade-desat* (* 0.9f0 g))))
    nil))
;;; ---------------------------------------------------------------- the combo (hud.css .combo, hud.js renderPlate)
(declaim (type f32vec *lhud-cb-f*) (type (simple-array fixnum (*)) *lhud-cb-i*))
(defvar *lhud-cb-f* (make-f32 16) "Per side at 8 s: [0..2] the opacity's from / to / start, [3..5] the x shift's (u), [6] the stamp's start, [7] shown at.")
(defvar *lhud-cb-i* (make-array 12 :element-type 'fixnum :initial-element 0)
  "Per side at 6 s: [0] the serial seen, [1] hits, [2] dmg, [3] scale %, [4] on (1 / 0), [5] a serial seen yet (1 / 0).")

(defun-fast lhud-combo-update (side)
  "The combo's state from the model: a new serial (V o+13) takes the hits / damage / scale and restarts hd-stamp; on for 1.2 s
(PRACTICE: until the next), opacity .25 s ease and the x shift .35 s ease-out, from where they are; the first serial seen is not shown."
  (declare (fixnum side))
  (let* ((now (aref *ui-clock* 0)) (o (side-o side)) (fv *lhud-cb-f*) (fo (* 8 side)) (iv *lhud-cb-i*) (io (* 6 side))
         (sh (if (= side 1) 2f0 -2f0)) (ser (hv (+ o 13))))
    (declare (single-float now sh) (fixnum o fo io ser) (type f32vec fv) (type (simple-array fixnum (*)) iv))
    (macrolet ((go-to (on)
                 `(let* ((op (tw 1 (aref fv fo) (aref fv (+ fo 1)) (aref fv (+ fo 2)) 0.25f0 now))
                        (tx (tw 2 (aref fv (+ fo 3)) (aref fv (+ fo 4)) (aref fv (+ fo 5)) 0.35f0 now)))
                    (declare (single-float op tx))
                    (setf (aref fv fo) op (aref fv (+ fo 1)) ,(if on 1f0 0f0) (aref fv (+ fo 2)) now
                          (aref fv (+ fo 3)) tx (aref fv (+ fo 4)) ,(if on 0f0 'sh) (aref fv (+ fo 5)) now
                          (aref iv (+ io 4)) ,(if on 1 0)))))
      (cond ((= 0 (aref iv (+ io 5)))
             (setf (aref iv io) ser (aref iv (+ io 4)) 0 (aref iv (+ io 5)) 1 (aref fv (+ fo 3)) sh (aref fv (+ fo 4)) sh))
            ((/= ser (aref iv io))
             (setf (aref iv io) ser)
             (when (> ser 0)
               (setf (aref iv (+ io 1)) (hv (+ o 10)) (aref iv (+ io 2)) (hv (+ o 11)) (aref iv (+ io 3)) (round (hv (+ o 12)) 10)
                     (aref fv (+ fo 6)) (if *reduced-motion* -1f30 now) (aref fv (+ fo 7)) now)
               (when (= 0 (aref iv (+ io 4))) (go-to t)))))
      (when (and (= 1 (aref iv (+ io 4))) (not (hv-practice-p)) (> (- now (aref fv (+ fo 7))) 1.2f0)) (go-to nil)))
    nil))

(defun-fast lhud-combo (side)
  "Side SIDE's combo: the count (900 italic 6.2u, a .25u blood shadow) on the blood slash, HITS, the DMG / SCALE line; under its
plate (desktop 16.4u + st; the phone's P2 20.5u + st, P1 9.6u over the deck, 19u over 4 % without it); the left hand swaps the sides."
  (declare (fixnum side))
  (let* ((now (aref *ui-clock* 0)) (u (lay-u 1f0)) (w (lay-w)) (h (lay-h)) (st (lay-inset 0)) (phone (lay-portrait-p))
         (fv *lhud-cb-f*) (fo (* 8 side)) (iv *lhud-cb-i*) (io (* 6 side)) (pen *paint-pen*) (left (and phone (hv-deck-p) (hv-left-p)))
         (right-al (if left (= side 0) (= side 1)))         ; anchored right, the grid's items at the end (no stretch)
         (op (* (tw 1 (aref fv fo) (aref fv (+ fo 1)) (aref fv (+ fo 2)) 0.25f0 now) (layer-op 0)))
         (txu (tw 2 (aref fv (+ fo 3)) (aref fv (+ fo 4)) (aref fv (+ fo 5)) 0.35f0 now)))
    (declare (single-float now u w h st op txu) (fixnum fo io) (type f32vec fv pen) (type (simple-array fixnum (*)) iv))
    (when (> op 0.002f0)
      (let* ((hits (aref iv (+ io 1))) (dmg (aref iv (+ io 2))) (sc (aref iv (+ io 3)))
             (ns (* 6.2f0 u)) (hs (* 1.5f0 u)) (ds (* 0.95f0 u))
             (crowh (row-h (+f-display+ ns 0.8f0) (+f-display+ hs 1f0))) (amax (aref *lhud-row* 0))
             (ad (line-baseline +f-mono+ ds 1f0)) (boxh (+ crowh (* 0.2f0 u) ds))
             (wn 0f0) (wh 0f0) (wd 0f0) (right (- w (* 2.6f0 u)))
             (ctop (cond ((not phone) (+ (* 16.4f0 u) st))
                         ((= side 1) (+ (* 20.5f0 u) st))
                         ((hv-deck-p) (- (lhud-deck-bottom h (hv 31) t) (* 9.6f0 u) boxh))
                         (t (- (lhud-deck-bottom h 0 nil) (* 19f0 u) boxh)))))
        (declare (fixnum hits dmg sc) (single-float ns hs ds crowh amax ad boxh wn wh wd right ctop))
        (paint-pen! 0f0 0f0 ns) (paint-measure-int hits +f-display+) (setf wn (aref pen 7))
        (setf wh (text-w "HITS" +f-display+ hs 0.18f0))
        (paint-pen! 0f0 0f0 ds :spacing 0.1f0)
        (paint-measure "DMG " +f-mono+) (incf wd (aref pen 7)) (paint-measure-int dmg +f-mono+) (incf wd (aref pen 7))
        (paint-measure " · SCALE " +f-mono+) (incf wd (aref pen 7)) (paint-measure-int sc +f-mono+) (incf wd (aref pen 7))
        (paint-measure "%" +f-mono+) (incf wd (aref pen 7))
        (let* ((cw (+ wn (* 0.6f0 u) wh)) (cx (if right-al (- right cw) (* 2.6f0 u))) (base (+ ctop amax))
               (tx (* txu u)) (pts *lhud-pts*) (sbw (if right-al cw (f-max cw wd)))   ; (P1's grid stretches the row to the DMG line)
               (sx (- cx (* 0.06f0 sbw))) (sw (* 1.2f0 sbw)) (sy (+ ctop (* 0.44f0 crowh))) (shh (* 0.34f0 crowh))
               (oy (+ sy (* 0.5f0 shh))) (k 0.4452f0))   ; skewX(-24deg) about the slash's left centre: x - tan 24 (y - oy)
          (declare (single-float cw cx base tx sbw sx sw sy shh oy k) (type f32vec pts))
          (paint-reset)
          (paint-xform! 0f0 0f0 1f0 1f0 0f0 tx 0f0 op)
          (macrolet ((pt (i x y) `(let* ((yy (+ sy (* shh ,y))))
                                    (declare (single-float yy))
                                    (setf (aref pts ,(* 2 i)) (- (+ sx (* sw ,x)) (* k (- yy oy))) (aref pts ,(1+ (* 2 i))) yy))))
            (pt 0 0f0 0.3f0) (pt 1 1f0 0f0) (pt 2 0.96f0 1f0) (pt 3 0.02f0 0.8f0))
          (paint-clip! -1f5 -1f5 1f5 1f5) (paint-poly pts 4 +c-slash+ +c-slash+)
          ;; the count: hd-stamp about its box's centre, then the container's shift
          (let* ((e (ease +ease-snap+ (/ (- now (aref fv (+ fo 6))) 0.24f0))) (s (+ 1.5f0 (* -0.5f0 e)))
                 (rot (* -0.10472f0 (- 1f0 e))) (bx (+ cx (* 0.5f0 wn))) (byc (+ (- base amax) (* 0.4f0 ns))))
            (declare (single-float e s rot bx byc))
            (paint-xform! bx byc s s rot tx 0f0 op)
            (paint-pen! cx (+ base (* 0.25f0 u)) ns :skew 0.25f0) (setf (aref pen 0) (+ cx (* 0.25f0 u)))
            (paint-int hits +f-display+ +c-blood+)
            (paint-pen! cx base ns :skew 0.25f0) (paint-int hits +f-display+ +c-paper+))
          (paint-xform! 0f0 0f0 1f0 1f0 0f0 tx 0f0 op)
          (paint-pen! (f-floor+ (+ cx wn (* 0.6f0 u))) (f-floor+ base) hs :spacing 0.18f0 :edge 0.53f0)
          (paint-text "HITS" +f-display+ +c-paper+)
          (let* ((dx (if right-al (- right wd) cx)) (dy (+ ctop crowh (* 0.2f0 u) ad)))
            (declare (single-float dx dy))
            (paint-pen! (f-floor+ dx) (f-floor+ dy) ds :spacing 0.1f0)
            (paint-text "DMG " +f-mono+ +c-steel+) (paint-int dmg +f-mono+ +c-paper+)
            (paint-text " · SCALE " +f-mono+ +c-steel+) (paint-int sc +f-mono+ +c-paper+) (paint-text "%" +f-mono+ +c-paper+))
          (paint-reset))))
    nil))

;;; ---------------------------------------------------------------- the move's name (hud.css .callout)
(declaim (type f32vec *lhud-cl-f*) (type (simple-array fixnum (*)) *lhud-cl-i*))
(defvar *lhud-cl-f* (make-f32 8) "Per side at 4 s: [0..2] the opacity's from / to / start, [3] hd-cut's start (= shown at).")
(defvar *lhud-cl-i* (make-array 6 :element-type 'fixnum :initial-element 0) "Per side at 3 s: [0] the serial seen, [1] on, [2] a serial seen yet.")
(defun-fast lhud-callout-update (side)
  "A new callout serial (V o+14): on (opacity .2 s, hd-cut .32 s ease-out), off 1.5 s later; the first serial seen is not shown."
  (declare (fixnum side))
  (let* ((now (aref *ui-clock* 0)) (o (side-o side)) (fv *lhud-cl-f*) (fo (* 4 side)) (iv *lhud-cl-i*) (io (* 3 side)) (ser (hv (+ o 14))))
    (declare (single-float now) (fixnum o fo io ser) (type f32vec fv) (type (simple-array fixnum (*)) iv))
    (macrolet ((go-to (to) `(setf (aref fv fo) (tw 1 (aref fv fo) (aref fv (+ fo 1)) (aref fv (+ fo 2)) 0.2f0 now)
                                  (aref fv (+ fo 1)) ,to (aref fv (+ fo 2)) now)))
      (cond ((= 0 (aref iv (+ io 2))) (setf (aref iv io) ser (aref iv (+ io 2)) 1))
            ((/= ser (aref iv io))
             (setf (aref iv io) ser)
             (when (> ser 0) (go-to 1f0) (setf (aref fv (+ fo 3)) (if *reduced-motion* -1f30 now) (aref iv (+ io 1)) 1))))
      (when (and (= 1 (aref iv (+ io 1))) (> (- now (aref fv (+ fo 3))) 1.5f0)) (go-to 0f0) (setf (aref iv (+ io 1)) 0)))
    nil))

(defun-fast lhud-callout (side)
  "Side SIDE's move name under its plate: the kanji (800 1.9u Mincho) and the romaji (700 .95u display, .28em, steel; alone: 1.5u
paper) on one baseline, .7u apart, P2 (and P1 with the left hand) row-reverse from the right; revealed left to right (hd-cut)."
  (declare (fixnum side))
  (let* ((now (aref *ui-clock* 0)) (fv *lhud-cl-f*) (fo (* 4 side))
         (op (* (tw 1 (aref fv fo) (aref fv (+ fo 1)) (aref fv (+ fo 2)) 0.2f0 now) (layer-op 0))))
    (declare (single-float now op) (fixnum fo) (type f32vec fv))
    (when (> op 0.002f0)
      (let* ((u (lay-u 1f0)) (h (lay-h)) (st (lay-inset 0)) (phone (lay-portrait-p)) (left (and phone (hv-deck-p) (hv-left-p)))
             (rev (if left (= side 0) (= side 1))) (kan (side-c side 7)) (rom (or (side-c side 6) ""))
             (kz (* 1.9f0 u)) (rz (if kan (* 0.95f0 u) (* 1.5f0 u)))
             (rowh (if kan (row-h (+f-kanji+ kz 1f0) (+f-display+ rz 1f0)) (row-h (+f-display+ rz 1f0))))
             (amax (aref *lhud-row* 0))
             (wk (if kan (text-w kan +f-kanji+ kz) 0f0)) (wr (text-w rom +f-display+ rz 0.28f0))
             (gap (if kan (* 0.7f0 u) 0f0)) (tw0 (+ wk gap wr))
             (top (cond ((not phone) (+ (* 13.6f0 u) st)) ((= side 1) (+ (* 17f0 u) st))
                        ((hv-deck-p) (- (lhud-deck-bottom h (hv 31) t) (* 6.4f0 u) rowh))
                        (t (- (lhud-deck-bottom h 0 nil) (* 15.5f0 u) rowh))))
             (x0 (if rev (- (lay-w) (* 2.6f0 u) tw0) (* 2.6f0 u))) (by (f-floor+ (+ top amax)))
             (cut (ease +ease-out+ (/ (- now (aref fv (+ fo 3))) 0.32f0))))
        (declare (single-float u h st kz rz rowh amax wk wr gap tw0 top x0 by cut))
        (paint-reset)
        (paint-opacity! op)
        (paint-scissor! (- x0 u) (- top u) (+ x0 (* cut (+ tw0 u)) (if (>= cut 1f0) u 0f0)) (+ top rowh u))   ; clip-path: inset(0 100% 0 0) -> 0
        (let* ((xk (if rev (- (+ x0 tw0) wk) x0)) (xr (if rev x0 (+ x0 wk gap))))
          (declare (single-float xk xr))
          (when kan (paint-pen! (f-floor+ xk) by kz) (paint-text kan +f-kanji+ +c-paper+))
          (paint-pen! (f-floor+ xr) by rz :spacing 0.28f0) (paint-text rom +f-display+ (if kan +c-steel+ +c-paper+)))
        (paint-reset)))
    nil))

;;; ---------------------------------------------------------------- the prompt (hud.css .prompt, hud.js renderPrompt)
(declaim (type f32vec *lhud-pr-f*) (type (simple-array fixnum (*)) *lhud-pr-i*))
(defvar *lhud-pr-f* (make-transitions 2 0f0) "[0] the prompt's opacity (.2 s), [1] its drop (u, .3 s ease-out).")
(defvar *lhud-pr-t* (make-f32 2) "[0] the hold ring's start, [1] its duration (s).")
(defvar *lhud-pr-i* (make-array 3 :element-type 'fixnum :initial-element 0) "[0] the kind shown (kept through the fade), [1] its arg, [2] the kind last frame.")
(defvar *lhud-pr-s* (vector nil) "[0] the AS romaji shown (S9).")
(defvar *lhud-pr-kc* (cons :none nil) "The prompt's romaji and its kanji (LHUD-MOVE-KANJI-CACHED).")
(declaim (type f32vec *lhud-pr-t*))
(defun-fast lhud-prompt-update ()
  "The prompt's state: V2 kind (0 none, 1 hold SP, 2 SP · AS n, 3 Burst, 4 awaken: not on the phone's deck, 爆's 覺 says it), V3 arg;
the text kept through the fade; the Kikon hold ring restarted when kind 1 begins (hd-ring over arg / 60 s)."
  (let* ((now (aref *ui-clock* 0)) (k (hv 2)) (iv *lhud-pr-i*) (k (if (and (= k 4) (lay-portrait-p) (hv-deck-p)) 0 k)))
    (declare (single-float now) (fixnum k) (type (simple-array fixnum (*)) iv))
    (when (> k 0) (setf (aref iv 0) k (aref iv 1) (hv 3) (svref *lhud-pr-s* 0) (hs 9)))
    (when (and (= k 1) (/= (aref iv 2) 1)) (setf (aref *lhud-pr-t* 0) now (aref *lhud-pr-t* 1) (/ (i->f (max 1 (hv 3))) 60f0)))
    (setf (aref iv 2) k)
    (trans-to *lhud-pr-f* 0 (if (> k 0) 1f0 0f0) now 0.2f0 +ease+)
    (trans-to *lhud-pr-f* 1 (if (> k 0) 0f0 1f0) now 0.3f0 +ease-out+)
    nil))

(defparameter +c-ringbg+ (rgba #xeeeeea 0.18))
(defun-fast lhud-prompt ()
  "What a press can do now: the words (800 1.3u display, .24em; Awaken reiatsu, Burst blood) over the line (600 .65u mono, .16em,
steel), the Kikon's hold ring (3.2u, blood over .18 paper, 毀) before them; the phone: over the deck, 3u above it, 2.6u from the
right (the left hand: the left); a desktop: centred 5.5u over the bottom (no key cap yet: phase 3)."
  (let* ((now (aref *ui-clock* 0)) (op (* (trans-value *lhud-pr-f* 0 now) (layer-op 0))))
    (declare (single-float now op))
    (when (> op 0.002f0)
      (let* ((u (lay-u 1f0)) (w (lay-w)) (h (lay-h)) (phone (lay-portrait-p)) (iv *lhud-pr-i*) (k (aref iv 0)) (a (aref iv 1))
             (rom (or (svref *lhud-pr-s* 0) "")) (kan (lhud-move-kanji-cached rom)) (hold (= (aref iv 2) 1))
             (wz (* 1.3f0 u)) (sz (* 0.65f0 u)) (pen *paint-pen*)
             (what (case k (1 "HOLD SP") (2 "SP · AS") (3 (if (= a 2) "CHAIN" "BURST")) (t "AWAKEN")))
             (ww (+ (text-w what +f-display+ wz 0.24f0) (if (= k 2) (progn (paint-pen! 0f0 0f0 wz :spacing 0.24f0) (paint-measure-int a +f-display+) (aref pen 7)) 0f0)))
             (sw (progn (lane! sz 0f0 0f0) (lhud-prompt-sub k a rom kan nil) (aref pen 7)))
             (bw (f-max ww sw)) (ringw (if hold (+ (* 3.2f0 u) u) 0f0)) (boxw (+ ringw bw)) (boxh (if hold (* 3.2f0 u) (* 2.3f0 u)))
             (left (and phone (hv-deck-p) (hv-left-p)))
             (x0 (cond ((not phone) (* 0.5f0 (- w boxw))) (left (* 2.6f0 u)) (t (- w (* 2.6f0 u) boxw))))
             (bottom (cond ((not phone) (- h (* 5.5f0 u))) ((hv-deck-p) (- (lhud-deck-bottom h (hv 31) t) (* 3f0 u)))
                           (t (- (* 0.96f0 h) (* 28f0 u)))))
             (y0 (+ (- bottom boxh) (* u (trans-value *lhud-pr-f* 1 now)))) (cy (+ y0 (* 0.5f0 boxh)))
             (tx (+ x0 ringw)) (ty (- cy (* 1.15f0 u))))
        (declare (single-float u w h wz sz ww sw bw ringw boxw boxh x0 bottom y0 cy tx ty) (fixnum k a) (type f32vec pen))
        (paint-reset)
        (paint-opacity! op)
        (when hold                                         ; the ring: r 15.9 of 36, stroke 3, from the top clockwise
          (let* ((rr (* 3.2f0 u (/ 15.9f0 36f0))) (th (* 3.2f0 u (/ 3f0 36f0))) (rcx (+ x0 (* 1.6f0 u)))
                 (f (f-min 1f0 (/ (- now (aref *lhud-pr-t* 0)) (f-max 0.001f0 (aref *lhud-pr-t* 1))))) (gz (* 1.25f0 u)))
            (declare (single-float rr th rcx f gz))
            (paint-ellipse! rcx cy (+ rr (* 0.5f0 th)) (+ rr (* 0.5f0 th)) +c-ringbg+ :thick th)
            (when (> f 0f0) (paint-ellipse! rcx cy (+ rr (* 0.5f0 th)) (+ rr (* 0.5f0 th)) +c-blood+ :thick th :frac f))
            (paint-pen! 0f0 0f0 gz) (paint-measure (kj "毀") +f-kanji+)
            (paint-pen! (- rcx (* 0.5f0 (aref pen 7))) (+ (- cy (* 0.5f0 gz)) (line-baseline +f-kanji+ gz 1f0)) gz)
            (paint-text (kj "毀") +f-kanji+ +c-paper+)))
        (let* ((col (case k (4 +c-reiatsu+) (3 +c-blood+) (t +c-paper+))))
          (paint-pen! (f-floor+ tx) (f-floor+ (+ ty (line-baseline +f-display+ wz 1f0))) wz :spacing 0.24f0 :edge 0.47f0)
          (paint-text what +f-display+ col)
          (when (= k 2) (paint-int a +f-display+ col)))
        (lane! sz (f-floor+ tx) (f-floor+ (+ ty wz (* 0.35f0 u) (line-baseline +f-mono+ sz 1f0)))) (lhud-prompt-sub k a rom kan t)
        (paint-reset)))
    nil))

(defun lhud-move-kanji-cached (rom)
  "The kanji of the prompt's AS romaji (S9: EQ-stable), looked up only when the string changed."
  (let* ((c *lhud-pr-kc*)) (unless (eq rom (car c)) (setf (car c) rom (cdr c) (lhud-move-kanji rom))) (cdr c)))

(defun-fast lhud-prompt-sub (k a rom kan draw)
  "The prompt's second line (hud.js renderPrompt's sub): KIKON · 毀魂 aF / J HIT → kanji · romaji / ORANGE · 爆氣 / BLUE · 爆氣 /
HOLD 爆 · 覺醒 READY. *LHUD-A*: the size, x, y. DRAW nil: its width into pen [7]; else drawn at x y."
  (declare (fixnum k a))
  (let* ((pen *paint-pen*) (w 0f0) (sz (aref *lhud-a* 0)) (x (aref *lhud-a* 1)) (y (aref *lhud-a* 2)))
    (declare (type f32vec pen) (single-float w sz x y))
    (paint-pen! x y sz :spacing 0.16f0)
    (macrolet ((tx (s) `(if draw (paint-text ,s +f-mono+ +c-steel+) (progn (paint-measure ,s +f-mono+) (incf w (aref pen 7)))))
               (ti (n) `(if draw (paint-int ,n +f-mono+ +c-steel+) (progn (paint-measure-int ,n +f-mono+) (incf w (aref pen 7))))))
      (case k
        (1 (tx (zh "KIKON · 毀魂 ")) (ti a) (tx "F"))
        (2 (tx (zh "J HIT → ")) (when kan (tx kan) (tx " · ")) (tx rom))
        (3 (tx (if (= a 2) (zh "ORANGE · 爆氣") (zh "BLUE · 爆氣"))))
        (t (tx (zh "HOLD 爆 · 覺醒 READY")))))
    (unless draw (setf (aref pen 7) w))
    nil))

;;; ---------------------------------------------------------------- the touch ink (hud.css .fx, hud.js renderTouch / seal)
(defconstant +fx-n+ 12 "Slots of the touch ink's ring.")
(declaim (type f32vec *lhud-fx-f*) (type (simple-array fixnum (*)) *lhud-fx-i*))
(defvar *lhud-fx-f* (make-array (* 6 +fx-n+) :element-type 'single-float :initial-element -1f30)
  "Per slot at 6 s: [0] its start, [1] x, [2] y, [3] the trail's length, [4] its angle.")
(defvar *lhud-fx-i* (make-array (+ 4 (* 2 +fx-n+)) :element-type 'fixnum :initial-element 0)
  "Per slot at 2 s: [0] its kind (0 none, 1 ripple, 2 blood ripple, 3 trail, 4 word), [1] the word (*LHUD-WORDS*); then at
2 +FX-N+: [0] the next slot, [1] the touch serial seen (-1 none yet), [2] the hold ring shown (1 / 0).")
(defvar *lhud-fx-ring* (make-f32 3) "The hold ring's start, x, y.")
(declaim (type f32vec *lhud-fx-ring*))
(defparameter *lhud-words*
  (vector (list "ATK" 0) (list "SP" 1) (list "HOHO" 0) (list "DASH" 0) (list (zh "STEP · BACK") 0) (list (zh "STEP · SIDE") 0)
          (list "BURST" 1) (list "NO BURST" 0) (list (zh "覺醒 AWAKEN") 2))
  "The gesture words (hud.js word / seal): the text and its colour (0 paper, 1 blood: .sp, 2 reiatsu: .aw).")

(defun-fast lhud-fx-add (kind word)
  "Start an ink in the next slot of the ring (the oldest is reused): KIND, its WORD; *LHUD-A*: x y, a trail's length and angle."
  (declare (fixnum kind word))
  (let* ((x (aref *lhud-a* 0)) (y (aref *lhud-a* 1)) (len (aref *lhud-a* 2)) (ang (aref *lhud-a* 3)) (iv *lhud-fx-i*) (n (aref iv (* 2 +fx-n+))) (fv *lhud-fx-f*) (o (* 6 n)))
    (declare (fixnum n o) (single-float x y len ang) (type f32vec fv) (type (simple-array fixnum (*)) iv))
    (setf (aref iv (* 2 n)) kind (aref iv (1+ (* 2 n))) word
          (aref fv o) (aref *ui-clock* 0) (aref fv (+ o 1)) x (aref fv (+ o 2)) y (aref fv (+ o 3)) len (aref fv (+ o 4)) ang
          (aref iv (* 2 +fx-n+)) (mod (1+ n) +fx-n+))
    nil))

(defun-fast lhud-fx-update ()
  "A new touch event (V5 serial; the first seen only recorded): its ripple / trail and word (hud.js renderTouch); the hold ring
(V11) shown and restarted when it appears."
  (let* ((iv *lhud-fx-i*) (b (* 2 +fx-n+)) (ser (hv 5)) (w (lay-w)) (h (lay-h)))
    (declare (fixnum b ser) (single-float w h) (type (simple-array fixnum (*)) iv))
    (when (/= ser (aref iv (+ b 1)))
      (when (and (/= (aref iv (+ b 1)) -1) (> ser 0) (not *reduced-motion*) (hv-deck-p))
        (let* ((k (hv 6)) (x (/ (* w (i->f (hv 7))) 1000f0)) (y (/ (* h (i->f (hv 8))) 1000f0))
              (dx (/ (* w (i->f (hv 9))) 1000f0)) (dy (/ (* h (i->f (hv 10))) 1000f0)))
          (declare (fixnum k) (single-float x y dx dy))
          (cond ((or (= k 1) (= k 3)) (lane! x y 0f0 0f0) (lhud-fx-add (if (= k 3) 2 1) 0) (lhud-fx-add 4 (if (= k 3) 1 0)))
                ((or (= k 2) (= k 4) (= k 6))
                 (let* ((len (f-max 1f0 (f-sqrt (+ (* dx dx) (* dy dy))))) (mn (* 0.2f0 w)))
                   (declare (single-float len mn))
                   (when (< len mn) (setf dx (* dx (/ mn len)) dy (* dy (/ mn len)) len mn))
                   (progn (lane! (- x dx) (- y dy) len (f-atan2 dy dx)) (lhud-fx-add 3 0))
                   (lane! x y 0f0 0f0) (lhud-fx-add 4 (cond ((= k 4) 2) ((= k 6) 3) ((> dy (f-abs dx)) 4) (t 5)))))
                ((= k 7) (progn (lane! x y 0f0 0f0) (lhud-fx-add 4 6))))))
      (setf (aref iv (+ b 1)) ser))
    (let* ((ring (and (= 1 (hv 11)) (hv-deck-p))))
      (when (and ring (= 0 (aref iv (+ b 2))))
        (setf (aref *lhud-fx-ring* 0) (aref *ui-clock* 0) (aref *lhud-fx-ring* 1) (/ (* w (i->f (hv 12))) 1000f0)
              (aref *lhud-fx-ring* 2) (/ (* h (i->f (hv 13))) 1000f0)))
      (setf (aref iv (+ b 2)) (if ring 1 0)))
    nil))

(defparameter *lhud-ink* (make-tween '((0 nil 0.2 0.9) (1 nil 1 0)) :dur 0.5 :curve +ease-out+ :fill 1) "hd-ink: scale .2 -> 1, opacity .9 -> 0, .5 s ease-out.")
(defparameter *lhud-trail* (make-tween '((0 nil 1) (1 nil 0)) :dur 0.45 :curve +ease-out+ :fill 1)
  "hd-trail's opacity: 1 -> 0 over the whole .45 s, ease-out (CSS interpolates a property between the keyframes that name it).")
(defparameter *lhud-trail-cut* (make-tween '((0 nil 0) (0.4 nil 1) (1 nil 1)) :dur 0.45 :curve +ease-out+ :fill 1)
  "hd-trail's clip: inset(0 100% 0 0) -> 0 by 40 %, ease-out.")
(defparameter *lhud-gname* (make-tween '((0 nil 0) (0.25 nil 1) (1 nil 0)) :dur 0.6 :curve +ease-out+ :fill 1)
  "hd-gname's opacity: 0 -> 1 (25 %) -> 0, .6 s ease-out per segment.")
(defparameter *lhud-gname-y* (make-tween '((0 nil -1) (1 nil -2.4)) :dur 0.6 :curve +ease-out+ :fill 1)
  "hd-gname's translateY: -100 % -> -240 % of its height over the whole .6 s (no 25 % keyframe names it), ease-out.")
(declaim (type f32vec *lhud-ink* *lhud-trail* *lhud-trail-cut* *lhud-gname* *lhud-gname-y*))
(defparameter +c-word-shadow+ (rgba #x0b0b10))

(defun-fast lhud-word (word)
  "A gesture word (.gname: 900 2.4u display, .2em, a 2 px ink shadow) centred on x, rising from y (hd-gname). *LHUD-A*: x y, its start."
  (declare (fixnum word))
  (let* ((x (aref *lhud-a* 0)) (y (aref *lhud-a* 1)) (t0 (aref *lhud-a* 2)) (now (aref *ui-clock* 0)) (u (lay-u 1f0)) (gz (* 2.4f0 u)) (op (twv *lhud-gname* t0 now 0)) (dy (* gz (twv *lhud-gname-y* t0 now 0)))
         (wd (svref *lhud-words* word)) (s (first wd)) (ww (text-w s +f-display+ gz 0.2f0)))
    (declare (single-float x y t0 now u gz op dy ww))
    (when (> op 0.002f0)
      (paint-push) (paint-opacity! op)
      (let* ((bx (f-floor+ (- x (* 0.5f0 ww)))) (by (f-floor+ (+ y dy (line-baseline +f-display+ gz 1f0)))))
        (declare (single-float bx by))
        (paint-pen! bx (+ by (* 2f0 (lay-dpr))) gz :spacing 0.2f0) (paint-text s +f-display+ +c-word-shadow+)
        (paint-pen! bx by gz :spacing 0.2f0) (paint-text s +f-display+ (case (second wd) (1 +c-blood+) (2 +c-reiatsu+) (t +c-paper+))))
      (paint-pop))
    nil))

(defparameter +c-trail0+ (rgba #xeeeeea 0f0))
(defun-fast lhud-fx ()
  "The touch ink over everything (z 15): ripples (16u, a 2 px ring), brush trails (1.6u, transparent -> paper, an elliptical end),
the words; the Kikon hold ring under the thumb (14u, blood, hd-ring .6 s)."
  (let* ((now (aref *ui-clock* 0)) (u (lay-u 1f0)) (dpr (lay-dpr)) (fv *lhud-fx-f*) (iv *lhud-fx-i*) (pts *lhud-pts*))
    (declare (single-float now u dpr) (type f32vec fv pts) (type (simple-array fixnum (*)) iv))
    (paint-reset)
    (when (= 1 (aref iv (+ 2 (* 2 +fx-n+))))
      (let* ((rr (* 7f0 u (/ 15.9f0 18f0))) (th (* 14f0 u (/ 3f0 36f0))) (f (f-min 1f0 (/ (- now (aref *lhud-fx-ring* 0)) 0.6f0))))
        (declare (single-float rr th f))
        (when (> f 0f0) (paint-ellipse! (aref *lhud-fx-ring* 1) (aref *lhud-fx-ring* 2) (+ rr (* 0.5f0 th)) (+ rr (* 0.5f0 th)) +c-blood+ :thick th :frac f))))
    (dotimes (n +fx-n+)
      (let* ((k (aref iv (* 2 n))) (o (* 6 n)) (t0 (aref fv o)) (age (- now t0)) (x (aref fv (+ o 1))) (y (aref fv (+ o 2))))
        (declare (fixnum k o) (single-float t0 age x y))
        (when (and (> k 0) (< age 0.9f0))
          (case k
            ((1 2) (let* ((s (twv *lhud-ink* t0 now 0)) (op (twv *lhud-ink* t0 now 1)) (r (* 8f0 u)))
                     (declare (single-float s op r))
                     (when (> op 0.002f0)
                       (with-col (c (if (= k 2) +c-blood+ +c-paper+)) (alpha! c op)
                         (paint-ellipse! x y (* s r) (* s r) c :thick (* s 2f0 dpr))))))
            (3 (let* ((len (aref fv (+ o 3))) (ang (aref fv (+ o 4))) (op (twv *lhud-trail* t0 now 0))
                      (cl (twv *lhud-trail-cut* t0 now 0)) (th (* 0.8f0 u)) (hl (* 0.5f0 len)))
                 (declare (single-float len ang op cl th hl))
                 (when (> op 0.002f0)
                   (paint-push) (paint-transform! x y :rot ang) (paint-opacity! op)
                   (paint-scissor! x (- y th 1f0) (+ x (* cl len)) (+ y th 1f0))
                   ;; border-radius 0 50% 50% 0 / 0 50% 50% 0: the left half square, the right half an ellipse quadrant pair
                   (dotimes (i 9)
                     (let* ((a (* 0.19635f0 (i->f i))))      ; (pi/16 steps over the right half-ellipse, top to bottom)
                       (declare (single-float a))
                       (setf (aref pts (* 2 i)) (+ x hl (* hl (f-sin a))) (aref pts (1+ (* 2 i))) (- y (* th (f-cos a))))))
                   (setf (aref pts 18) x (aref pts 19) (+ y th) (aref pts 20) x (aref pts 21) (- y th))
                   (paint-clip! -1f6 -1f6 1f6 1f6) (paint-grad! x 0f0 (+ x len) 0f0) (paint-poly pts 11 +c-trail0+ +c-paper+)
                   (paint-pop))))
            (4 (lane! x y t0) (lhud-word (aref iv (1+ (* 2 n)))))))))
    (paint-reset)
    nil))
