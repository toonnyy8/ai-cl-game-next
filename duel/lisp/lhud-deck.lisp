;;;; lhud-deck.lisp — the phone's deck and what sits on it (docs/duel/DUEL_LISP_HUD.md §13; hud.css "the deck" / .dbtn.rv / .rvc /
;;;; the clock tab, hud.js renderDeck): the thumb's paper (gradient and dot screen up to the pad's top), the SP 技 / ATK 斬 labels, the
;;;; 爆 dial (the flash step as the ink standing in it with its 1/3 and 2/3 ticks, armed at 2/3, the awakening ring, the hold ring,
;;;; 覺; arm / deny / slosh / press), your stance seals around it, and the clock tab that is the pause chip (digits or ∞, II 止 PAUSE).
;;;; LHUD-DECK-UPDATE is the system (V4's bits and the flash step's edges -> the dial's animations and words); the views only read the
;;;; model, that state and the UI clock. Places come from the model's permille numbers (V30-V43) as hud.js reads them (lhud-geom.lisp).
(in-package :duel)

(defconstant +fs-burst+ (/ 2f0 3f0) "hud.js FS_BURST: the dial arms at 2/3 of the flash step (a Burst's cost).")
(declaim (type f32vec *lhud-dk-tr* *lhud-dk-t*) (type (simple-array fixnum (*)) *lhud-dk-i*))
(defvar *lhud-dk-tr* (make-transitions 10 0f0)
  "The dial's transitions: [0] the level (.45 s ease-out), [1] armed (0 / 1: 爆's colour .25 s, the rim .2 s), [2] the awakening arc
(.4 s ease-out), [3] SUBLIMATION's arc, [4..7] the stance seals' on (.25 s ease-out), [8] pressed (scale .9, .15 s ease-snap).")
(defvar *lhud-dk-t* (make-array 8 :element-type 'single-float :initial-element -1f30)
  "Animation starts: [0] hd-arm, [1] hd-deny, [2] hd-dip (slosh), [3] hd-awfill (holding), [4] hd-kak (ready), [5] the ∞'s hd-write,
[6] the previous flash step (a fraction; -1 none yet).")
(defvar *lhud-dk-i* (make-array 4 :element-type 'fixnum :initial-element -1)
  "[0] V4 last frame, [1] armed last frame (1 / 0), [2] ready last frame, [3] PRACTICE's ∞ shown (1 / 0).")
(defparameter *lhud-arm* (make-tween '((0 nil 1 0) (0.4 nil 1.1 1) (1 nil 1 0)) :dur 0.42 :curve +ease-snap+ :base '(1 0))
  "hd-arm: scale 1 -> 1.1 at 40 % -> 1 and a 3 px blood ring at 40 %, .42 s ease-snap.")
(defparameter *lhud-deny* (make-tween '((0 nil 0) (0.25 nil -0.4) (0.6 nil 0.3) (1 nil 0)) :dur 0.3 :curve +ease-out+ :base '(0))
  "hd-deny: translate x 0 -> -.4u (25 %) -> .3u (60 %) -> 0, .3 s ease-out.")
(defparameter *lhud-dip* (make-tween '((0 nil 0) (0.4 nil 0.35) (1 nil 0)) :dur 0.32 :curve +ease-out+ :base '(0))
  "hd-dip: translate y 0 -> .35u (40 %) -> 0, .32 s ease-out.")
(defparameter *lhud-kak* (make-tween '((0 nil 0 1.9 -10) (1 nil 1 1 -3)) :dur 0.34 :curve +ease-snap+ :fill 3 :base '(1 1 -3))
  "hd-kak: opacity 0, scale 1.9, rotate -10deg -> opacity 1, rotate -3deg, .34 s ease-snap, both.")
(defparameter *lhud-write* (make-tween '((0 nil 0) (1 nil 1)) :dur 0.9 :curve +ease-cut+ :fill 3 :base '(1))
  "hd-write: the ∞'s stroke drawn 0 -> 1 (stroke-dashoffset 100 -> 0), .9 s ease-cut, both.")
(declaim (type f32vec *lhud-arm* *lhud-deny* *lhud-dip* *lhud-kak* *lhud-write*))

;;; ---------------------------------------------------------------- the system
(defun-fast lhud-deck-update ()
  "The dial's state from V4 (1 ready, 2 holding, 4 pressed, 8 a burst possible, 16 / 32 / 64 your burst's colour) and P1's flash
step (V56): the level, armed and its hd-arm, a Hoho's slosh (a drop of more than a quarter), holding's hd-awfill, the press's
words (BURST at 2/3, else NO BURST and hd-deny; 覺醒 AWAKEN on a held release), ready's hd-kak; the stance seals' on; the ∞."
  (let* ((now (aref *ui-clock* 0)) (tr *lhud-dk-tr*) (ts *lhud-dk-t*) (iv *lhud-dk-i*) (b (hv 4)) (pb (max 0 (aref iv 0)))
         (fs (* 0.001f0 (i->f (max 0 (min 1000 (hv 56)))))) (mode (logand b 112)) (armed (and (= mode 0) (>= fs (- +fs-burst+ 0.0005f0))))
         (ready (logtest b 1)) (o 50) (n (hv (+ o 9))) (red (not *reduced-motion*)))
    (declare (single-float now fs) (fixnum b pb mode o n) (type f32vec tr ts) (type (simple-array fixnum (*)) iv))
    (trans-to tr 0 fs now 0.45f0 +ease-out+)
    (trans-to tr 1 (if armed 1f0 0f0) now 0.25f0 +ease+)
    (trans-to tr 2 (* 0.001f0 (i->f (max 0 (min 1000 (hv (+ o 7)))))) now 0.4f0 +ease-out+)
    (trans-to tr 3 (* 0.001f0 (i->f (max 0 (hv (+ o 22))))) now 0.4f0 +ease-out+)
    (dotimes (i 4) (trans-to tr (+ 4 i) (if (= (1+ i) n) 1f0 0f0) now 0.25f0 +ease-out+))
    (trans-to tr 8 (if (logtest b 4) 0.9f0 1f0) now 0.15f0 +ease-snap+)
    (when (and red (>= (aref ts 6) 0f0) (hv-deck-p))
      (when (and armed (/= (aref iv 1) 1)) (setf (aref ts 0) now))
      (when (and (= mode 0) (< fs (- (aref ts 6) 0.25f0))) (setf (aref ts 2) now)))   ; a Hoho: the ink drops a third
    (when (hv-deck-p)
      (macrolet ((press ()
                   `(when (= mode 0)
                      (if (>= fs (- +fs-burst+ 0.0005f0))
                          (lhud-dial-word 6)
                          (progn (when red (setf (aref ts 1) now)) (lhud-dial-word 7))))))
        (when (and (logtest b 2) (not (logtest pb 2))) (setf (aref ts 3) now))
        (when (>= (aref iv 0) 0)
          (when (and (logtest b 4) (not (logtest pb 4)) (not (logtest b 1))) (press))
          (when (and (logtest pb 2) (not (logtest b 2)) (logtest b 4)) (lhud-dial-word 8))
          (when (and (logtest pb 2) (not (logtest b 2)) (not (logtest b 4))) (press)))))
    (when (and ready (/= (aref iv 2) 1)) (setf (aref ts 4) now))
    (let* ((inf (and (hv-practice-p) (logtest (hv 0) 1))))
      (when (and inf (/= (aref iv 3) 1)) (setf (aref ts 5) now))
      (setf (aref iv 3) (if inf 1 0)))
    (setf (aref iv 0) b (aref iv 1) (if armed 1 0) (aref iv 2) (if ready 1 0) (aref ts 6) fs)
    nil))

(defun-fast lhud-dial-word (word)
  "A word over 爆 (hud.js seal: at the seal's top centre): BURST, NO BURST, 覺醒 AWAKEN."
  (declare (fixnum word))
  (let* ((w (lay-w)) (h (lay-h)))
    (declare (single-float w h))
    (lane! (/ (* w (i->f (hv 36))) 1000f0) (- (/ (* h (i->f (hv 37))) 1000f0) (/ (* w (i->f (hv 38))) 1000f0)) 0f0 0f0)
    (lhud-fx-add 4 word))
  nil)

;;; ---------------------------------------------------------------- the deck's paper and labels
(defparameter +c-deck0+ (rgba #x0b0b10 0f0)) (defparameter +c-deck1+ (rgba #x0b0b10 0.42)) (defparameter +c-deck2+ (rgba #x0b0b10 0.58))
(defparameter +c-deckdot+ (rgba #xbcc1cc (* 0.18 0.5)))
(defparameter +c-zl+ (rgba #xeeeeea 0.42)) (defparameter +c-zlk+ (rgba #xeeeeea 0.3))
(defun-fast lhud-deck ()
  "The deck (hud.css .deck, z 9, under your plate): from the pad's top (V43) to its bottom, transparent -> .42 ink at 22 % -> .58,
a 7 px dot screen at .5 over it; SP 技 at 5 % from the thumb's edge, 1.8 cm over 44 % of the deck; ATK 斬 at 8 % from the far edge,
16 % over the bottom (800 1.6u display, .3em, .42; the kanji 1.5u Mincho, .3). The left hand swaps the edges."
  (let* ((u (lay-u 1f0)) (dpr (lay-dpr)) (g *lhud-g*) (left (hv-left-p)) (op (layer-op 1)))
    (declare (single-float u dpr op) (type f32vec g))
    (when (> op 0.002f0)
      (lhud-deck-line! g (lay-w) (lay-h) (hv 30) (hv 31) (hv 32) (hv 33) (hv 34) (hv 35) left)
      (let* ((x (aref g 4)) (y (aref g 5)) (dw (aref g 6)) (dh (aref g 7))
             (ext (f-max 0f0 (/ (* (lay-h) (i->f (- (hv 31) (hv 43)))) 1000f0))) (y0 (- y ext)) (th (+ dh ext)) (y22 (+ y0 (* 0.22f0 th))))
        (declare (single-float x y dw dh ext y0 th y22))
        (paint-reset)
        (paint-opacity! op)
        (paint-rect x y0 dw (- y22 y0) +c-deck0+ +c-deck1+)
        (paint-rect x y22 dw (- (+ y dh) y22) +c-deck1+ +c-deck2+)
        (paint-dots! (* 7f0 dpr) (* 1.2f0 dpr)) (paint-rect x y0 dw th +c-deckdot+) (paint-pattern-off!)
        (let* ((sz (* 1.6f0 u)) (kz (* 1.5f0 u)) (sw (text-w "SP" +f-display+ sz 0.3f0)) (aw (text-w "ATK" +f-display+ sz 0.3f0))
               (kw (text-w (kj "技") +f-kanji+ kz)) (gap (* 0.8f0 u))
               (rowh (row-h (+f-display+ sz 1f0) (+f-kanji+ kz 1f0))) (lab (aref *lhud-row* 0))   ; (display: flex, align-items: baseline)
               (spx (if left (+ x (* 0.05f0 dw)) (- (+ x dw) (* 0.05f0 dw) sw gap kw)))
               (spy (+ y (* 0.44f0 dh) (* -68.03f0 dpr) lab))
               (atw (+ aw gap kw)) (atx (if left (- (+ x dw) (* 0.08f0 dw) atw) (+ x (* 0.08f0 dw))))
               (aty (+ (- (+ y dh) (* 0.16f0 dh) rowh) lab)))
          (declare (single-float sz kz sw aw kw gap rowh lab spx spy atw atx aty))
          (paint-pen! (f-floor+ spx) (f-floor+ spy) sz :spacing 0.3f0) (paint-text "SP" +f-display+ +c-zl+)
          (paint-pen! (f-floor+ (+ spx sw gap)) (f-floor+ spy) kz) (paint-text (kj "技") +f-kanji+ +c-zlk+)
          (paint-pen! (f-floor+ atx) (f-floor+ aty) sz :spacing 0.3f0) (paint-text "ATK" +f-display+ +c-zl+)
          (paint-pen! (f-floor+ (+ atx aw gap)) (f-floor+ aty) kz) (paint-text (kj "斬") +f-kanji+ +c-zlk+))
        (paint-reset)))
    nil))

;;; ---------------------------------------------------------------- the clock tab (the pause chip)
(defparameter +c-tab+ (rgba #x0b0b10 0.5)) (defparameter +c-tab-line+ (rgba #xeeeeea 0.28)) (defparameter +c-tab-dot+ (rgba #xeeeeea 0.35))
(defparameter +c-clock-shade+ (rgba #x000000 0.55))
(defun-fast lhud-clock ()
  "The clock as the pause chip (hud.css #hud.hphone:not(.nodeck) .clock, hud.js: on Lisp's chip 6, 10.4 x 8.4u from its middle -
5.2u / 4.2u): a cut-corner tab (rgba(11,11,16,.5), an inset .28 line, a small ring top-right), the seconds (800 3.4u display,
tabular, a 3 px shadow; the last ten in blood, hd-tick) or PRACTICE's ∞ (drawn by hd-write), and II 止 PAUSE. Without the deck (two
hands in portrait): the digits alone at 2.4u / 3.4u + st."
  (let* ((u (lay-u 1f0)) (dpr (lay-dpr)) (w (lay-w)) (h (lay-h)) (deck (hv-deck-p)) (t0 (hv 1)) (prac (hv-practice-p))
         (op (* (layer-op 0) (if deck (layer-op 2) 1f0))) (now (aref *ui-clock* 0)) (pts *lhud-pts*))
    (declare (single-float u dpr w h op now) (fixnum t0) (type f32vec pts))
    (when (and (> op 0.002f0) (or prac (>= t0 0)))
      (let* ((bx (if deck (- (/ (* w (i->f (hv 39))) 1000f0) (* 5.2f0 u)) (* 2.4f0 u)))
             (by (if deck (- (/ (* h (i->f (hv 40))) 1000f0) (* 4.2f0 u)) (+ (* 3.4f0 u) (lay-inset 0))))
             (bw (* 10.4f0 u)) (bh (* 8.4f0 u)) (cx (+ bx (if deck (* 1.3f0 u) 0f0))) (cy (+ by (if deck (* 1.1f0 u) 0f0))))
        (declare (single-float bx by bw bh cx cy))
        (paint-reset)
        (paint-opacity! op)
        (when deck                                         ; polygon(0 0, 100% 0, 100% 78%, 86% 100%, 0 100%) + its inset line
          (setf (aref pts 0) bx (aref pts 1) by (aref pts 2) (+ bx bw) (aref pts 3) by (aref pts 4) (+ bx bw) (aref pts 5) (+ by (* 0.78f0 bh))
                (aref pts 6) (+ bx (* 0.86f0 bw)) (aref pts 7) (+ by bh) (aref pts 8) bx (aref pts 9) (+ by bh))
          (paint-clip! -1f6 -1f6 1f6 1f6) (paint-poly pts 5 +c-tab+ +c-tab+)
          (paint-rect bx by bw dpr +c-tab-line+) (paint-rect bx (+ by dpr) dpr (- bh (* 2f0 dpr)) +c-tab-line+)
          (paint-rect bx (- (+ by bh) dpr) (* 0.86f0 bw) dpr +c-tab-line+)
          (paint-rect (- (+ bx bw) dpr) (+ by dpr) dpr (- (* 0.78f0 bh) dpr) +c-tab-line+)
          (paint-ellipse! (- (+ bx bw) (* 0.95f0 u) (* 0.35f0 u)) (+ by (* 0.75f0 u) (* 0.35f0 u)) (* 0.35f0 u) (* 0.35f0 u) +c-tab-dot+ :thick dpr))
        (if prac
            (let* ((k (* 0.1f0 u)) (f (twv *lhud-write* (aref *lhud-dk-t* 5) now 0)) (np (floor (length *sh-inf*) 2)))
              (declare (single-float k f) (fixnum np))
              (when (> f 0.001f0)                          ; the svg 6.6 x 3.2u (viewBox 66 x 32: .1u a unit), stroke 2.6, round, a 2 px shadow
                (paint-push) (paint-transform! 0f0 0f0 :sx k :sy k :dx cx :dy (+ cy (* 2f0 dpr)))
                (paint-stroke! *sh-inf* np 2.6f0 +c-clock-shade+ :frac f :round t) (paint-pop)
                (paint-push) (paint-transform! 0f0 0f0 :sx k :sy k :dx cx :dy cy)
                (paint-stroke! *sh-inf* np 2.6f0 +c-paper+ :frac f :round t) (paint-pop)))
            (let* ((tz (* 3.4f0 u)) (base (f-floor+ (+ cy (line-baseline +f-display+ tz 0.85f0))))
                   (end (<= t0 10)) (blink (and end (>= (f-mod now 1f0) 0.5f0))))
              (declare (single-float tz base))
              (paint-push) (when blink (paint-opacity! 0.55f0))
              (paint-pen! (f-floor+ cx) (+ base (* 3f0 dpr)) tz :spacing 0.01f0) (paint-int-tab t0 +f-display+ +c-clock-shade+ 2)
              (paint-pen! (f-floor+ cx) base tz :spacing 0.01f0) (paint-int-tab t0 +f-display+ (if end +c-blood+ +c-paper+) 2)
              (paint-pop)))
        (when deck                                         ; II 止 PAUSE at the bottom (align-content: space-between)
          (let* ((rh (* 1.45f0 u)) (ry (- (+ by bh) u rh)) (rc (+ ry (* 0.5f0 rh))) (x cx) (kz (* 1.45f0 u)) (pz u))
            (declare (single-float rh ry rc x kz pz))
            (paint-rect x (- rc (* 0.575f0 u)) (* 0.32f0 u) (* 1.15f0 u) +c-paper+)
            (paint-rect (+ x (* 0.56f0 u)) (- rc (* 0.575f0 u)) (* 0.32f0 u) (* 1.15f0 u) +c-paper+)
            (setf x (+ x (* 0.88f0 u) (* 0.55f0 u)))
            (paint-pen! (f-floor+ x) (f-floor+ (+ (- rc (* 0.5f0 kz)) (line-baseline +f-kanji+ kz 1f0))) kz) (paint-text (kj "止") +f-kanji+ +c-paper+)
            (setf x (+ x (text-w (kj "止") +f-kanji+ kz) (* 0.55f0 u)))
            (paint-pen! (f-floor+ x) (f-floor+ (+ (- rc (* 0.5f0 pz)) (line-baseline +f-mono+ pz 1f0))) pz :spacing 0.16f0)
            (paint-text "PAUSE" +f-mono+ +c-steel+)))
        (paint-reset)))
    nil))

;;; ---------------------------------------------------------------- 爆 and the stance ring
(declaim (type f32vec *lhud-circ* *lhud-circ-p*))
(defvar *lhud-circ* (let* ((v (make-f32 96))) (dotimes (i 48 v) (let* ((a (/ (* 2 pi i) 48))) (setf (aref v (* 2 i)) (f32 (sin a)) (aref v (1+ (* 2 i))) (f32 (- (cos a)))))))
  "A unit circle as 48 points, clockwise from the top (爆's ink level as a polygon).")
(defvar *lhud-circ-p* (make-f32 96) "*LHUD-CIRC* placed (scratch).")
(defparameter +c-rv-rim+ (rgba #xe81e3a 0.4)) (defparameter +c-rv-ring1+ (rgba #xe81e3a 0.35))
(defparameter +c-lvl0+ (rgba #x8f96a6)) (defparameter +c-lvl1+ (rgba #x5d6474)) (defparameter +c-lvlw1+ (rgba #xc9cbcf))
(defparameter +c-tick+ (rgba #xeeeeea 0.45)) (defparameter +c-tick-in+ (rgba #x0b0b10 0.7))
(defparameter +c-trk+ (rgba #x2c303d 0.95)) (defparameter +c-readyglow+ (rgba #xffd83a 0.2)) (defparameter +c-awglow+ (rgba #xffd83a 0.6))
(defparameter +c-burst-w+ (rgba #xf2f5ff)) (defparameter +c-burst-b+ (rgba #x66a8ff)) (defparameter +c-burst-o+ (rgba #xff942e))

(defun-fast lhud-face (ink)
  "One face of 爆 (.face: 爆 800 2.2u Mincho over RV 600 .85u mono .12em, 2 px apart, centred; the ticks at 1/3 and 2/3, 1.5 px, with a
gap of 1.05u / 1.35u each side of the middle). INK: the face inside the ink (its glyphs ink, ticks .7 ink); else stone / paper (armed)
and steel, ticks .45 paper / paper (armed). *LHUD-A*: the centre x y, the face's radius, the armed blend, u."
  (let* ((a *lhud-a*) (cx (aref a 0)) (cy (aref a 1)) (r (aref a 2)) (arm (aref a 3)) (u (aref a 4)) (dpr (lay-dpr))
         (bz (* 2.2f0 u)) (rz (* 0.85f0 u)) (th (* 2f0 r)) (hgt (+ bz (* 2f0 dpr) rz)) (top (- cy (* 0.5f0 hgt)))
         (bw (text-w (kj "爆") +f-kanji+ bz)) (rw (text-w "RV" +f-mono+ rz 0.12f0)))
    (declare (single-float cx cy r arm u dpr bz rz th hgt top bw rw) (type f32vec a))
    (dotimes (i 2)                                         ; the ticks: chords of the face, cut at the circle
      (let* ((yb (- (+ cy r) (* th (if (= i 0) 0.33333f0 0.66667f0)))) (yc (- yb (* 0.75f0 dpr))) (g (* u (if (= i 0) 1.05f0 1.35f0)))
             (dy (- yc cy)) (half (f-sqrt (f-max 0f0 (- (* r r) (* dy dy)))))
             (col (if ink +c-tick-in+ (col-mix +c-tick+ +c-paper+ arm))))
        (declare (single-float yb yc g dy half))
        (when (> half g)
          (paint-rect (- cx half) (- yb (* 1.5f0 dpr)) (- half g) (* 1.5f0 dpr) col)
          (paint-rect (+ cx g) (- yb (* 1.5f0 dpr)) (- half g) (* 1.5f0 dpr) col))))
    (paint-pen! (f-floor+ (- cx (* 0.5f0 bw))) (f-floor+ (+ top (line-baseline +f-kanji+ bz 1f0))) bz)
    (paint-text (kj "爆") +f-kanji+ (if ink +c-ink+ (col-mix +c-stone+ +c-paper+ arm)))
    (paint-pen! (f-floor+ (- cx (* 0.5f0 rw))) (f-floor+ (+ top bz (* 2f0 dpr) (line-baseline +f-mono+ rz 1f0))) rz :spacing 0.12f0)
    (paint-text "RV" +f-mono+ (if ink +c-ink+ +c-steel+))
    nil))

(defun-fast lhud-dial ()
  "爆 (hud.css .dbtn.rv, draft C): night disc and a 1.5 px rim (.4 blood; armed blood + a 1 px ring, + a 1.4u glow when a burst is
possible; ready: a 1.6u reiatsu glow), the ink level (#8f96a6 -> #5d6474; armed white -> #c9cbcf; a running Burst its colour) with
the inked face inside it and the plain face above it (the clip-path's level, .45 s ease-out), the awakening ring outside (a .95
slate track; the awakening clockwise from the top, the left hand counter-clockwise; SUBLIMATION pink; DRIVE red; ready: thicker and
breathing), the hold ring (hd-awfill .3 s), 覺 over it when ready (hd-kak); pressed scale .9, hd-arm, hd-deny, hd-dip."
  (let* ((op (layer-op 1)))
    (declare (single-float op))
    (when (> op 0.002f0)
      (let* ((now (aref *ui-clock* 0)) (u (lay-u 1f0)) (dpr (lay-dpr)) (w (lay-w)) (h (lay-h)) (tr *lhud-dk-tr*) (ts *lhud-dk-t*)
             (cx (/ (* w (i->f (hv 36))) 1000f0)) (cy (/ (* h (i->f (hv 37))) 1000f0)) (r (/ (* w (i->f (hv 38))) 1000f0))
             (b (hv 4)) (mode (logand b 112)) (ready (logtest b 1)) (can (logtest b 8)) (m (hv 73)) (left (hv-left-p))
             (lv (trans-value tr 0 now)) (arm (trans-value tr 1 now)) (armed (and (= mode 0) (> arm 0.5f0)))
             (aw (trans-value tr 2 now)) (sb (trans-value tr 3 now)) (pr (trans-value tr 8 now))
             (ka (twv *lhud-arm* (aref ts 0) now 0)) (kr (twv *lhud-arm* (aref ts 0) now 1))
             (dx (* u (twv *lhud-deny* (aref ts 1) now 0))) (dy (* u (twv *lhud-dip* (aref ts 2) now 0)))
             (s (* pr ka)) (ri (- r (* 1.5f0 dpr))))       ; the padding box: inside the 1.5 px border
        (declare (single-float now u dpr w h cx cy r lv arm aw sb pr ka kr dx dy s ri) (fixnum b mode m) (type f32vec tr ts))
        (paint-reset)
        (paint-opacity! op)
        (paint-transform! cx cy :sx s :sy s :dx dx :dy dy)
        ;; the glows (box-shadow, priority as the CSS: armed.can > armed > ready)
        (cond ((and armed can) (paint-ellipse! cx cy r r +c-rv-ring1+ :feather (* 1.4f0 u)))   ; (blur B: the circle feathered over B)
              (armed (paint-ellipse! cx cy (+ r dpr) (+ r dpr) +c-rv-ring1+ :thick dpr))
              (ready (paint-ellipse! cx cy r r +c-readyglow+ :feather (* 1.6f0 u))))
        (when (> kr 0.01f0) (with-col (c +c-blood+) (alpha! c kr) (paint-ellipse! cx cy (+ r (* 3f0 dpr)) (+ r (* 3f0 dpr)) c :thick (* 3f0 dpr))))
        (paint-ellipse! cx cy r r +c-night+)
        (paint-ellipse! cx cy r r (col-mix +c-rv-rim+ +c-blood+ arm) :thick (* 1.5f0 dpr))
        ;; the ink level: the well's disc cut from below at LV of its height, with the inked face inside it
        (let* ((top (- (+ cy ri) (* 2f0 ri lv))))
          (declare (single-float top))
          (when (> lv 0.001f0)                             ; (a circle polygon cut at the level, its gradient over the ink's height)
            (let* ((cp *lhud-circ-p*) (cu *lhud-circ*))
              (declare (type f32vec cp cu))
              (dotimes (i 96) (setf (aref cp i) (+ (if (evenp i) cx cy) (* ri (aref cu i)))))
              (let* ((bc (case mode (16 +c-burst-w+) (32 +c-burst-b+) (t +c-burst-o+))))
                (paint-clip! (- cx ri 2f0) top (+ cx ri 2f0) (+ cy ri 2f0) top (+ cy ri) 2)
                (if (/= mode 0)
                    (paint-poly cp 48 bc bc)
                    (let* ((c1 (with-col (c (col-mix +c-lvl1+ +c-lvlw1+ arm)) c)))   ; (C1 copied first: COL-MIX reuses one scratch)
                      (paint-poly cp 48 (col-mix +c-lvl0+ +c-white+ arm) c1)))))
            (paint-push) (paint-scissor! (- cx ri) top (+ cx ri) (+ cy ri))
            (lane! cx cy ri arm u) (lhud-face t)
            (paint-pop))
          (when (< lv 0.999f0)                             ; the plain face above the ink
            (paint-push) (paint-scissor! (- cx ri) (- cy ri) (+ cx ri) top)
            (lane! cx cy ri arm u) (lhud-face nil)
            (paint-pop)))
        ;; the awakening ring: the svg inset -.92u, r 18.4 of 40, strokes in its units
        (let* ((k (/ (+ (* 2f0 ri) (* 1.84f0 u)) 40f0)) (rr (* 18.4f0 k)) (rdy (or ready (= m 3)))
               (aww (* k (if rdy 2.1f0 1.65f0))) (awc (if (>= m 2) +c-drive+ +c-reiatsu+))
               (breath (if rdy (- 0.5f0 (* 0.5f0 (f-cos (* 3.927f0 now)))) 0f0)))
          (declare (single-float k rr aww breath))
          (paint-ellipse! cx cy (+ rr (* 0.75f0 k)) (+ rr (* 0.75f0 k)) +c-trk+ :thick (* 1.5f0 k))
          (when (> aw 0.001f0)
            (when (> breath 0.01f0)                       ; hd-awbreath: a 2.5 px reiatsu drop-shadow at 50 %
              (with-col (c awc) (alpha! c (* 0.6f0 breath))
                (paint-ellipse! cx cy (+ rr (* 0.5f0 aww) (* 2.5f0 dpr)) (+ rr (* 0.5f0 aww) (* 2.5f0 dpr)) c
                                :thick (+ aww (* 5f0 dpr)) :feather (* 2.5f0 dpr) :frac aw :ccw left)))
            (paint-ellipse! cx cy (+ rr (* 0.5f0 aww)) (+ rr (* 0.5f0 aww)) awc :thick aww :frac aw :ccw left))
          (when (and (= m 1) (> sb 0.001f0))
            (paint-ellipse! cx cy (+ rr (* 0.95f0 k)) (+ rr (* 0.95f0 k)) +c-pink+ :thick (* 1.9f0 k) :frac sb :ccw left))
          (when (logtest b 2)                              ; the hold ring: r 15.6, stroke 3, hd-awfill .3 s linear
            (let* ((f (f-min 1f0 (/ (- now (aref ts 3)) 0.3f0))))
              (declare (single-float f))
              (when (> f 0f0) (paint-ellipse! cx cy (* 17.1f0 k) (* 17.1f0 k) +c-reiatsu+ :thick (* 3f0 k) :frac f :ccw left)))))
        (when ready                                        ; 覺: top -2.6u, 1.25u Mincho ink on reiatsu, padding .25u .35u (hd-kak)
          (let* ((ko (twv *lhud-kak* (aref ts 4) now 0)) (ks (twv *lhud-kak* (aref ts 4) now 1))
                 (krot (* 0.017453f0 (twv *lhud-kak* (aref ts 4) now 2))) (kz (* 1.25f0 u))
                 (kw (+ kz (* 0.7f0 u))) (kh (+ kz (* 0.5f0 u))) (kcx cx) (kcy (+ (- cy r) (* 1.5f0 dpr) (* -2.6f0 u) (* 0.5f0 kh))))
            (declare (single-float ko ks krot kz kw kh kcx kcy))
            (when (> ko 0.002f0)
              (paint-push) (paint-transform! kcx kcy :rot krot :sx ks :sy ks) (paint-opacity! ko)
              (paint-box! kcx kcy (* 0.5f0 kw) (* 0.5f0 kh) 0f0 1f0 0f0 +c-reiatsu+)
              (paint-pen! (- kcx (* 0.5f0 (text-w (kj "覺") +f-kanji+ kz))) (+ (- kcy (* 0.5f0 kz)) (line-baseline +f-kanji+ kz 1f0)) kz)
              (paint-text (kj "覺") +f-kanji+ +c-ink+)
              (paint-pop))))
        (paint-reset)))
    nil))

(defun-fast lhud-ring ()
  "Your stance seals around 爆 (hud.css .rvc: a circle of 6.2u at 304 / 270 / 236 / 202 degrees, mirrored by the hand; the seals on
rgba(11,11,16,.42); the live one paper, rotate -4deg scale 1.1 about the 0 x 0 box's own origin, as the CSS composes it, so it
also moves out), the live one's name (.pn .78u mono, .14em, a 1 px shadow) 9.4u from the middle on the far side."
  (let* ((op (layer-op 1)) (n (hv 59)))
    (declare (single-float op) (fixnum n))
    (when (and (> op 0.002f0) (> n 0))
      (let* ((now (aref *ui-clock* 0)) (u (lay-u 1f0)) (w (lay-w)) (h (lay-h)) (left (hv-left-p)) (g *lhud-g*)
             (cx (/ (* w (i->f (hv 36))) 1000f0)) (cy (/ (* h (i->f (hv 37))) 1000f0)) (sz (* 2.2f0 u)) (hz (* 1.1f0 u))
             (seals (side-c 0 5)) (ns (min 4 (length seals))))
        (declare (single-float now u w h cx cy sz hz) (fixnum ns) (type f32vec g))
        (lhud-seal-ring! g cx cy (* 6.2f0 u) left)
        (paint-reset)
        (paint-opacity! op)
        (dotimes (i ns)
          (let* ((on (trans-value *lhud-dk-tr* (+ 4 i) now)) (sx (aref g (* 2 i))) (sy (aref g (1+ (* 2 i)))))
            (declare (single-float on sx sy))
            (paint-push)                                   ; rotate / scale about the 0 x 0 box's corner origin (cx + 1.1u, cy + 1.1u)
            (when (> on 0.001f0) (paint-transform! (+ cx hz) (+ cy hz) :rot (* -0.069813f0 on) :sx (+ 1f0 (* 0.1f0 on)) :sy (+ 1f0 (* 0.1f0 on))))
            (lane! sx sy sz on) (lhud-seal (first (nth i seals)) (logbitp i (hv 74)) +c-seal-bg+)
            (paint-pop)))
        (let* ((name (second (nth (1- (min n ns)) seals))) (pz (* 0.78f0 u)) (pw (text-w name +f-mono+ pz 0.14f0))
               (px (if left (+ cx (* 9.4f0 u)) (- cx (* 9.4f0 u) pw))) (py (f-floor+ (+ (- cy (* 0.45f0 u)) (line-baseline +f-mono+ pz 1f0)))))
          (declare (single-float pz pw px py))
          (paint-pen! (f-floor+ px) (+ py (lay-dpr)) pz :spacing 0.14f0) (paint-text name +f-mono+ +c-word-shadow+)
          (paint-pen! (f-floor+ px) py pz :spacing 0.14f0) (paint-text name +f-mono+ +c-steel+))
        (paint-reset)))
    nil))
