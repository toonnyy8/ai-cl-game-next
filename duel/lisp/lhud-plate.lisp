;;;; lhud-plate.lisp — the plates (docs/duel/DUEL_LISP_HUD.md §13; hud.css "the plates", hud.js renderPlate / renderKit): the name
;;;; row, the Reishi bar with its ghost, the nine soul flames, the flash-step and awakening meters, the pointer seals, Kenpachi's kit
;;;; strip, the phone's ink pool; laid out as the opponent's plate at the top (phone) or both plates (desktop, phase 3 completes it),
;;;; and as your plate lying on the deck's line (the phone, draft C 界: rotated to the line, flames and name above the bar).
;;;; Element state (the ghost's drain, the fill's cut, each flame's fade and shatter, the meters, the seals) is component data in
;;;; *LHUD-TR* / *LHUD-PL*, retargeted by the system LHUD-PLATE-UPDATE from the model before the views run; the views (LHUD-PLATE,
;;;; LHUD-PLATE-LINE and their row drawers) only read the model, that state and the UI clock, and paint. Row drawers take their
;;;; floats through *LHUD-A* (no float crosses a call boxed: 0 B a frame).
(in-package :duel)

(defconstant +tr-side+ 40 "Transition slots per side in *LHUD-TR*.")
;; slots (+ (* side +tr-side+) k): 0 the ghost, 1 the fill's cut, 2-10 the flames' fade, 11-19 the spent flames' dots, 20-22 the flash
;; step's cells, 23 the awakening bar, 24 SUBLIMATION, 25 the awakening label's opacity, 26-29 the seals' on (0 / 1), 30-32 the flash step's cells with the SP reserve stacked on (DUEL_LISP_HUD §17); the burning span (V25, a BLUE burst) is read from the model, not tweened
(declaim (type f32vec *lhud-tr* *lhud-pl* *lhud-a* *lhud-pts*) (type (simple-array fixnum (*)) *lhud-pli*))
(defvar *lhud-tr* (make-transitions (* 2 +tr-side+)) "The plates' transitions (tween.lisp): see +TR-SIDE+.")
(defvar *lhud-pl* (make-array 24 :element-type 'single-float :initial-element -1f30)
  "Per side at 12 s: [0..8] each flame's shatter start, [9] when the plate went low (hd-stake's start), [10] a refused SP press's start.")
(defvar *lhud-pli* (make-array 6 :element-type 'fixnum :initial-element -1)
  "Per side at 2 s: [0] the Konpaku last seen, [1] low last seen; [4 + side] the refused serial last seen.")
(defvar *lhud-a* (make-f32 8) "The row drawers' float arguments (LANE!).")
(defvar *lhud-pts* (make-f32 32) "Polygon scratch (16 points: the trail takes 11).")
(defmacro lane! (&rest vals)
  "Store VALS (single-float forms) into *LHUD-A* from index 0: a row drawer's arguments (no float crosses a call boxed)."
  (let* ((v (gensym "V"))) `(let* ((,v *lhud-a*)) (setf ,@(loop for x in vals for i from 0 append `((aref ,v ,i) ,x))))))
(defmacro tr (side k) `(+ (* ,side +tr-side+) ,k))
(defvar *lhud-lv* (coerce (loop for i below 10 collect (format nil "L~d" i)) 'simple-vector) "KAIHO's L0..L9.")
(declaim (type f32vec *lhud-seg*))
(defvar *lhud-seg* (make-f32 4) "One segment's two points (SUBSEQ-F32).")
(defmacro subseq-f32 (v start) "The two points of V from START in *LHUD-SEG* (0 B)." `(replace *lhud-seg* ,v :start2 ,start :end2 (+ ,start 4)))
(declaim (type f32vec *lhud-g*))
(defvar *lhud-g* (make-f32 8) "LHUD-DECK-LINE!'s out lane.")

;;; ---------------------------------------------------------------- the system: the model's changes -> the plates' transitions
(defun-fast lhud-plate-update (side)
  "Retarget side SIDE's plate transitions from the model (hud.css's transitions, hud.js's class toggles), at the UI clock."
  (declare (fixnum side))
  (let* ((now (aref *ui-clock* 0)) (o (side-o side)) (trs *lhud-tr*) (pl *lhud-pl*) (pli *lhud-pli*)
         (r (* 0.001f0 (i->f (max 0 (hv (+ o 1)))))) (kon (max 0 (hv (+ o 3)))) (low (if (= 1 (hv (+ o 2))) 1 0))
         (fs (* 0.003f0 (i->f (max 0 (hv (+ o 6)))))) (b (* side +tr-side+)) (n (hv (+ o 9))))
    (declare (single-float now r fs) (fixnum o kon low b n) (type f32vec trs pl) (type (simple-array fixnum (*)) pli))
    ;; the ghost: a drop drains after .38 s over .55 s (ease-cut); a refill snaps (hud.js: the transition only on a drop)
    (if (< r (aref trs (+ (* 6 b) 1)))
        (trans-to trs b r now 0.55f0 +ease-cut+ 0.38f0)
        (trans-to trs b r now 0f0 +ease-cut+))
    (trans-to trs (+ b 1) r now 0.12f0 +ease-out+)        ; the fill's cut (clip-path .12s ease-out)
    ;; the flames: a spent one fades (.3s after .15s), its dot shows (.3s after .3s); a fresh loss shatters (hd-shatter)
    (dotimes (i 9)
      (let* ((gone (>= i kon)))
        (trans-to trs (+ b 2 i) (if gone 0f0 1f0) now 0.3f0 +ease+ 0.15f0)
        (trans-to trs (+ b 11 i) (if gone 0.85f0 0f0) now 0.3f0 +ease+ 0.3f0)
        (when (and gone (>= (aref pli (* 2 side)) 0) (< i (aref pli (* 2 side))) (not *reduced-motion*))
          (setf (aref pl (+ (* 12 side) i)) now))))
    (when (and (= low 1) (/= (aref pli (1+ (* 2 side))) 1)) (setf (aref pl (+ (* 12 side) 9)) now))
    (setf (aref pli (* 2 side)) kon (aref pli (1+ (* 2 side))) low)
    (dotimes (i 3) (trans-to trs (+ b 20 i) (f-max 0f0 (f-min 1f0 (- fs (i->f i)))) now 0.25f0 +ease-out+))
    ;; the SP reserve (V o+26) rides on top: the cells' total (lit + reserve) holds still when a segment pays or a cancel refunds, so the
    ;; lit part sinks into / grows out of the dim one with no jump; it shrinks to the lit part when the segment ends (.35 s)
    (let* ((tot (+ fs (* 0.003f0 (i->f (max 0 (hv (+ o 26)))))))
           (ser (hv (+ o 29))) (prev (aref pli (+ 4 side))))
      (declare (single-float tot) (fixnum ser prev))
      (dotimes (i 3) (trans-to trs (+ b 30 i) (f-max 0f0 (f-min 1f0 (- tot (i->f i)))) now 0.35f0 +ease-out+))
      (when (and (>= prev 0) (> ser 0) (/= ser prev)) (setf (aref pl (+ (* 12 side) 10)) now))   ; a refused SP press: the cells flash blood
      (setf (aref pli (+ 4 side)) ser))
    (trans-to trs (+ b 23) (* 0.001f0 (i->f (max 0 (hv (+ o 7))))) now 0.4f0 +ease-out+)
    (trans-to trs (+ b 24) (* 0.001f0 (i->f (max 0 (hv (+ o 22))))) now 0.4f0 +ease-out+)
    (trans-to trs (+ b 25) (if (or (= 1 (hv (+ o 8))) (> (hv (+ o 23)) 0)) 1f0 0f0) now 0.3f0 +ease+)
    (dotimes (i 4) (trans-to trs (+ b 26 i) (if (= (1+ i) n) 1f0 0f0) now 0.25f0 +ease-out+))
    nil))

;;; ---------------------------------------------------------------- rows
(defun-fast lhud-name-row (side mir tag-auto)
  "The name row (.who): name, kanji and tag on one baseline. *LHUD-A*: x, y (the row's top), width, the name's size, the kanji's,
the tag's, u. MIR: row-reverse (P2, the mirrored plate). TAG-AUTO: the tag at the far end (margin-inline-start: auto); else .3u after
the kanji (the plate on the line). Returns nil; the row's height is ROW-H's of the same sizes."
  (declare (fixnum side))
  (let* ((a *lhud-a*) (x (aref a 0)) (y (aref a 1)) (w (aref a 2)) (nm (aref a 3)) (kz (aref a 4)) (tz (aref a 5)) (u (aref a 6))
         (dpr (lay-dpr)) (name (side-c side 3)) (entry (side-c side 2)) (kanji (and entry (second entry))) (segs (side-c side 4))
         (base (progn (row-h (+f-display+ nm 0.9f0) (+f-kanji+ kz 1f0) (+f-mono+ tz 1f0)) (+ y (aref *lhud-row* 0))))
         (wn (if name (text-w name +f-display+ nm 0.06f0) 0f0)) (wk (if kanji (text-w kanji +f-kanji+ kz 0.15f0) 0f0)) (wt 0f0))
    (declare (single-float x y w nm kz tz u dpr base wn wk wt) (type f32vec a))
    (dolist (sg segs) (incf wt (text-w (car sg) +f-mono+ tz 0.16f0)))
    (let* ((xn (if mir (- (+ x w) wn) x)) (xk (if mir (- xn (* 0.9f0 u) wk) (+ xn wn (* 0.9f0 u))))
           (xt (cond ((and tag-auto mir) x) (tag-auto (- (+ x w) wt))
                     (mir (- xk (* 1.2f0 u) wt)) (t (+ xk wk (* 1.2f0 u)))))
           (by (f-floor+ base)))
      (declare (single-float xn xk xt by))
      (when name
        (paint-pen! (f-floor+ xn) (+ by (* 2f0 dpr)) nm :spacing 0.06f0) (paint-text name +f-display+ +c-shade+)
        (paint-pen! (f-floor+ xn) by nm :spacing 0.06f0) (paint-text name +f-display+ +c-paper+))
      (when kanji (paint-pen! (f-floor+ xk) by kz :spacing 0.15f0) (paint-text kanji +f-kanji+ +c-steel+))
      (paint-pen! (f-floor+ xt) by tz :spacing 0.16f0)
      (dolist (sg segs) (paint-text (car sg) +f-mono+ (if (cdr sg) +c-jade+ +c-stone+))))
    nil))

(defun-fast lhud-bar (side mir low-alpha)
  "The Reishi bar (.reishi): polygon(0 18%, 3% 0, 100% 0, 98.6% 100%, 1.2% 100%, 0 78%), mirrored for MIR; the blood ghost beyond the
fill, the fill (white -> paper 45 % -> #c9cbcf; low: #ff6b7f -> blood, hd-pulse), the fixed grid, the inset line. *LHUD-A*: x, y, w,
h, the background's alpha, the line's alpha. LOW-ALPHA unused (kept for the call shape)."
  (declare (fixnum side) (ignore low-alpha))
  (let* ((a *lhud-a*) (bx (aref a 0)) (by (aref a 1)) (bw (aref a 2)) (bh (aref a 3)) (bga (aref a 4)) (lna (aref a 5))
         (now (aref *ui-clock* 0)) (dpr (lay-dpr)) (o (side-o side)) (pts *lhud-pts*)
         (gv (trans-value *lhud-tr* (tr side 0) now)) (r (trans-value *lhud-tr* (tr side 1) now)) (low (= 1 (hv (+ o 2))))
         (fx0 0f0) (fx1 0f0))
    (declare (single-float bx by bw bh bga lna now dpr gv r fx0 fx1) (type f32vec a pts) (fixnum o))
    (macrolet ((pt (i x y) `(setf (aref pts ,(* 2 i)) (+ bx (* bw (if mir (- 1f0 ,x) ,x))) (aref pts ,(1+ (* 2 i))) (+ by (* bh ,y)))))
      (pt 0 0f0 0.18f0) (pt 1 0.03f0 0f0) (pt 2 1f0 0f0) (pt 3 0.986f0 1f0) (pt 4 0.012f0 1f0) (pt 5 0f0 0.78f0))
    (with-col (c +c-bar-bg+) (col-alpha! c bga) (paint-clip! bx by (+ bx bw) (+ by bh)) (paint-poly pts 6 c c))
    (setf fx0 (if mir (+ bx (* bw (- 1f0 gv))) (+ bx (* bw r))) fx1 (if mir (+ bx (* bw (- 1f0 r))) (+ bx (* bw gv))))
    (when (> gv r) (paint-clip! fx0 by fx1 (+ by bh) 0f0 1f0 (if mir 1 4)) (paint-poly pts 6 +c-blood+ +c-blood+))
    (setf fx0 (if mir (+ bx (* bw (- 1f0 r))) bx) fx1 (if mir (+ bx bw) (+ bx (* bw r))))
    (when (> r 0f0)
      (let* ((end (if mir 1 4)))                           ; the fill's moving end is antialiased, the band split is not (no seam)
        (declare (fixnum end))
        (if low
            (let* ((k (* 0.35f0 (- 0.5f0 (* 0.5f0 (f-cos (* 5.712f0 now)))))))   ; hd-pulse 1.1s: brightness 1.35 at 50 %
              (declare (single-float k))
              (paint-clip! fx0 by fx1 (+ by bh) by (+ by bh) end)
              (paint-poly pts 6 (col-mix! *lhud-mix* +c-low-hi+ +c-white+ (* 0.5f0 k)) (with-col (c +c-blood+) (dotimes (i 3) (setf (aref c i) (f-min 1f0 (* (aref c i) (+ 1f0 k))))) c)))
            (let* ((ym (+ by (* 0.45f0 bh))))
              (declare (single-float ym))
              (paint-clip! fx0 by fx1 ym by ym end) (paint-poly pts 6 +c-white+ +c-paper+)
              (paint-clip! fx0 ym fx1 (+ by bh) ym (+ by bh) end) (paint-poly pts 6 +c-paper+ +c-fill-lo+))))
      ;; the grid: 1 px every 23 CSS px from 9 px, fixed to the bar (DEVLOG §618), only where the fill is: one striped polygon
      (paint-clip! fx0 by fx1 (+ by bh))
      (paint-stripes! (if mir (- (+ bx bw) (* 9f0 dpr)) (+ bx (* 9f0 dpr))) by (if mir -1f0 1f0) 0f0 (* 23f0 dpr) dpr)
      (paint-poly pts 6 +c-grid+ +c-grid+)
      (paint-pattern-off!))
    (with-col (c +c-bar-line+) (col-alpha! c lna)              ; the inset 1 px line, clipped by the polygon (none on the slanted ends)
      (paint-clip! bx by (+ bx bw) (+ by dpr)) (paint-poly pts 6 c c)
      (paint-clip! bx (- (+ by bh) dpr) (+ bx bw) (+ by bh)) (paint-poly pts 6 c c)
      (paint-clip! bx (+ by dpr) (+ bx dpr) (- (+ by bh) dpr)) (paint-poly pts 6 c c)
      (paint-clip! (- (+ bx bw) dpr) (+ by dpr) (+ bx bw) (- (+ by bh) dpr)) (paint-poly pts 6 c c))
    nil))

(defparameter *lhud-flame*                                 ; hd-flame: none -> scaleY(1.1) skewX(-5deg) at 30 % -> scaleY(.94) skewX(4deg) at 62 %
  (vector (make-tween '((0 nil 1 0) (0.3 nil 1.1 -5) (0.62 nil 0.94 4) (1 nil 1 0)) :dur 1.6 :iter -1 :curve +ease-in-out+)
          (make-tween '((0 nil 1 0) (0.3 nil 1.1 -5) (0.62 nil 0.94 4) (1 nil 1 0)) :dur 1.9 :delay -0.7 :iter -1 :curve +ease-in-out+)
          (make-tween '((0 nil 1 0) (0.3 nil 1.1 -5) (0.62 nil 0.94 4) (1 nil 1 0)) :dur 1.35 :delay -1.1 :iter -1 :curve +ease-in-out+))
  "hd-flame by nth-child: 3n+1 1.6 s, 3n+2 1.9 s from -.7 s, 3n 1.35 s from -1.1 s (ease-in-out, infinite).")
(defparameter *lhud-shatter* (make-tween '((0 nil 1.8 12 1) (1 nil 1 0 0)) :dur 0.5 :curve +ease-out+ :base '(1 0 0))
  "hd-shatter: scale(1.8) rotate(12deg) and a blood drop-shadow -> none, .5 s ease-out (the third value: the glow).")
(defparameter *lhud-stake* (make-tween '((0 nil 0) (0.5 nil -0.18) (1 nil 0)) :dur 1.4 :iter -1 :curve +ease-in-out+)
  "hd-stake: translateY(-.18u) at 50 %, 1.4 s ease-in-out, while the plate is low (red).")
(declaim (type simple-vector *lhud-flame*) (type f32vec *lhud-shatter* *lhud-stake*))
(defparameter +c-dot+ (rgba #x767d8e)) (defparameter +c-glow+ (rgba #xe81e3a 0.7))

(defun-fast lhud-souls (side mir)
  "The nine soul flames (.souls, .soul): 1.05 x 1.45u each, .38u apart, from the start edge (MIR: row-reverse, from the right).
*LHUD-A*: x (the start edge: the left, or the right when MIR), y (the row's top), u. hud.js SOUL in its 10 x 14 viewBox (meet),
paper with an ink stroke 1.2, at stake a blood stroke 2.4 (bobbing while low), spent: faded to a stone dot."
  (declare (fixnum side))
  (let* ((a *lhud-a*) (x0 (aref a 0)) (y0 (aref a 1)) (u (aref a 2)) (now (aref *ui-clock* 0)) (o (side-o side))
         (kon (max 0 (hv (+ o 3)))) (stake (max 0 (hv (+ o 4)))) (low (= 1 (hv (+ o 2)))) (trs *lhud-tr*) (pl *lhud-pl*)
         (sw (* 1.05f0 u)) (sh (* 1.45f0 u)) (s (f-min (/ sw 10f0) (/ sh 14f0))) (gz (* 14f0 s))
         (du (/ (aref *glyph-dscale* 0) 14f0)))           ; (SDF units per viewBox unit: the flame's em is its 14-unit height)
    (declare (single-float x0 y0 u now sw sh s gz du) (fixnum o kon stake) (type f32vec a trs pl))
    (dotimes (i 9)
      (let* ((bx (if mir (- x0 (* (i->f (1+ i)) sw) (* (i->f i) 0.38f0 u)) (+ x0 (* (i->f i) (+ sw (* 0.38f0 u))))))
             (at (and (< i kon) (>= i (- kon stake)))) (op (trans-value trs (tr side (+ 2 i)) now))
             (dot (trans-value trs (tr side (+ 11 i)) now))
             (bob (if (and low at) (* u (twv *lhud-stake* (aref pl (+ (* 12 side) 9)) now 0)) 0f0))
             (shs (aref pl (+ (* 12 side) i))) (sc (twv *lhud-shatter* shs now 0))
             (rot (* 0.017453f0 (twv *lhud-shatter* shs now 1))) (glow (twv *lhud-shatter* shs now 2))
             (cx (+ bx (* 0.5f0 sw))) (cy (+ y0 (* 0.5f0 sh))))
        (declare (single-float bx op dot bob shs sc rot glow cx cy))
        (when (> dot 0.002f0)                             ; .soul::after: .38u, centred, its bottom at 16 %
          (with-col (c +c-dot+) (col-alpha! c dot)
            (paint-ellipse! cx (- (+ y0 (* 0.84f0 sh)) (* 0.19f0 u)) (* 0.19f0 u) (* 0.19f0 u) c)))
        (when (> op 0.002f0)
          (let* ((k (twv (svref *lhud-flame* (mod i 3)) 0f0 now 0))
                (sk (* 0.017453f0 (twv (svref *lhud-flame* (mod i 3)) 0f0 now 1))))
            (declare (single-float k sk))
            (paint-push)
            (paint-transform! cx cy :sx sc :sy sc :rot rot :dy bob)   ; the span: shatter about its centre, the stake's bob
            (when (> glow 0.01f0)                         ; (the drop-shadow's blood glow, as a feathered disc)
              (with-col (c +c-glow+) (col-alpha! c (* 0.7f0 glow))
                (paint-ellipse! cx (+ y0 (* 0.6f0 sh)) (* 0.55f0 sw) (* 0.45f0 sh) c :feather (* 6f0 (lay-dpr)))))
            (paint-transform! cx (+ y0 (* 0.92f0 sh)) :sy k :skew (/ (f-sin sk) (f-cos sk)))   ; the svg: hd-flame about 50 % 92 %
            (paint-opacity! op)
            ;; the flame is a baked SDF glyph (tools/sdf-bake.py SHAPES, U+E000; its em the viewBox's 14 units, the baseline at the
            ;; bottom): the paper fill at the path, then the stroke as an outline band centred on it (1.2 units; at stake 2.4, blood).
            ;; Two quads a flame where the polygon fill and its round-capped stroke took 135 vertices (DUEL_LISP_HUD §14)
            (let* ((gx (+ bx (* 0.5f0 (- sw (* 10f0 s))))) (gy (+ y0 gz)) (hw (* du (if at 1.2f0 0.6f0))))
              (declare (single-float gx gy hw))
              (paint-pen! gx gy gz) (paint-text +soul-glyph+ +f-sans+ +c-paper+)
              (paint-pen! gx gy gz :edge (- 0.5f0 hw) :outline (* 2f0 hw)) (paint-text +soul-glyph+ +f-sans+ (if at +c-blood+ +c-ink+)))
            (paint-pop)))))
    nil))

(defparameter +c-reserve+ (rgba #xbcc1cc 0.3)) (defparameter +c-reserve-tick+ (rgba #xeeeeea 0.6))   ; the SP reserve (dim steel on the cell), the price tick
(defparameter +c-cell+ (rgba #x2c303d)) (defparameter +c-pink+ (rgba #xff7ab8)) (defparameter +c-drive+ (rgba #xe0353b))
(defparameter +c-redlab+ (rgba #xff4b5c))

(defun-fast lhud-meters (side mir)
  "The flash step's three cells and the awakening bar (.meters: grid 3fr 2fr auto, gap .7u, rtl for MIR; .42u tall), the awakening's
label beside them (.awk). *LHUD-A*: x (the meters' left), y (top), w (their width: 64 % of the plate), u."
  (declare (fixnum side))
  (let* ((a *lhud-a*) (x (aref a 0)) (y (aref a 1)) (w (aref a 2)) (u (aref a 3)) (now (aref *ui-clock* 0)) (o (side-o side))
         (trs *lhud-tr*) (h (* 0.42f0 u)) (gap (* 0.7f0 u)) (free (- w (* 2f0 gap))) (fw (* 0.6f0 free)) (aw (* 0.4f0 free))
         (fsx (if mir (- (+ x w) fw) x)) (awx (if mir (- fsx gap aw) (+ x fw gap))) (cw (/ (- fw (* 0.44f0 u)) 3f0))
         (m (hv (+ o 23))) (full (or (>= (hv (+ o 8)) 1) (= m 3)))
         (lo (if (> (hv (+ o 25)) 0) (* 0.003f0 (i->f (- (max 0 (hv (+ o 6))) (hv (+ o 25))))) 3f0)))   ; (the burning span's lower end, in cells; no burn: above every fill, so nothing tints)
    (declare (single-float x y w u now h gap free fw aw fsx awx cw lo) (fixnum o m) (type f32vec a trs))
    (dotimes (i 3)                                         ; (the first cell at the start: rtl puts it at the right)
      (let* ((k (trans-value trs (tr side (+ 20 i)) now))
             (cx (if mir (- (+ fsx fw) (* (i->f (1+ i)) cw) (* (i->f i) 0.22f0 u)) (+ fsx (* (i->f i) (+ cw (* 0.22f0 u)))))))
        (declare (single-float k cx))
        (paint-rect cx y cw h +c-cell+)
        (let* ((kt (trans-value trs (tr side (+ 30 i)) now)))   ; the SP reserve: dim ink from the lit end to the total
          (declare (single-float kt))
          (when (> (- kt k) 0.002f0) (paint-rect (if mir (+ cx (* cw (- 1f0 kt))) (+ cx (* cw k))) y (* cw (- kt k)) h +c-reserve+)))
        (when (> k 0.001f0) (paint-rect (if mir (+ cx (* cw (- 1f0 k))) cx) y (* cw k) h +c-steel+))
        (let* ((a (lhud-cell-burn lo i k)))                ; a BLUE burst: the span still to burn, in the burst's blue
          (declare (single-float a))
          (when (> (- k a) 0.001f0) (paint-rect (if mir (+ cx (* cw (- 1f0 k))) (+ cx (* cw a))) y (* cw (- k a)) h +c-burst-b+)))))
    (let* ((c (* 0.003f0 (i->f (max 0 (hv (+ o 27)))))) (ci (cond ((<= c 1f0) 0) ((<= c 2f0) 1) (t 2))) (fl (f-max 0f0 (- 1f0 (/ (- now (aref *lhud-pl* (+ (* 12 side) 10))) 0.4f0)))))
      (declare (single-float c fl) (fixnum ci))
      (when (> c 0.01f0)                                   ; the next NSa's price: a tick on the cell it falls in (full damage above it)
        (let* ((f (- c (i->f ci))) (cx (if mir (- (+ fsx fw) (* (i->f (1+ ci)) cw) (* (i->f ci) 0.22f0 u)) (+ fsx (* (i->f ci) (+ cw (* 0.22f0 u))))))
               (tw (* 1.5f0 (lay-dpr))) (tx (- (if mir (+ cx (* cw (- 1f0 f))) (+ cx (* cw f))) (* 0.5f0 tw))))
          (declare (single-float f cx tw tx))
          (paint-rect tx (- y (* 0.12f0 u)) tw (+ h (* 0.24f0 u)) +c-reserve-tick+)))
      (when (> fl 0.01f0)                                  ; a refused SP press (hd-deny's cousin): the cells flash blood and fade
        (with-col (cc +c-blood+) (col-alpha! cc (* 0.6f0 fl))
          (dotimes (i 3)
            (paint-rect (if mir (- (+ fsx fw) (* (i->f (1+ i)) cw) (* (i->f i) 0.22f0 u)) (+ fsx (* (i->f i) (+ cw (* 0.22f0 u))))) y cw h cc)))))
    (paint-rect awx y aw h +c-cell+)
    (let* ((k (trans-value trs (tr side 23) now)) (sb (trans-value trs (tr side 24) now))
          (pulse (if full (- 0.5f0 (* 0.5f0 (f-cos (* 6.2832f0 now)))) 0f0)) (col (if (>= m 2) +c-drive+ +c-reiatsu+)))
      (declare (single-float k sb pulse))
      (when (and full (> k 0.02f0))                        ; hd-aw: brightness 1.5 at 50 %, the glow (box-shadow .8u, scaled with the bar)
        (with-col (c col) (col-alpha! c 0.55f0)
          (paint-box! (if mir (+ awx (* aw (- 1f0 (* 0.5f0 k)))) (+ awx (* 0.5f0 aw k))) (+ y (* 0.5f0 h)) (* 0.5f0 aw k) (* 0.5f0 h)
                      0f0 (* 0.8f0 u) 0f0 c)))
      (when (> k 0.001f0)
        (paint-rect (if mir (+ awx (* aw (- 1f0 k))) awx) y (* aw k) h (if full (col-mix! *lhud-mix* col +c-white+ (* 0.35f0 pulse)) col)))
      (when (and (= m 1) (> sb 0.001f0)) (paint-rect (if mir (+ awx (* aw (- 1f0 sb))) awx) y (* aw sb) h +c-pink+)))
    (let* ((op (trans-value trs (tr side 25) now)))        ; the label: absolute after the meters (inset-inline-start: 100% + .7u)
      (declare (single-float op))
      (when (> op 0.002f0)
        (let* ((s (case m (1 "SUBLIMATION") (2 "SPIRIT DRIVE") (3 "DRIVE MAX") (t (zh "覺醒 READY")))) (sz (* 0.8f0 u))
               (lx (+ x w gap))   ; (left: 100%, also for rtl P2, as Chrome resolves it: off the plate to the right)
               (by (+ (- (+ y (* 0.5f0 h)) (* 0.5f0 sz)) (line-baseline +f-display+ sz 1f0))))
          (declare (single-float sz lx by))
          (with-col (c (case m (1 +c-pink+) ((2 3) +c-redlab+) (t +c-reiatsu+))) (col-alpha! c op)
            (paint-pen! (f-floor+ lx) (f-floor+ by) sz :spacing 0.2f0 :edge 0.47f0) (paint-text s +f-display+ c)))))
    nil))

(defparameter +c-seal-line+ (rgba #x4a4f5e)) (defparameter +c-seal-bg+ (rgba #x0b0b10 0.42))

(defun-fast lhud-seal (glyph lock bg)
  "One pointer seal (.seal: a 1 px #4a4f5e border, the glyph .59 of the box in the Mincho, stone; on: paper, the glyph ink). *LHUD-A*:
the centre x y, the size, the on-ness (0..1, its .25 s transition). LOCK: a sealed pointer (opacity .35, a dashed border). BG: a background colour (the stance ring's rgba(11,11,16,.42)) or NIL. The caller sets the transform (rotate / scale on)."
  (let* ((a *lhud-a*) (cx (aref a 0)) (cy (aref a 1)) (sz (aref a 2)) (on (aref a 3)) (dpr (lay-dpr)) (hs (* 0.5f0 sz)) (fz (* 0.5909f0 sz)))
    (declare (single-float cx cy sz on dpr hs fz) (type f32vec a))
    (paint-push)
    (when lock (paint-opacity! 0.35f0))
    (when bg (paint-box! cx cy hs hs 0f0 1f0 0f0 bg))
    (when (> on 0.001f0) (with-col (c +c-paper+) (col-alpha! c on) (paint-box! cx cy hs hs 0f0 1f0 0f0 c)))
    (let* ((col (col-mix! *lhud-mix* +c-seal-line+ +c-paper+ on)))   ; the 1 px border (sealed: dashed, 3 px dashes and gaps)
      (if lock
          (let* ((x0 (- cx hs)) (y0 (- cy hs)) (s (* 2f0 hs)) (dl (* 3f0 dpr)))
            (declare (single-float x0 y0 s dl))
            (paint-stripes! x0 y0 1f0 0f0 (* 2f0 dl) dl) (paint-rect x0 y0 s dpr col) (paint-rect x0 (- (+ y0 s) dpr) s dpr col)
            (paint-stripes! x0 y0 0f0 1f0 (* 2f0 dl) dl) (paint-rect x0 y0 dpr s col) (paint-rect (- (+ x0 s) dpr) y0 dpr s col)
            (paint-pattern-off!))
          (paint-box! cx cy (- hs (* 0.5f0 dpr)) (- hs (* 0.5f0 dpr)) 0f0 1f0 dpr col)))
    (paint-pen! 0f0 0f0 fz) (paint-measure glyph +f-kanji+)
    (let* ((gw (aref *paint-pen* 7)))
      (declare (single-float gw))
      (paint-pen! (- cx (* 0.5f0 gw)) (+ (- cy (* 0.5f0 fz)) (line-baseline +f-kanji+ fz 1f0)) fz)
      (paint-text glyph +f-kanji+ (col-mix! *lhud-mix* +c-stone+ +c-ink+ on)))
    (paint-pop)
    nil))

(defun-fast lhud-seal-row (side mir)
  "The pointer seals in a row (.hptr: gap .35u, MIR row-reverse) and the live one's name (.pn .7u mono, .16em, margin-inline .5u).
*LHUD-A*: x (the start edge: left, or right when MIR), the row's centre y, the seal's size, u."
  (declare (fixnum side))
  (let* ((a *lhud-a*) (x0 (aref a 0)) (cy (aref a 1)) (sz (aref a 2)) (u (aref a 3)) (now (aref *ui-clock* 0)) (o (side-o side))
         (n (hv (+ o 9))) (seals (side-c side 5)) (ns (min 4 (length seals))) (x x0))
    (declare (single-float x0 cy sz u now x) (fixnum o n ns) (type f32vec a))
    (when (> n 0)
      (dotimes (i ns)
        (let* ((sl (nth i seals)) (on (trans-value *lhud-tr* (tr side (+ 26 i)) now)) (cx (if mir (- x (* 0.5f0 sz)) (+ x (* 0.5f0 sz)))))
          (declare (single-float on cx))
          (paint-push)
          (when (> on 0.001f0) (paint-transform! cx cy :rot (* -0.069813f0 on) :sx (+ 1f0 (* 0.08f0 on)) :sy (+ 1f0 (* 0.08f0 on))))
          (lane! cx cy sz on) (lhud-seal (first sl) (logbitp i (hv (+ o 24))) nil)
          (paint-pop)
          (setf x (if mir (- x sz (* 0.35f0 u)) (+ x sz (* 0.35f0 u))))))
      (let* ((name (second (nth (1- (min n ns)) seals))) (pz (* 0.7f0 u)) (pw (text-w name +f-mono+ pz 0.16f0))
             (px (if mir (- x (* 0.5f0 u) pw) (+ x (* 0.5f0 u)))))
        (declare (single-float pz pw px))
        (paint-pen! (f-floor+ px) (f-floor+ (+ (- cy (* 0.5f0 pz)) (line-baseline +f-mono+ pz 1f0))) pz :spacing 0.16f0)
        (paint-text name +f-mono+ +c-steel+)))
    nil))

(defparameter +c-pip+ (rgba #x0d0d12)) (defparameter +c-pip-line+ (rgba #xeeeeea 0.8))
(defparameter +c-kai0+ (rgba #xffe97a)) (defparameter +c-kai2+ (rgba #xe0a21a))
(defparameter +c-ude0+ (rgba #xff4b63)) (defparameter +c-ude2+ (rgba #x8d0f20))

(defun-fast lhud-kit (side mir)
  "Kenpachi's kit strip (.kit, DUEL_WEBUI §13): KAIHO (解, three pips, L n / MAX) or UDE (腕, four claw pips), gap .7u, MIR rtl (from
the right). *LHUD-A*: x (the start edge), the strip's centre y, u. (NOME's cups went with the cups, DUEL_KEN_V3 §8: not drawn.)"
  (declare (fixnum side))
  (let* ((a *lhud-a*) (x0 (aref a 0)) (cy (aref a 1)) (u (aref a 2)) (now (aref *ui-clock* 0)) (o (side-o side))
         (kind (side-c side 8)) (v (max 0 (hv (+ o 15)))) (mx (max 1 (hv (+ o 16)))) (top (>= v mx)) (pts *lhud-pts*)
         (dir (if mir -1f0 1f0)) (x x0) (kz (* 1.15f0 u)) (pw (* 2.4f0 u)) (ph (* 1.5f0 u)))
    (declare (single-float x0 cy u now dir x kz pw ph) (fixnum o kind v mx) (type f32vec a pts))
    (when (member kind '(2 3))
      (let* ((kn (if (= kind 3) (kj "解") (kj "腕"))) (kw (text-w kn +f-kanji+ kz)) (by (+ (- cy (* 0.5f0 kz)) (line-baseline +f-kanji+ kz 1f0)))
             (pulse (if (and (= kind 3) top) (- 0.5f0 (* 0.5f0 (f-cos (* 7.854f0 now)))) 0f0)))   ; hd-pulse .8s on MAX
        (declare (single-float kw by pulse))
        (paint-pen! (f-floor+ (if mir (- x kw) x)) (+ (f-floor+ by) (lay-dpr)) kz) (paint-text kn +f-kanji+ +c-shade+)
        (paint-pen! (f-floor+ (if mir (- x kw) x)) (f-floor+ by) kz) (paint-text kn +f-kanji+ (if (= kind 3) +c-reiatsu+ +c-blood+))
        (setf x (+ x (* dir (+ kw (* 0.7f0 u)))))
        (dotimes (i (if (= kind 3) 3 4))                   ; .pp: polygon(24% 0, 100% 0, 76% 100%, 0 100%)
          (let* ((px (if mir (- x pw) x)) (py (- cy (* 0.5f0 ph))) (lit (< i (if (= kind 3) (min v 3) (min v 4)))))
            (declare (single-float px py))
            (setf (aref pts 0) (+ px (* 0.24f0 pw)) (aref pts 1) py (aref pts 2) (+ px pw) (aref pts 3) py
                  (aref pts 4) (+ px (* 0.76f0 pw)) (aref pts 5) (+ py ph) (aref pts 6) px (aref pts 7) (+ py ph))
            (if lit
                (let* ((c0 (if (= kind 3) +c-kai0+ +c-ude0+)) (c1 (if (= kind 3) +c-reiatsu+ +c-blood+)) (c2 (if (= kind 3) +c-kai2+ +c-ude2+))
                      (ym (+ py (* 0.6f0 ph))))
                  (declare (single-float ym))
                  (paint-clip! px py (+ px pw) ym py ym) (paint-poly pts 4 (col-mix! *lhud-mix* c0 +c-white+ (* 0.3f0 pulse)) c1)
                  (paint-clip! px ym (+ px pw) (+ py ph) ym (+ py ph)) (paint-poly pts 4 c1 c2))
                (progn (paint-clip! px py (+ px pw) (+ py ph)) (paint-poly pts 4 +c-pip+ +c-pip+)
                       (let* ((lx (+ px (* 0.52f0 pw))) (ly0 (+ py (* 0.12f0 ph))) (ly1 (+ py (* 0.9f0 ph))) (k 0.4452f0))   ; the claw line, skewX(-24deg)
                         (declare (single-float lx ly0 ly1 k))
                         (setf (aref pts 8) (+ lx (* k (* 0.39f0 ph))) (aref pts 9) ly0 (aref pts 10) (- lx (* k (* 0.39f0 ph))) (aref pts 11) ly1)
                         (paint-stroke! (subseq-f32 pts 8) 2 (lay-dpr) +c-pip-line+))))
            (setf x (+ x (* dir (+ pw (* 0.45f0 u)))))))
        (when (= kind 3)                                   ; .kv: .8u mono, min-width 2.4em, centred
          (let* ((s (if top "MAX" (svref *lhud-lv* (min v 9)))) (vz (* 0.8f0 u)) (vw (text-w s +f-mono+ vz)) (bw (f-max vw (* 2.4f0 vz)))
                 (bx (+ (if mir (- x (* 0.7f0 u) bw) (+ x (* -0.45f0 u) (* 0.7f0 u))) (* 0.5f0 (- bw vw)))))
            (declare (single-float vz vw bw bx))
            (paint-pen! (f-floor+ bx) (f-floor+ (+ (- cy (* 0.5f0 vz)) (line-baseline +f-mono+ vz 1f0))) vz)
            (paint-text s +f-mono+ (col-mix! *lhud-mix* +c-reiatsu+ +c-white+ (* 0.3f0 pulse)))))))
    nil))

;;; ---------------------------------------------------------------- the plate: the opponent's at the top (phone), both on a desktop
(defparameter *lhud-pool* (let* ((v (make-f32 15)))           ; hud.css .hphone .plate::before: .62 at 0, .32 at 60 %, 0 at 100 %
                            (replace v '(0f0 0.043f0 0.043f0 0.063f0 0.62f0  0.6f0 0.043f0 0.043f0 0.063f0 0.32f0  1f0 0.043f0 0.043f0 0.063f0 0f0)) v))
(declaim (type f32vec *lhud-pool*))

(defun-fast lhud-plate (side)
  "Side SIDE's plate in its grid (hud.css .plate: rows .who, .rrow, .srow, .meters, .hptr, gap .55u; P2 justify-items end): the
phone's P2 (3.8u + safe top, 2.2u from the right, 27u wide with the deck, else 30u), the phone's P1 without the deck (over the bottom,
4 % + 2u), or a desktop plate (36u, max(2.4u, st + 1u), max(2.6u, inset + 1u))."
  (declare (fixnum side))
  (let* ((u (lay-u 1f0)) (w (lay-w)) (h (lay-h)) (st (lay-inset 0)) (phone (lay-portrait-p)) (deck (hv-deck-p)) (o (side-o side))
         (left-p1 (and phone deck (hv-left-p) (= side 0))) (mir (or (= side 1) left-p1))
         (pw (* u (cond ((not phone) 36f0) ((and deck (= side 1)) 27f0) (t 30f0))))
         (sealz (if phone (* 2.2f0 u) (* 1.75f0 u))) (n (hv (+ o 9))) (kind (side-c side 8))
         (whoh (row-h (+f-display+ (* 2.3f0 u) 0.9f0) (+f-kanji+ (* 1.25f0 u) 1f0) (+f-mono+ (* 0.72f0 u) 1f0)))
         (srowh (if (member kind '(2 3)) (* 1.5f0 u) (* 1.45f0 u)))
         (ph (+ whoh (* 0.55f0 u) (* 1.55f0 u) (* 0.55f0 u) srowh (* 0.55f0 u) (* 0.42f0 u) (if (> n 0) (+ (* 0.55f0 u) (* 0.25f0 u) sealz) 0f0)))
         (top (cond ((not phone) (f-max (* 2.4f0 u) (+ st u)))
                    ((= side 1) (+ (* 3.8f0 u) st))
                    (t (- (lhud-deck-bottom h (hv 31) nil) (* 2f0 u) ph))))
         (left (cond ((= side 1) (- w (if phone (* 2.2f0 u) (f-max (* 2.6f0 u) (+ (lay-inset 3) u))) pw))
                     (phone (* 2.2f0 u))
                     (t (f-max (* 2.6f0 u) (+ (lay-inset 2) u)))))
         (y top))
    (declare (single-float u w h st pw sealz whoh srowh ph top left y) (fixnum o n kind))
    (paint-reset)
    (paint-opacity! (layer-op 0))                           ; (.hudl: out in a cinematic, .3 paused)
    (when phone                                            ; the ink pool (::before, inset -1.6u -2.2u, farthest-side at 35 % / 65 %)
      (let* ((bx (- left (* 2.2f0 u))) (bw (+ pw (* 4.4f0 u))) (by (- top (* 1.6f0 u))) (bh (+ ph (* 3.2f0 u)))
             (cx (+ bx (* (if mir 0.65f0 0.35f0) bw))))
        (declare (single-float bx bw by bh cx))
        (paint-radial! cx (+ by (* 0.5f0 bh)) (* 0.65f0 bw) (* 0.5f0 bh) *lhud-pool* 3)))
    (lane! left y pw (* 2.3f0 u) (* 1.25f0 u) (* 0.72f0 u) u) (lhud-name-row side mir t)
    (setf y (+ y whoh (* 0.55f0 u)))
    (lane! left y pw (* 1.55f0 u) 0.48f0 0.12f0) (lhud-bar side mir nil)
    (setf y (+ y (* 1.55f0 u) (* 0.55f0 u)))
    (lane! (if mir (+ left pw) left) (+ y (* 0.5f0 (- srowh (* 1.45f0 u)))) u) (lhud-souls side mir)
    (when (member kind '(2 3))                             ; the kit strip beside the souls (flex: 1, gap 1u)
      (let* ((sw (+ (* 9f0 1.05f0 u) (* 8f0 0.38f0 u) u)))
        (declare (single-float sw))
        (lane! (if mir (- (+ left pw) sw) (+ left sw)) (+ y (* 0.5f0 srowh)) u) (lhud-kit side mir)))
    (setf y (+ y srowh (* 0.55f0 u)))
    (lane! (if mir (- (+ left pw) (* 0.64f0 pw)) left) y (* 0.64f0 pw) u) (lhud-meters side mir)
    (setf y (+ y (* 0.42f0 u) (* 0.55f0 u) (* 0.25f0 u)))
    (when (> n 0) (lane! (if mir (+ left pw) left) (+ y (* 0.5f0 sealz)) sealz u) (lhud-seal-row side mir))
    (paint-reset)
    nil))

;;; ---------------------------------------------------------------- your plate on the deck's line (the phone, draft C 界)
(defun-fast lhud-plate-line ()
  "P1's plate lying on the deck's SP / ATK line (hud.css #hud.hphone:not(.nodeck) .plate.p1, hud.js renderDeck): rotated about the
line's far point, the bar (1.3u) centred on the line from 1.4u to the length - 1.4u, the flames (from .4u) and the name row (1.75u /
1u kanji, the tag .3u after) above it, bottom-aligned .55u over the bar; the left hand mirrors it (the far point at the right)."
  (let* ((u (lay-u 1f0)) (g *lhud-g*) (left (hv-left-p)))
    (declare (single-float u) (type f32vec g))
    (lhud-deck-line! g (lay-w) (lay-h) (hv 30) (hv 31) (hv 32) (hv 33) (hv 34) (hv 35) left)
    (let* ((len (aref g 2)) (x0 (if left (- len) 0f0)) (pad (* 1.4f0 u))
           (whoh (row-h (+f-display+ (* 1.75f0 u) 0.8f0) (+f-kanji+ u 1f0) (+f-mono+ (* 0.72f0 u) 1f0)))
           (sw (+ (* 9f0 1.05f0 u) (* 8f0 0.38f0 u))) (rb (* -1.2f0 u)))   ; the first row's bottom: .65u + .55u above the line
      (declare (single-float len x0 pad whoh sw rb))
      (paint-reset)
      (paint-opacity! (layer-op 0))
      (paint-transform! 0f0 0f0 :rot (aref g 3) :dx (aref g 0) :dy (aref g 1))
      (lane! (+ x0 pad) (* -0.65f0 u) (- len (* 2f0 pad)) (* 1.3f0 u) 0.55f0 0.42f0) (lhud-bar 0 left nil)
      (lane! (if left (- (+ x0 len) pad (* 0.4f0 u)) (+ x0 pad (* 0.4f0 u))) (- rb (* 1.45f0 u)) u) (lhud-souls 0 left)
      (let* ((wx (if left (+ x0 pad) (+ x0 pad (* 0.4f0 u) sw (* 1.1f0 u)))) (ww (- len (* 2f0 pad) (* 0.4f0 u) sw (* 1.1f0 u))))
        (declare (single-float wx ww))
        (lane! wx (- rb whoh) ww (* 1.75f0 u) u (* 0.72f0 u) u) (lhud-name-row 0 left nil))
      (when (member (side-c 0 8) '(2 3))                   ; the kit strip hung under the bar (top 100% + .35u, from 1.4u)
        (lane! (if left (+ x0 (* 0.5f0 len)) (+ x0 pad)) (+ (* 0.65f0 u) (* 0.35f0 u) (* 0.75f0 u)) u) (lhud-kit 0 left))
      (paint-reset))
    nil))
