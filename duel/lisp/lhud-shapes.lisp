;;;; lhud-shapes.lisp — debug 2509's test card for the paint stream's shapes (phase 1b, DUEL_LISP_HUD §10): one of
;;;; each primitive the handheld battle screen needs, in a grid of cells, drawn over the scene in any renderer (the atlas is made at
;;;; load either way). Not a HUD element; cosmetic; 0 B a frame (debug 2519's `shapes` entry).
(in-package :duel)

(defvar *lhud-shapes* nil "Debug 2509 cycles it: NIL, T the shapes card, :BACK the card on a transparent frame (its back layer shows where
the sky was: *RENDER-TRANSPARENT* drops the sky, the stage stays).")

(defparameter +soul-path+ "M5 .6C6.4 3 9.2 5.4 9.2 8.6A4.2 4.2 0 0 1 .8 8.6C.8 6.6 2.2 5.2 3 3.6 3.4 5 4 5.6 4.8 5.8 4.4 4 4.6 2.2 5 .6z"
  "hud.js SOUL: the soul flame, viewBox 0 0 10 14.")
(defparameter +inf-path+ "M33 16 C26 5 9 3 6 14 C3 25 22 29 33 16 C44 3 63 6 60 17 C57 27 40 27 33 16"
  "hud.js INF: the practice clock's infinity, viewBox 0 0 66 32 (a stroke).")
(defun closed-points (v)
  "The f32vec V of points with its first point appended (a closed outline for PAINT-STROKE!)."
  (let ((o (make-f32 (+ 2 (length v))))) (replace o v) (setf (aref o (length v)) (aref v 0) (aref o (1+ (length v))) (aref v 1)) o))

(declaim (type f32vec *sh-flame* *sh-flame-o* *sh-inf* *sh-pool* *sh-pts* *sh-line*))
(defvar *sh-flame* (path-points +soul-path+ :segs 5) "The soul flame's outline (fill).")
(defvar *sh-flame-o* (closed-points *sh-flame*) "The same, closed (its stroke).")
(defvar *sh-inf* (path-points +inf-path+ :segs 8) "The infinity's stroke.")
(defvar *sh-pool* (let ((v (make-f32 15)))                ; hud.css's phone ink pool: .62 at 0, .32 at 60 %, 0 at 100 %
                    (replace v '(0f0 0.043f0 0.043f0 0.063f0 0.62f0  0.6f0 0.043f0 0.043f0 0.063f0 0.32f0  1f0 0.043f0 0.043f0 0.063f0 0f0)) v))
(defvar *sh-pts* (make-f32 16) "Polygon scratch.")
(defvar *sh-line* (make-f32 8) "Polyline scratch.")
(defparameter +sh-paper+ (rgba #xeeeeea)) (defparameter +sh-ink+ (rgba #x0b0b10)) (defparameter +sh-blood+ (rgba #xe81e3a))
(defparameter +sh-night+ (rgba #x161922)) (defparameter +sh-steel+ (rgba #xbcc1cc)) (defparameter +sh-stone+ (rgba #x767d8e))
(defparameter +sh-white+ (rgba #xffffff)) (defparameter +sh-lo+ (rgba #xc9cbcf)) (defparameter +sh-grid+ (rgba #x0b0b10 0.25))
(defparameter +sh-glow+ (rgba #xe81e3a 0.55)) (defparameter +sh-dot+ (rgba #xbcc1cc 0.0)) (defparameter +sh-dot1+ (rgba #xbcc1cc 0.6))
(defparameter +sh-panel+ (rgba #x2c303d 0.85)) (defparameter +sh-rim+ (rgba #xeeeeea 0.55)) (defparameter +sh-rvrim+ (rgba #xe81e3a 0.4))
(defparameter +sh-back+ (rgba #x5d6474)) (defparameter +sh-shadow+ (rgba #x0b0b10 0.7)) (defparameter +sh-chip+ (rgba #x0b0b10 0.8))
(defparameter +sh-bg0+ (rgba #x0b0b10 0.85)) (defparameter +sh-bg1+ (rgba #x161922 0.85))

(defmacro sh-label (x y s txt)
  "A cell's caption: mono, S px (9 CSS px, less in a narrow cell)."
  `(progn (paint-pen! (f-floor+ ,x) (f-floor+ ,y) ,s :spacing 0.12f0) (paint-text ,txt 1 +sh-steel+)))

(defun-fast lhud-shapes-card ()
  "Debug 2509's card: twelve cells (4 x 3 landscape, 3 x 4 portrait), each one primitive or a mock of a handheld-screen part."
  (let* ((w (i->f (window-width))) (h (i->f (window-height))) (dpr (ffi:c-inline () () :float "pf_density()" :one-liner t))
         (land (> w h)) (cols (if land 4 3)) (rows (if land 3 4)) (cw (/ w (i->f cols))) (ch (/ (* 0.94f0 h) (i->f rows)))
         (s (* 0.42f0 (f-min cw ch))) (lsz (f-min (* 9f0 dpr) (/ cw 26f0))) (now (aref *ui-clock* 0)) (pts *sh-pts*) (ln *sh-line*))
    (declare (single-float w h dpr cw ch s lsz now) (fixnum cols rows) (type f32vec pts ln))
    (paint-reset)
    (paint-rect 0f0 0f0 w h +sh-bg0+ +sh-bg1+)
    (dotimes (cell 12)
      (let* ((cx (* cw (+ 0.5f0 (i->f (mod cell cols))))) (cy (+ (* 0.06f0 h) (* ch (+ 0.5f0 (i->f (floor cell cols))))))
             (lx (- cx (* 0.95f0 s))) (ly (+ cy (* 1.05f0 s))))
        (declare (single-float cx cy lx ly))
        (paint-reset)
        (macrolet ((pt (i x y) `(setf (aref pts ,(* 2 i)) ,x (aref pts ,(1+ (* 2 i))) ,y)))
          (case cell
            (0 ;; the Reishi bar, rotated -8 deg: AA ends, a 3-stop fill with an AA moving end and no seam, the grid as stripes
             (let* ((bw (* 1.8f0 s)) (bh (* 0.22f0 s)) (bx (- cx (* 0.5f0 bw))) (by (- cy (* 0.5f0 bh))) (r 0.7f0)
                    (fx1 (+ bx (* r bw))) (ym (+ by (* 0.45f0 bh))))
               (declare (single-float bw bh bx by r fx1 ym))
               (paint-transform! cx cy :rot -0.1396f0)
               (pt 0 bx (+ by (* 0.18f0 bh))) (pt 1 (+ bx (* 0.03f0 bw)) by) (pt 2 (+ bx bw) by)
               (pt 3 (+ bx (* 0.986f0 bw)) (+ by bh)) (pt 4 (+ bx (* 0.012f0 bw)) (+ by bh)) (pt 5 bx (+ by (* 0.78f0 bh)))
               (paint-clip! bx by (+ bx bw) (+ by bh)) (paint-poly pts 6 +sh-panel+ +sh-panel+)
               (paint-clip! bx by fx1 ym by ym 4) (paint-poly pts 6 +sh-white+ +sh-paper+)
               (paint-clip! bx ym fx1 (+ by bh) ym (+ by bh) 4) (paint-poly pts 6 +sh-paper+ +sh-lo+)
               (paint-clip! bx by fx1 (+ by bh))
               (paint-stripes! (+ bx (* 9f0 dpr)) by 1f0 0f0 (* 23f0 dpr) dpr) (paint-poly pts 6 +sh-grid+ +sh-grid+)
               (paint-pattern-off!)
               (paint-reset) (sh-label lx ly lsz "POLY AA+GRAD+STRIPES")))
            (1 ;; a horizontal gradient on a slanted slab; a screentone faded by a vertical alpha gradient (mask-image)
             (pt 0 (- cx (* 0.8f0 s)) (- cy (* 0.75f0 s))) (pt 1 (+ cx (* 0.95f0 s)) (- cy (* 0.75f0 s)))
             (pt 2 (+ cx (* 0.8f0 s)) (- cy (* 0.15f0 s))) (pt 3 (- cx (* 0.95f0 s)) (- cy (* 0.15f0 s)))
             (paint-clip! -1f5 -1f5 1f5 1f5) (paint-grad! (- cx s) 0f0 (+ cx s) 0f0) (paint-poly pts 4 +sh-blood+ +sh-paper+)
             (pt 0 (- cx s) (- cy (* 0.05f0 s))) (pt 1 (+ cx s) (- cy (* 0.05f0 s))) (pt 2 (+ cx s) (+ cy (* 0.9f0 s))) (pt 3 (- cx s) (+ cy (* 0.9f0 s)))
             (paint-clip! -1f5 -1f5 1f5 1f5 (- cy (* 0.05f0 s)) (+ cy (* 0.9f0 s)))
             (paint-dots! (* 7f0 dpr) (* 1.15f0 dpr)) (paint-poly pts 4 +sh-dot+ +sh-dot1+) (paint-pattern-off!)
             (sh-label lx ly lsz "LINEAR GRAD / DOTS+MASK"))
            (2 ;; a glow (wide feather) under a bordered box; a tilted paper tag (rotate about its centre); a soft drop shadow
             (paint-box! (- cx (* 0.4f0 s)) cy (* 0.45f0 s) (* 0.45f0 s) (* 0.06f0 s) (* 18f0 dpr) 0f0 +sh-glow+)
             (paint-box! (- cx (* 0.4f0 s)) cy (* 0.45f0 s) (* 0.45f0 s) (* 0.06f0 s) 1f0 0f0 +sh-night+)
             (paint-box! (- cx (* 0.4f0 s)) cy (* 0.45f0 s) (* 0.45f0 s) (* 0.06f0 s) 1f0 (* 1.5f0 dpr) +sh-blood+)
             (paint-push)
             (paint-transform! (+ cx (* 0.55f0 s)) cy :rot -0.105f0)
             (paint-box! (+ cx (* 0.6f0 s)) (+ cy (* 0.06f0 s)) (* 0.25f0 s) (* 0.25f0 s) 0f0 (* 6f0 dpr) 0f0 +sh-shadow+)
             (paint-box! (+ cx (* 0.55f0 s)) cy (* 0.25f0 s) (* 0.25f0 s) 0f0 1f0 0f0 +sh-paper+)
             (paint-pop)
             (sh-label lx ly lsz "BOX GLOW / TILTED TAG"))
            (3 ;; ellipse, ring, arcs (clockwise .62 and counter-clockwise .3), a glowing ring
             (paint-ellipse! (- cx (* 0.55f0 s)) (- cy (* 0.4f0 s)) (* 0.35f0 s) (* 0.25f0 s) +sh-steel+)
             (paint-ellipse! (+ cx (* 0.45f0 s)) (- cy (* 0.4f0 s)) (* 0.3f0 s) (* 0.3f0 s) +sh-paper+ :thick (* 0.06f0 s))
             (paint-ellipse! (- cx (* 0.45f0 s)) (+ cy (* 0.45f0 s)) (* 0.32f0 s) (* 0.32f0 s) +sh-stone+ :thick (* 0.05f0 s))
             (paint-ellipse! (- cx (* 0.45f0 s)) (+ cy (* 0.45f0 s)) (* 0.32f0 s) (* 0.32f0 s) +sh-blood+ :thick (* 0.05f0 s) :frac 0.62f0)
             (paint-ellipse! (+ cx (* 0.45f0 s)) (+ cy (* 0.45f0 s)) (* 0.32f0 s) (* 0.32f0 s) +sh-glow+ :thick (* 0.04f0 s) :feather (* 10f0 dpr))
             (paint-ellipse! (+ cx (* 0.45f0 s)) (+ cy (* 0.45f0 s)) (* 0.32f0 s) (* 0.32f0 s) +sh-paper+ :thick (* 0.04f0 s) :frac 0.3f0 :ccw t)
             (sh-label lx ly lsz "ELLIPSE RING ARC GLOW"))
            (4 ;; the 爆 dial mock: night disc and rim, the ink level (a disc cut from below by the scissor), ticks band, red disc
             (let* ((r (* 0.7f0 s)) (lv (+ 0.5f0 (* 0.5f0 (f-sin (* 1.5f0 now))))) (top (- (+ cy r) (* 2f0 r lv))))
               (declare (single-float r lv top))
               (paint-ellipse! cx cy (+ r (* 0.12f0 s)) (+ r (* 0.12f0 s)) +sh-rvrim+ :feather (* 14f0 dpr))
               (paint-ellipse! cx cy r r +sh-night+)
               (paint-push) (paint-scissor! (- cx r) top (+ cx r) (+ cy r))
               (paint-ellipse! cx cy r r +sh-steel+)
               (paint-pop)
               (paint-rect (- cx r) (- cy (* 0.04f0 s)) (- r (* 0.12f0 s)) (* 0.08f0 s) +sh-ink+)
               (paint-rect (+ cx (* 0.12f0 s)) (- cy (* 0.04f0 s)) (- r (* 0.12f0 s)) (* 0.08f0 s) +sh-ink+)
               (paint-ellipse! cx cy (* 0.28f0 s) (* 0.28f0 s) +sh-blood+)
               (paint-ellipse! cx cy r r +sh-rvrim+ :thick (* 1.5f0 dpr))
               (paint-ellipse! cx cy (+ r (* 0.08f0 s)) (+ r (* 0.08f0 s)) +sh-blood+ :thick (* 0.05f0 s) :frac lv))
             (sh-label lx ly lsz "DIAL: LEVEL CUT BY SCISSOR"))
            (5 ;; strokes: the deck's ink line (butt, square joint), the infinity (round, drawn fraction animated)
             (setf (aref ln 0) (- cx s) (aref ln 1) (+ cy (* 0.1f0 s)) (aref ln 2) (+ cx (* 0.2f0 s)) (aref ln 3) (- cy (* 0.35f0 s))
                   (aref ln 4) (+ cx s) (aref ln 5) (- cy (* 0.2f0 s)))
             (paint-stroke! ln 3 (* 0.06f0 s) +sh-ink+)
             (paint-stroke! ln 3 (* 0.02f0 s) +sh-paper+)
             (paint-push)
             (paint-transform! 33f0 16f0 :sx (* 0.025f0 s) :sy (* 0.025f0 s) :dx (- cx 33f0) :dy (- (+ cy (* 0.45f0 s)) 16f0))
             (paint-stroke! *sh-inf* (floor (length *sh-inf*) 2) 2.6f0 +sh-paper+ :frac (f-mod (* 0.5f0 now) 1f0) :round t)
             (paint-pop)
             (sh-label lx ly lsz "STROKES BUTT / ROUND+FRAC"))
            (6 ;; a radial gradient: the phone plate's ink pool, farthest-side at 35 %
             (paint-rect (- cx s) (- cy (* 0.4f0 s)) (* 2f0 s) (* 0.8f0 s) +sh-paper+)
             (paint-radial! (- cx (* 0.3f0 s)) cy (* 1.3f0 s) (* 0.4f0 s) *sh-pool* 3)
             (sh-label lx ly lsz "RADIAL 3 STOPS"))
            (7 ;; soul flames from the SVG path: paper fill (star-shaped fan) + ink stroke; at stake (blood 2.4); gone (grey dot)
             (dotimes (k 3)
               (let* ((sc (* 0.075f0 s)) (fx (+ (- cx (* 0.9f0 s)) (* (i->f k) 0.65f0 s))) (fy (- cy (* 0.55f0 s))))
                 (declare (single-float sc fx fy))
                 (paint-reset)
                 (paint-transform! 0f0 0f0 :sx sc :sy sc :dx fx :dy fy)
                 (if (= k 2)
                     (paint-ellipse! 5f0 11f0 1.9f0 1.9f0 +sh-stone+)
                     (progn (paint-clip! -1f5 -1f5 1f5 1f5) (paint-centre! 6f0 12.6f0) (paint-poly *sh-flame* (floor (length *sh-flame*) 2) +sh-paper+ +sh-paper+)
                            (paint-stroke! *sh-flame-o* (floor (length *sh-flame-o*) 2) (if (= k 0) 1.2f0 2.4f0) (if (= k 0) +sh-ink+ +sh-blood+) :round t)))))
             (paint-reset) (sh-label lx ly lsz "FLAMES (SVG PATH)"))
            (8 ;; the scissor's reveal: a slanted slash cut left -> right (hd-cut), looping
             (let ((u (f-mod (* 0.6f0 now) 1f0)))
               (declare (single-float u))
               (pt 0 (- cx s) (- cy (* 0.1f0 s))) (pt 1 (+ cx s) (- cy (* 0.35f0 s))) (pt 2 (+ cx (* 0.9f0 s)) (+ cy (* 0.1f0 s))) (pt 3 (- cx (* 0.95f0 s)) (+ cy (* 0.3f0 s)))
               (paint-scissor! (- cx s) (- cy s) (+ (- cx s) (* 2f0 s u)) (+ cy s))
               (paint-clip! -1f5 -1f5 1f5 1f5) (paint-poly pts 4 +sh-blood+ +sh-blood+)
               (paint-scissor! -1f6 -1f6 1f6 1f6))
             (sh-label lx ly lsz "SCISSOR REVEAL"))
            (9 ;; group opacity: the same box + disc at 1 and at .3 (per primitive: the overlap shows)
             (dotimes (k 2)
               (let ((ox (if (= k 0) (- cx (* 0.5f0 s)) (+ cx (* 0.5f0 s)))))
                 (declare (single-float ox))
                 (paint-push) (when (= k 1) (paint-opacity! 0.3f0))
                 (paint-box! ox cy (* 0.35f0 s) (* 0.35f0 s) (* 0.05f0 s) 1f0 0f0 +sh-paper+)
                 (paint-ellipse! (+ ox (* 0.2f0 s)) (+ cy (* 0.2f0 s)) (* 0.25f0 s) (* 0.25f0 s) +sh-blood+)
                 (paint-pop)))
             (sh-label lx ly lsz "OPACITY 1 / .3"))
            (10 ;; the stance picker's boxes (one lit, rotated -4 deg, x1.08) and the pause chip (cut corner, inset outline)
             (dotimes (k 3)
               (let ((bx (+ (- cx (* 0.75f0 s)) (* (i->f k) 0.38f0 s))) (by (- cy (* 0.45f0 s))) (on (= k 1)))
                 (declare (single-float bx by))
                 (paint-push)
                 (when on (paint-transform! bx by :rot -0.0698f0 :sx 1.08f0 :sy 1.08f0))
                 (paint-box! bx by (* 0.15f0 s) (* 0.15f0 s) 0f0 1f0 (if on 0f0 dpr) (if on +sh-paper+ +sh-rim+))
                 (paint-pop)))
             (pt 0 (- cx s) (+ cy (* 0.05f0 s))) (pt 1 (+ cx (* 0.2f0 s)) (+ cy (* 0.05f0 s))) (pt 2 (+ cx (* 0.4f0 s)) (+ cy (* 0.25f0 s)))
             (pt 3 (+ cx (* 0.4f0 s)) (+ cy (* 0.8f0 s))) (pt 4 (- cx s) (+ cy (* 0.8f0 s)))
             (paint-clip! -1f5 -1f5 1f5 1f5) (paint-poly pts 5 +sh-chip+ +sh-chip+)
             (paint-pen! (f-floor+ (- cx (* 0.8f0 s))) (f-floor+ (+ cy (* 0.55f0 s))) (* 12f0 dpr) :spacing 0.18f0) (paint-text "II PAUSE" 1 +sh-paper+)
             (sh-label lx ly lsz "STANCE BOXES / PAUSE CHIP"))
            (11 ;; the back layer: a slab under the scene, shown only on a transparent frame (2509's third state)
             (when (eq *lhud-shapes* :back)
               (setf *render-transparent* t)
               (with-paint-back
                 (paint-rect 0f0 0f0 w (* 0.5f0 h) +sh-blood+ +sh-back+)
                 (paint-dots! (* 7f0 dpr) (* 1.15f0 dpr))
                 (paint-rect 0f0 0f0 w (* 0.5f0 h) +sh-dot1+)
                 (paint-pattern-off!)))
             (paint-box! cx cy (* 0.8f0 s) (* 0.5f0 s) 0f0 1f0 dpr +sh-rim+)
             (sh-label lx ly lsz "BACK LAYER (2509 x2)"))))))
    (paint-reset))
  nil)
