;;;; lhud-menu-select.lisp — SELECT drawn by Lisp (docs/duel/DUEL_LISP_HUD.md §15, phase 6; menu.css #s-select, .fighter, .slot, .diff,
;;;; .opt; menu.js renderSelect / measureSpot). The fighter stands between two layers: the back layer (WITH-PAINT-BACK, under the
;;;; transparent scene: the world, the cards' fills, screentone and emblems; on a phone also the other cards' text, so the fighter
;;;; covers it) and the front (the head, the slots, the cards' text, the pick seals, the foot's rows). LM-SELECT-SPOT gives the camera
;;;; the focused card's model spot from the same tweened layout the view draws (webui.lisp SELECT-SPOT, camera.lisp :SELECT-WEB).
(in-package :duel)

(defconstant +sel-k+ 7 "Transitions a card: [0] its flex-grow, [1] focus (the fill .4s), [2] the emblem (colour .5s, translateX .7s
ease-out), [3] the details' max-height (0..420 CSS px, .6s ease-out), [4] their opacity (.4s, .1s after focusing), [5] picked, [6]
spare.")
(declaim (type f32vec *lm-sel-tr* *lm-sel-tr2* *lm-sel-t* *lm-stamp*))
(defvar *lm-sel-tr* (make-transitions (* 3 +sel-k+) 0f0) "SELECT's cards' transitions (+SEL-K+ each).")
(defvar *lm-sel-tr2* (make-transitions 16 0f0)
  "SELECT's others: [0] [1] the slots' active borders (.3s), [2] the difficulty row live (.3s), [3] the camera row live, [4..6] the
difficulty options' slabs, [7..9] their colours, [10] [11] the camera options' slabs (behind, side), [12] [13] their colours.")
(defvar *lm-sel-t* (make-array 3 :element-type 'single-float :initial-element -100f0) "Each card's pick stamp start (stamp .45s).")
(declaim (type (simple-array fixnum (*)) *lm-sel-i*))
(defvar *lm-sel-i* (make-array 3 :element-type 'fixnum :initial-element 0) "Each card picked last frame (1 / 0).")
(defparameter *lm-stamp* (make-tween '((0 nil 1.9 -18 0.2) (0.55 nil 0.88 -4 1) (1 nil 1 -6 1)) :dur 0.45 :curve +ease-out+ :fill 1 :base '(0 -20 1))
  "menu.css stamp (the pick seal): scale 1.9 rotate -18deg opacity .2 -> .88 / -4 / 1 at 55 % -> 1 / -6, .45s ease-out forwards.")
(defparameter +c-card-dot+ (rgba #xbcc1cc (* 0.2 0.55))) (defparameter +c-card-dot0+ (rgba #xbcc1cc 0f0))
(defparameter +c-ptr-front+ (rgba #x12141c 0.55)) (defparameter +c-sel-line+ (rgba #x3a3f4e))

(defmacro lm-sel-cur () "The card the cursor is on (menu.js curPick; the last page: P2's pick)." `(if (>= (uv 2) 2) (uv 4) (if (= (uv 2) 1) (uv 4) (uv 3))))
(defun lm-sel-picked-p (r) "Is roster index R picked (P1 from phase 1, P2 from phase 2)?" (or (and (>= (uv 2) 1) (= r (uv 3))) (and (>= (uv 2) 2) (= r (uv 4)))))

(defun-fast lm-select-update ()
  "SELECT's system: each card's weight (focus 2.6, narrow 4, .6s ease-out), fill, emblem, details, the pick stamps; the slots, the
last page's rows and their options."
  (when (= (uv 0) 5)
    (let* ((now (aref *ui-clock* 0)) (tr *lm-sel-tr*) (t2 *lm-sel-tr2*) (snap (lm-entered-p)) (cur (lm-sel-cur)) (ph (uv 2))
           (narrow (lm-narrow-p (lm-cw))) (last (>= ph 2)) (rows (uv 8)) (row (uv 1)))
      (declare (single-float now) (fixnum cur ph rows row))
      (macrolet ((to (v i x dur curve &optional (delay 0f0)) `(trans-to ,v ,i ,x now (if snap 0f0 ,dur) ,curve (if snap 0f0 ,delay))))
        (dotimes (k 3)
          (let* ((r (svref *lm-card-order* k)) (b (* k +sel-k+)) (foc (= r cur)) (f (if foc 1f0 0f0)) (pk (lm-sel-picked-p r)))
            (declare (fixnum r b) (single-float f))
            (to tr b (if foc (if narrow 4f0 2.6f0) 1f0) 0.6f0 +ease-out+)
            (to tr (+ b 1) f 0.4f0 +ease+) (to tr (+ b 2) f 0.7f0 +ease-out+)
            (to tr (+ b 3) (* 420f0 f) 0.6f0 +ease-out+) (to tr (+ b 4) f 0.4f0 +ease+ (if foc 0.1f0 0f0))
            (when (and pk (= 0 (aref *lm-sel-i* k))) (setf (aref *lm-sel-t* k) now))
            (setf (aref *lm-sel-i* k) (if pk 1 0))))
        (to t2 0 (if (= ph 0) 1f0 0f0) 0.3f0 +ease+) (to t2 1 (if (= ph 1) 1f0 0f0) 0.3f0 +ease+)
        (let* ((drow (if (logtest rows 1) 0 -1)) (crow (if (logtest rows 2) (if (logtest rows 1) 1 0) -1)))
          (declare (fixnum drow crow))
          (to t2 2 (if (and last (= row drow)) 1f0 0.35f0) 0.3f0 +ease+) (to t2 3 (if (and last (= row crow)) 1f0 0.35f0) 0.3f0 +ease+))
        (dotimes (k 3) (to t2 (+ 4 k) (if (= k (uv 5)) 1f0 0f0) 0.3f0 +ease-out+) (to t2 (+ 7 k) (if (= k (uv 5)) 1f0 0f0) 0.2f0 +ease+))
        (dotimes (k 2) (let* ((on (if (= (if (= k 0) 1 0) (uv 7)) 1f0 0f0)))
                         (to t2 (+ 10 k) on 0.3f0 +ease-out+) (to t2 (+ 12 k) on 0.2f0 +ease+))))))
  nil)

;;; ---------------------------------------------------------------- the layout (shared by the view and the camera's spot)
(defun-fast lm-sel-layout ()
  "*LM-G* := SELECT's boxes (lhud-menu-geom.lisp LM-SELECT-GEOM!, CSS px) with the cards' tweened weights."
  (lm-begin-geom)
  (let* ((wv *lm-g2*) (now (aref *ui-clock* 0)))
    (declare (single-float now) (type f32vec wv))
    (dotimes (k 3) (setf (aref wv k) (trans-value *lm-sel-tr* (* k +sel-k+) now)))
    (lm-select-geom! *lm-g* (lm-cw) (lm-ch) wv (if (>= (uv 2) 2) 1 0)))
  nil)

(defmacro lm-card-name-size (foc)
  "A card's name size (CSS px): clamp(34px, 4.6vw, 70px); narrow 34, the focused 48."
  `(if (lm-narrow-p (lm-cw)) (if ,foc 48f0 34f0) (f-max 34f0 (f-min (* 0.046f0 (lm-cw)) 70f0))))

(defun-fast lm-card-body-h (k)
  "Card K's text block above its bottom padding (CSS px): the details (tagline 14px / 1.7 at 42ch = 321.6 px, Chrome's ch of the sans, 14, the pointers' row: desktop one
row of 77, narrow three of 51, short hidden), tweened by their max-height, 10, the name (.85 line), 10, the kanji line 13: into
*LM-G2* [13]."
  (declare (fixnum k))
  (let* ((now (aref *ui-clock* 0)) (narrow (lm-narrow-p (lm-cw))) (r (svref *lm-card-order* k)) (card (lm-card r)) (b (* k +sel-k+))
         (foc (= r (lm-sel-cur))) (nz (lm-card-name-size foc)) (cw (- (aref *lm-g* (+ 14 (* 2 k))) (if narrow 32f0 44f0)))
         (lines 2) (ptrs (if narrow 155f0 (if (<= (lm-ch) 560f0) 0f0 77f0))) (moreh 0f0))
    (declare (fixnum b lines) (single-float nz cw ptrs moreh))
    (paint-pen! 0f0 0f0 (css 14f0))
    (setf lines (paint-measure-paragraph (fourth card) +f-sans+ :width (* (lay-dpr) (f-min cw 321.6f0))))
    (setf moreh (+ (* (i->f lines) 23.8f0) (if (> ptrs 0f0) (+ (if (<= (lm-ch) 560f0) 8f0 14f0) ptrs) 0f0)))
    (setf (aref *lm-g2* 13) (+ (f-min moreh (trans-value *lm-sel-tr* (+ b 3) now)) 10f0 (* 0.85f0 nz) 10f0 13f0))
    nil))


(defun-fast lm-select-spot (k)
  "The focused card's model spot (permille of the window, K 0 x / 1 y), menu.js measureSpot from the Lisp layout: desktop the card's
centre across and 52 % of the way from its top to its kanji line; a phone 74 % across and its middle."
  (declare (fixnum k))
  (lm-sel-layout)
  (let* ((cur (lm-sel-cur)) (c (max 0 (or (position cur *lm-card-order*) 1))) (x (aref *lm-g* (+ 8 (* 2 c)))) (y (aref *lm-g* (+ 9 (* 2 c))))
         (w (aref *lm-g* (+ 14 (* 2 c)))) (h (aref *lm-g* (+ 15 (* 2 c)))) (cw (lm-cw)) (ch (lm-ch)))
    (declare (fixnum cur c) (single-float x y w h cw ch))
    (if (lm-narrow-p cw)
        (fl-round (* 1000f0 (if (= k 0) (/ (+ x (* 0.74f0 w)) cw) (/ (+ y (* 0.5f0 h)) ch))))
        (if (= k 0)
            (fl-round (* 1000f0 (/ (+ x (* 0.5f0 w)) cw)))
            (progn (lm-card-body-h c)
                   (let* ((jp (f-max (+ y 20f0) (- (+ y h) 22f0 (aref *lm-g2* 13))))) (declare (single-float jp)) (fl-round (* 1000f0 (/ (+ y (* 0.52f0 (- jp y))) ch)))))))))

;;; ---------------------------------------------------------------- the back layer: the world and the cards' fills / emblems
(defun-fast lm-card-text (k)
  "Card K's text (menu.css .fighter .body: the kanji line, the name, the details (tagline and the pointers, by their max-height and
opacity), the pick seal (stamp) with P1 over P1's)."
  (declare (fixnum k))
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))) (r (svref *lm-card-order* k)) (card (lm-card r))
         (b (* k +sel-k+)) (foc (= r (lm-sel-cur))) (x (lmg (+ 8 (* 2 k)))) (y (lmg (+ 9 (* 2 k)))) (w (lmg (+ 14 (* 2 k))))
         (h (lmg (+ 15 (* 2 k)))) (pl (css (if narrow 16f0 22f0))) (pb (css (if narrow 14f0 22f0))) (nz (* d (lm-card-name-size foc)))
         (bh (* d (progn (lm-card-body-h k) (aref *lm-g2* 13)))) (ty (f-max (+ y (css (if narrow 12f0 20f0))) (- (+ y h) pb bh)))   ; (an overflowing body starts at the top padding)
         (tx (f-floor+ (+ x pl))) (tw (- w pl pl))
         (mh (* d (trans-value *lm-sel-tr* (+ b 3) now))) (mo (trans-value *lm-sel-tr* (+ b 4) now)))
    (declare (fixnum r b) (single-float now d x y w h pl pb nz bh ty tx tw mh mo))
    (paint-push)
    (paint-scissor! x y (+ x w) (+ y h))
    (lm-text (second card) +f-kanji+ +c-stone+ tx (f-floor+ (lm-base ty +f-kanji+ (css 13f0) 1f0)) (css 13f0) :spacing 0.3f0 :edge +ek6+)
    (setf ty (+ ty (css 13f0) (css 10f0)))
    (lm-text (first card) +f-display+ +c-paper+ tx (f-floor+ (lm-base ty +f-display+ nz 0.85f0)) nz :spacing -0.005f0)
    (setf ty (+ ty (* 0.85f0 nz) (css 10f0)))
    (when (and (> mo 0.002f0) (> mh 0.5f0))
      (paint-push)
      (paint-scissor! x ty (+ x w) (f-min (+ y h) (+ ty mh)))
      (paint-opacity! mo)
      (paint-pen! tx (f-floor+ ty) (css 14f0) :edge +es4+)
      (paint-paragraph (fourth card) +f-sans+ +c-steel+ :width (* d (f-min (- (aref *lm-g* (+ 14 (* 2 k))) (if narrow 32f0 44f0)) 321.6f0)) :lh 1.7f0)   ; (the width LM-CARD-BODY-H measured, computed alike: one cache entry)
      (let* ((py (+ ty (aref *paint-pen* 7) (css (if (<= (lm-ch) 560f0) 8f0 14f0)))))
        (declare (single-float py))
        (unless (and (not narrow) (<= (lm-ch) 560f0))
          (let* ((ptrs (fifth card)) (pw (if narrow tw (/ (- tw (* 2f0 d)) 3f0))) (ph (css (if narrow 51f0 77f0))))
            (declare (single-float pw ph))
            (dotimes (j 3)
              (let* ((p (nth j ptrs)) (px (if narrow tx (+ tx (* (i->f j) (+ pw d))))) (pyj (if narrow (+ py (* (i->f j) (+ ph d))) py)))
                (declare (single-float px pyj))
                (paint-rect px pyj pw ph +c-ptr-front+)
                (if narrow
                    (let* ((base (f-floor+ (+ pyj (css 7f0) (line-baseline +f-display+ (css 15f0) 1.1f0)))))
                      (declare (single-float base))
                      (lm-text (svref #("01" "02" "03") j) +f-mono+ +c-blood+ (f-floor+ (+ px (css 10f0))) base (css 10f0) :spacing 0.1f0)
                      (lm-text (first p) +f-display+ +c-paper+ (f-floor+ (+ px (css 40f0))) base (css 15f0) :spacing 0.04f0 :edge +ed8+)
                      (lm-text (second p) +f-sans+ +c-stone+ (f-floor+ (+ px (css 40f0))) (f-floor+ (lm-base (+ pyj (css 7f0) (css 20.5f0)) +f-sans+ (css 11f0) 1.5f0))
                               (css 11f0) :edge +es4+))
                    (let* ((py0 (+ pyj (css 10f0))))
                      (declare (single-float py0))
                      (lm-text (svref #("01" "02" "03") j) +f-mono+ +c-blood+ (f-floor+ (+ px (css 12f0))) (f-floor+ (lm-base py0 +f-mono+ (css 10f0) 1f0)) (css 10f0) :spacing 0.1f0)
                      (lm-text (first p) +f-display+ +c-paper+ (f-floor+ (+ px (css 12f0))) (f-floor+ (lm-base (+ py0 (css 16f0)) +f-display+ (css 15f0) 1.1f0))
                               (css 15f0) :spacing 0.04f0 :edge +ed8+)
                      (lm-text (second p) +f-sans+ +c-stone+ (f-floor+ (+ px (css 12f0))) (f-floor+ (lm-base (+ py0 (css 38.5f0)) +f-sans+ (css 11f0) 1.5f0))
                               (css 11f0) :edge +es4+))))))))
      (paint-pop))
    (paint-pop)
    ;; the pick seal (right 18, bottom 18; narrow 44 at 12) with P1 over P1's pick
    (when (lm-sel-picked-p r)
      (let* ((st (aref *lm-sel-t* k)) (sc (twv *lm-stamp* st now 0)) (rot (twv *lm-stamp* st now 1)) (op (twv *lm-stamp* st now 2))
             (ss (css (if narrow 44f0 58f0))) (cx (- (+ x w) (css (if narrow 12f0 18f0)) (* 0.5f0 ss))) (cy (- (+ y h) (css (if narrow 12f0 18f0)) (* 0.5f0 ss))))
        (declare (single-float st sc rot op ss cx cy))
        (when (> sc 0.002f0)
          (paint-push)
          (paint-transform! cx cy :sx sc :sy sc :rot (* 0.017453f0 rot)) (paint-opacity! op)
          (paint-box! cx cy (* 0.5f0 ss) (* 0.5f0 ss) (css 4f0) 1f0 0f0 +c-blood+)
          (lm-text (third card) +f-kanji+ +c-paper+ (f-floor+ cx) (+ cy (* 0.36f0 (css (if narrow 20f0 26f0)))) (css (if narrow 20f0 26f0)) :align :center)
          (when (and (>= (uv 2) 1) (= r (uv 3)))
            (lm-text "P1" +f-mono+ +c-blood+ (f-floor+ cx) (f-floor+ (- cy (* 0.5f0 ss) (css 8f0))) (css 10f0) :align :center))
          (paint-pop))))
    nil))

(defun-fast lm-select-back ()
  "The back layer (under the transparent scene): the world, each card's fill (#10121a, focused #191c26), its screentone (6 px,
rgba(188,193,204,.2) at .55, from the bottom to 70 %) and its emblem (clamp(160px, 40vh, 420px) Mincho, slate -> #2f3443, right -4 %
top -4 %, translateX(-6 %) focused), cut to the card; on a phone the other cards' text too (the fighter covers it)."
  (lm-sel-layout)
  (setf *render-transparent* t)
  (with-paint-back
    (lm-world)
    (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw)))
           (ez (css (if narrow (* 0.3f0 (lm-ch)) (f-max 160f0 (f-min (* 0.4f0 (lm-ch)) 420f0))))))
      (declare (single-float now d ez))
      (dotimes (k 3)
        (let* ((b (* k +sel-k+)) (x (lmg (+ 8 (* 2 k)))) (y (lmg (+ 9 (* 2 k)))) (w (lmg (+ 14 (* 2 k)))) (h (lmg (+ 15 (* 2 k))))
               (kf (trans-value *lm-sel-tr* (+ b 1) now)) (ke (trans-value *lm-sel-tr* (+ b 2) now)) (r (svref *lm-card-order* k)))
          (declare (fixnum b r) (single-float x y w h kf ke))
          (paint-reset)
          (paint-rect x y w h (col-mix! *lhud-mix* +c-card-bg+ +c-card-foc+ kf))
          (lm-set! *lm-pts* x y (+ x w) y (+ x w) (+ y h) x (+ y h))
          (paint-clip! x y (+ x w) (+ y h)) (paint-grad! 0f0 (+ y h) 0f0 (+ y (* 0.3f0 h)))
          (paint-dots! (css 6f0) (css 1.2f0))
          (paint-poly *lm-pts* 4 +c-card-dot+ +c-card-dot0+)
          (paint-pattern-off!)
          (paint-scissor! x y (+ x w) (+ y h))
          ;; the emblem: its em box's right edge at the card's right + 4 % of the card, its top at -4 % (translateX -6 % of the box focused)
          (lm-text (third (lm-card r)) +f-kanji+ (col-mix! *lhud-mix* +c-slate+ +c-emb-foc+ ke) (- (+ x w (* 0.04f0 w)) ez (* ke 0.06f0 ez))
                   (+ y (* -0.04f0 h) (line-baseline +f-kanji+ ez 1f0)) ez)
          (when (and narrow (/= r (lm-sel-cur))) (paint-reset) (lm-card-text k)))))
    (paint-reset))
  nil)

;;; ---------------------------------------------------------------- the front
(defun-fast lm-select ()
  "SELECT's front: the eyebrow and heading, the two slots (P1 · YOU / CPU …, the active one's blood border), the cards' text and hot
boxes (the narrow window's other cards drawn in the back layer), the last page's DIFFICULTY / CAMERA rows and START."
  (lm-sel-layout)
  (let* ((now (aref *ui-clock* 0)) (d (lay-dpr)) (narrow (lm-narrow-p (lm-cw))) (ph (uv 2)) (mode (max 0 (min 3 (uv 6))))
         (x0 (lmg 0)) (x1 (lmg 2)) (y0 (lmg 1)) (hz (css (if narrow 30f0 (f-max 30f0 (f-min (* 0.04f0 (lm-cw)) 48f0))))) (t2 *lm-sel-tr2*))
    (declare (single-float now d x0 x1 y0 hz) (fixnum ph mode))
    (paint-reset)
    (lm-text (zh "FIGHTERS · 3 PLAYABLE") +f-mono+ +c-stone+ (f-floor+ x0) (f-floor+ (lm-base y0 +f-mono+ (css 10f0) 1f0)) (css 10f0) :spacing 0.2f0 :edge +em4+)
    (lm-text (lm-sel-title ph mode) +f-display+ +c-paper+ (f-floor+ x0) (f-floor+ (lm-base (+ y0 (css 20f0)) +f-display+ hz 0.9f0)) hz :spacing 0.02f0 :edge +ed8+)
    ;; the slots: right-aligned (narrow: under the heading, each half), bottom with the heading's
    (let* ((who (svref *lm-sel-who* mode)) (sb (if narrow (+ y0 (css 114f0)) (+ y0 (css 20f0) (* 0.9f0 hz)))) (sh (css 49f0)) (sy (- sb sh))
           (n1 (if (>= ph 0) (lm-card-name (uv 3)) (zh "—"))) (n2 (if (>= ph 1) (lm-card-name (uv 4)) (zh "—")))
           (bz (css 20f0)) (ez (css 9f0))
           (w1 (if narrow (* 0.5f0 (- (- x1 x0) (css 10f0))) (f-max (css 120f0) (+ (css 30f0) (f-max (lm-dw n1 bz 0.06f0) (text-w (svref who 0) +f-mono+ ez 0.2f0))))))
           (w2 (if narrow w1 (f-max (css 120f0) (+ (css 30f0) (f-max (lm-dw n2 bz 0.06f0) (text-w (svref who 1) +f-mono+ ez 0.2f0))))))
           (sx2 (- x1 w2)) (sx1 (if narrow x0 (- sx2 (css 10f0) w1))))
      (declare (single-float sb sh sy bz ez w1 w2 sx2 sx1))
      (when narrow (setf sx2 (+ x0 w1 (css 10f0))))
      (macrolet ((slot (sx caption name i done)
                   `(let* ((ka (trans-value t2 ,i now)))
                      (declare (single-float ka))
                      (paint-rect ,sx sy (css 2f0) sh (col-mix! *lhud-mix* +c-sel-line+ +c-blood+ ka))
                      (lm-text ,caption +f-mono+ +c-stone+ (f-floor+ (+ ,sx (css 16f0))) (f-floor+ (lm-base (+ sy (css 8f0)) +f-mono+ ez 1f0)) ez :spacing 0.2f0 :edge +em4+)
                      (lm-text ,name +f-display+ (if (or (> ka 0.5f0) ,done) +c-paper+ +c-stone+) (f-floor+ (+ ,sx (css 16f0)))
                               (f-floor+ (lm-base (+ sy (css 21f0)) +f-display+ bz 1f0)) bz :spacing 0.06f0 :edge +ed8+))))
        (slot sx1 (svref who 0) n1 0 (>= ph 1))
        (slot sx2 (svref who 1) n2 1 (>= ph 2))))
    ;; the cards: hot boxes, the text (narrow: only the focused card's here)
    (dotimes (k 3)
      (let* ((r (svref *lm-card-order* k)))
        (declare (fixnum r))
        (paint-reset)
        (lm-hot 8 r (lmg (+ 8 (* 2 k))) (lmg (+ 9 (* 2 k))) (+ (lmg (+ 8 (* 2 k))) (lmg (+ 14 (* 2 k)))) (+ (lmg (+ 9 (* 2 k))) (lmg (+ 15 (* 2 k)))))
        (unless (and narrow (/= r (lm-sel-cur))) (lm-card-text k))))
    ;; the foot (the last page): DIFFICULTY (EASY NORMAL HARD), CAMERA (BEHIND SIDE), START
    (when (>= ph 2)
      (paint-reset)
      (let* ((fy (lmg 7)) (oz (css 18f0)) (x x0) (ez (css 10f0)) (rows (uv 8)))
        (declare (single-float fy oz x ez) (fixnum rows))
        (macrolet ((group (label i0 n names hotk hotn slab live)
                     `(let* ((op (trans-value t2 ,live now)))
                        (declare (single-float op))
                        (paint-push) (paint-opacity! op)
                        (lm-text ,label +f-mono+ +c-stone+ (f-floor+ x) (f-floor+ (+ fy (css 19f0) (* 0.36f0 ez))) ez :spacing 0.2f0 :edge +em4+)
                        (setf x (+ x (text-w ,label +f-mono+ ez 0.2f0) (css 14f0)))
                        (dotimes (j ,n)
                          (let* ((s ,names) (ow (+ (lm-dw s oz 0.12f0) (css 32f0))))
                            (declare (single-float ow))
                            (lm-hot ,hotk ,hotn x fy (+ x ow) (+ fy (css 38f0)))
                            (lm-lane! x fy (+ x ow) (+ fy (css 38f0)))
                            (lm-slab (trans-value t2 (+ ,slab j) now) +c-paper+)
                            (lm-text s +f-display+ (col-mix! *lhud-mix* +c-stone+ +c-ink+ (trans-value t2 (+ ,slab ,i0 j) now)) (f-floor+ (+ x (css 16f0)))
                                     (f-floor+ (+ fy (css 10f0) (line-baseline +f-display+ oz 1f0))) oz :spacing 0.12f0 :edge +ed8+)
                            (setf x (+ x ow (css 4f0)))))
                        (paint-pop)
                        (setf x (+ x (css 12f0))))))
          (when (logtest rows 1) (group "DIFFICULTY" 3 3 (svref *lm-diffs* j) 9 j 4 2))
          (when (logtest rows 2) (group "CAMERA" 2 2 (if (= j 0) "BEHIND" "SIDE") 10 (if (= j 0) 1 0) 10 3)))
        ;; START (narrow: on the next line)
        (let* ((sx (if narrow x0 x)) (sy (if narrow (+ fy (css 38f0) (css 16f0)) fy)))
          (declare (single-float sx sy))
          (lm-lane! sx sy)
          (lm-press-frame "START")
          (lm-hot 11 0 sx sy (+ sx (lma 2)) (+ sy (css 54f0))))))
    nil))
