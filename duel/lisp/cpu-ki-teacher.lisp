  "HARD's table (DUEL_AI_TEACHER §8): its rounds played at HARD against the opponent's matchup style CPU alone (the strongest version);
docs/research/ai-teacher/ki-table-hard-h*.lisp.")
(defun kt-hash (rows) (let ((h (make-hash-table :test 'equal))) (dolist (r rows h) (setf (gethash (first r) h) (coerce (rest r) 'simple-vector)))))
(defvar *kt-table* (kt-hash *kt-rows*))
(defvar *kt-table-hard* (kt-hash *kt-rows-hard*))

(defun kt-key (f s d)
  "F's situation as perceived: (character form band ostate), the table's buckets (< 2 / 4 / 7 m / beyond; a move with its phase)."
  (let ((dm (round (* 10 d))) (st (snap-state s)))
    (list (fighter-character f) (fighter-form f)                    ; (the form: Kenpachi's sealed / Shikai / Bankai play apart, §8)
          (cond ((< dm 20) :close) ((< dm 40) :mid) ((< dm 70) :far) (t :out))
          (if (eq st :move) (intern (format nil "MOVE-~a" (snap-phase s)) :keyword) st))))

(defun kt-press (b action)
  "Start ACTION as the brain's press (written this step)."
  (flet ((dash (dir to) (setf (brain-dash b) (f32 dir) (brain-dash-to b) (f32 to))))
    (ecase action
      (:j1 (ai-press b :quick 1))
      (:sp (ai-press b :quick 1 :modded t))
      (:hoho (ai-press b :step 1 :modded t :act :hoho))
      (:step-in (ai-press b :step 1 :act :dash) (dash 1 0.0))
      (:step-out (ai-press b :step 1 :act :dash) (dash -1 99.0))
      (:step-side (ai-press b :step 1 :act :side-step) (setf (brain-strafe b) 1f0))
      (:guard (ai-press b :guard 20))
      (:wait (ai-press b :none 20))
      (:walk-in (ai-press b :none 20 :act :dash) (dash 1 0.0))
      (:walk-out (ai-press b :none 20 :act :dash) (dash -1 99.0)))))

(defun kt-neutral (e b f s d)
  "The teacher's neutral decision: T when it pressed (see the file header)."
  (when (and (member (fighter-character f) *kt-on*) (member (fighter-state f) '(:idle :run)) (not (gauges-awakened-ok-p e))
             (not (member (list (fighter-character f) (brain-difficulty b)) *kt-off-at* :test #'equal)))
    (let* ((key (kt-key f s d))
           (row (or (and (eq (brain-difficulty b) :hard) (gethash key *kt-table-hard*)) (gethash key *kt-table*))))
      (when row
        (let* ((dif (brain-difficulty b)) (tau (getf *kt-tau* dif 0.03)) (lo (- (reduce #'max row) (getf *kt-budget* dif 0.05)))
               (ws (map 'list (lambda (v) (if (>= v lo) (exp (/ (- v lo) tau)) 0.0)) row))
               (r (* (reduce #'+ ws) (sim-rnd01))))
          (loop for w in ws for a in *kt-actions*
                when (plusp w) do (decf r w) (when (<= r 0) (kt-press b a) (return t))
                finally (kt-press b (nth (position (reduce #'max row) row) *kt-actions*)) (return t)))))))

(defun ken-kt-style (e b f kit s d) "Kenpachi vs Ichigo: the teacher's neutral, else KEN-KI-STYLE." (or (kt-neutral e b f s d) (ken-ki-style e b f kit s d)))
(defun ichigo-kt-style (e b f kit s d) "Ichigo vs Kenpachi: the teacher's neutral, else ICHIGO-KI-STYLE." (or (kt-neutral e b f s d) (ichigo-ki-style e b f kit s d)))
(cai-defstyle :kenpachi :ichigo 'ken-kt-style)
(cai-defstyle :ichigo :kenpachi 'ichigo-kt-style)
