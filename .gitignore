# build outputs (./build.sh recreates them)
/build/
/dist/
/.vscode/
# regenerable test screenshots (their scripts under tests/scripts/ recreate them)
/tests/shots/pt-*
/tests/shots/ec-*
/tests/shots/duel-view-*
/tests/shots/duel-vfx-*
/tests/scripts/pt-*
# restyle review stills (docs/research/style-history/style-shots.py, docs/research/style-history/style-2-shots.py regenerate them); keep the sheets
/tests/shots/style-*
!/tests/shots/style-1a-proportions-*.png
!/tests/shots/style-2-gallery.png

# user-supplied reference images (third-party art: never commit)
/.refs/
*.pyc
/.claude/*
!/.claude/skills/
# batch sheets and WebGL-era stills: kept on disk, no longer tracked (R8, D6)
/tests/shots/batch-*
/tests/shots/webgl-*
