;;;; xch-ai.lisp — the core CPU's exchange after a cancel and its clash (duel/lisp/xch-ai.lisp; DUEL_AI_STRATEGY §11.18)
(in-package :duel)

;; which side of a cancel a move in play stands on
(check (eq (xch-side :na :hit 40 30) :j))                          ; (his J link took part: AS / next J open)
(check (eq (xch-side :sa :hit 40 30) :j))                          ; (an SA that took part)
(check (eq (xch-side :ns :hit 40 30) :ns))                         ; (an NS segment: its SA open at once)
(check (eq (xch-side :ns nil 30 30) :ns))                          ; (on its first frame)
(check (null (xch-side :sa :hit 30 30)))                           ; (an SA the cancel fired, stamped with its tick: took no part)
(check (null (xch-side :na nil 40 30)))                            ; (no contact: not landed)
(check (null (xch-side :as :hit 40 30)))                           ; (an AS: no answer to make)
(check (null (xch-side :na :hit -1 30)))                           ; (a real hit: no exchange, the combo route stays the styles')
(check (null (xch-side :ns :hit 20 30)))                           ; (an exchange from an earlier move)
;; the J side's answer: weighted between the AS and the next J, only in reach; no Hoho (DUEL_CORE §2.1.2: refused in an open exchange)
(let ((ws '(:as 0.6 :j 0.4)))
  (check (eq (xch-j-answer 0.1 ws t) :as))
  (check (eq (xch-j-answer 0.7 ws t) :j))
  (check (null (xch-j-answer 0.1 ws nil))))                        ; (out of reach: he holds)
(check (every (lambda (d) (let ((w (getf *cai-xch-j* d))) (and (getf w :as) (null (getf w :hoho))))) '(:easy :normal :hard)))
(check (not (boundp '*cai-xch-ns-hoho-p*)))                         ; (the NS side's Hoho out left with the rule)
;; the mix (the harder guess) grows with the difficulty
(check (<= (getf (getf *cai-xch-j* :easy) :j) (getf (getf *cai-xch-j* :normal) :j) (getf (getf *cai-xch-j* :hard) :j)))
;; the NS side sees his turn: an AS or a new J link started after the cancel (perceived); or his J itself when its own hit was the cancel's
(check (xch-turn-seen-p :as 41 40 nil))
(check (xch-turn-seen-p :na 45 40 nil))
(check (not (xch-turn-seen-p :na 35 40 nil)))                      ; (the J his hit cancelled with: not his turn, his AS may come)
(check (xch-turn-seen-p :na 35 40 t))                              ; (her segment's hit cancelled his J in its startup: it is still coming)
(check (xch-turn-seen-p :sa 35 40 t))
(check (not (xch-turn-seen-p :ns 45 40 t)))
(check (not (xch-turn-seen-p nil 45 40 t)))
;; the clash's opener: the class that cancels his whichever hit lands first
(check (eq (clash-opener :ns) :na))
(check (eq (clash-opener :na) :ns))
(check (eq (clash-opener :as) :na))
(check (eq (clash-opener :sa) :ns))
(check (null (clash-opener nil)))
;; the knobs keep EASY <= NORMAL <= HARD where a larger chance is the stronger play
(check (<= (getf *cai-xch-sa-p* :easy) (getf *cai-xch-sa-p* :normal) (getf *cai-xch-sa-p* :hard)))
;; the own hit's cancel: an early SA or keep watching, a mix (the user 2026-11-18: 「先補防守」): one value a tier, strictly inside 0-1
(check (loop for d in '(:easy :normal :hard) always (< 0.0 (getf *cai-xch-early-p* d) 1.0)))
(check (<= (getf *cai-clash-p* :easy) (getf *cai-clash-p* :normal) (getf *cai-clash-p* :hard)))
;; the clash's window: a move's own hits, else a summon's later clone cut (:hit-at / :hit-reach), else none
(check (equal (multiple-value-list (clash-window 1 14 2.0 nil nil)) '(14 2.0)))
(check (equal (multiple-value-list (clash-window 0 18 0.0 16 2.6)) '(17 2.6)))
(check (null (clash-window 0 18 0.0 nil nil)))
;; KESSA's NS3 summons: :hit-at = the clone's on-frame + its cut's S - 1 (a clone steps on its spawn frame too; the X: its clones start 2
;; frames early, ICHIGO-NS-CLONE-X); measured in the browser: n3a's cut on its f15, n3b's on f11
(flet ((at (m) (getf (mv-params (find-move m)) :hit-at)) (on (m) (first (first (mv-on-frame (find-move m))))))
  (check (= (at :ic-k-n3a) (+ (on :ic-k-n3a) (mv-s (find-move :ic-c-light)) -1)))
  (check (= (at :ic-k-n3b) (+ (on :ic-k-n3b) (mv-s (find-move :ic-c-light)) -1)))
  (check (= (at :ic-k-n3c) (+ (on :ic-k-n3c) 2 (mv-s (find-move :ic-c-xa)) -1)))
  (check (every (lambda (m) (< (at m) (mv-s (find-move m)))) '(:ic-k-n3a :ic-k-n3b :ic-k-n3c))))   ; (inside the summon's startup)
;; the NS side's SA: his new turn at once; his J still coming (own hit) only *CAI-XCH-SA-WAIT* frames after the cancel (tick 40)
(check (xch-sa-now-p :as 41 40 nil 42 4))
(check (xch-sa-now-p :na 45 40 nil 46 4))
(check (not (xch-sa-now-p :na 35 40 t 42 4)))                        ; (2 frames after the cancel: his AS would start later and win)
(check (xch-sa-now-p :na 35 40 t 44 4))
(check (not (xch-sa-now-p :na 35 40 nil 50 4)))                      ; (not seen: no own hit, not his turn)
(check (<= 4 *cai-xch-sa-wait* 8))                                   ; (the measured winning window)
(check (<= (getf *cai-awaken-break-p* :easy) (getf *cai-awaken-break-p* :normal) (getf *cai-awaken-break-p* :hard)))
(check (<= (getf *cai-awaken-kikon-p* :easy) (getf *cai-awaken-kikon-p* :normal) (getf *cai-awaken-kikon-p* :hard)))
;; the clash's reaction: never slower at a harder difficulty; NORMAL's in time for n3b's / the X's cut (f11: pressed by f10)
(check (>= (getf *cai-clash-delay* :easy) (getf *cai-clash-delay* :normal) (getf *cai-clash-delay* :hard)))
(check (< (getf *cai-clash-delay* :normal) (getf (mv-params (find-move :ic-k-n3b)) :hit-at)))

;; the arm key :XCH-J (DUEL_AI_STRATEGY §11.23): the J's share x k within 0-1, the AS the rest; no key: the difficulty's plist itself (EQ)
(let ((ws (getf *cai-xch-j* :hard)))
  (check (eq ws (xch-j-weights ws nil)))
  (check (and (~= 0.4 (getf (xch-j-weights ws 1.0) :j)) (~= 0.6 (getf (xch-j-weights ws 1.0) :as))))
  (check (and (~= 0.8 (getf (xch-j-weights ws 2.0) :j)) (~= 0.2 (getf (xch-j-weights ws 2.0) :as))))
  (check (and (~= 1.0 (getf (xch-j-weights ws 5.0) :j)) (~= 0.0 (getf (xch-j-weights ws 5.0) :as))))   ; (clamped: all J)
  (check (eq :as (xch-j-answer 0.99 (xch-j-weights ws 0.0) t)))                                       ; (k 0: always the AS)
  (check (eq :j (xch-j-answer 0.01 (xch-j-weights ws 3.0) t)))
  (check (equal '(:as 0.0 :j 0.0) (xch-j-weights '(:as 0.0 :j 0.0) 2.0)))                                ; (no weight: unchanged)
  ;; EASY <= NORMAL <= HARD on the J's share under any one k
  (dolist (k '(0.0 0.5 1.0 1.5 3.0))
    (flet ((j (d) (getf (xch-j-weights (getf *cai-xch-j* d) k) :j)))
      (check (<= (j :easy) (j :normal) (j :hard))))))
