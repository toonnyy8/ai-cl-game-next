;; ================================================================ the in-game MCTS's light model (duel/lisp/mcts-lite.lisp, DUEL_AI_TEACHER §9)
(in-package :duel)
(setf *core-on* t)
(let* ((kk (kit :kenpachi :base)) (ik (kit :ichigo :base))
       (kj1 (mc-move-rec kk (kit-command-move kk :q))) (kns (mc-move-rec kk (kit-core-move kk :ns 1)))
       (ij1 (mc-move-rec ik (kit-command-move ik :q))) (ins1 (mc-move-rec ik (kit-core-move ik :ns 1)))
       (getsuga (mc-move-rec ik (kit-move ik :ic-n2c))))
  ;; records: frames and classes from the kit; Ichigo's NS2 third segment (GETSUGA JUJISHO) a wave
  (check (= (aref kj1 +r-s+) (mv-s (kit-command-move kk :q))))
  (check (and (= (aref kj1 +r-cls+) 1) (= (aref kns +r-cls+) 2) (= (aref ins1 +r-cls+) 2)))
  (check (and (plusp (aref getsuga +r-wave-v+)) (plusp (aref getsuga +r-wave-range+))))
  (check (eq (mc-move-rec kk (kit-command-move kk :q)) kj1))   ; (cached)
  (labels ((setup (dist opp-kind opp-t opp-len &optional opp-move)
             ;; side 0 Kenpachi, side 1 Ichigo, both at the base form's outcome values
             (fill *mc-slots* nil)
             (setf (svref *mc-slots* 0) kj1 (svref *mc-slots* 1) kns
                   (svref *mc-slots* 8) ij1 (svref *mc-slots* 9) ins1 (svref *mc-slots* 10) opp-move)
             (loop for v in (mc-outcomes-of :kenpachi :base) for i from 0 do (setf (aref (svref *mc-vals* 0) i) (round (* 1000 v))))
             (loop for v in (mc-outcomes-of :ichigo :base) for i from 0 do (setf (aref (svref *mc-vals* 1) i) (round (* 1000 v))))
             (mc-init-fighter (svref *mc-i* 0) +k-free+ 0 0 350 73 1 0)
             (mc-init-fighter (svref *mc-i* 1) opp-kind opp-t opp-len 350 70 1 0)
             (setf (aref *mc-g* 0) dist (aref *mc-g* 1) 350 (aref *mc-g* 3) 60 (aref *mc-g* 4) 14 (aref *mc-g* 5) 700 (aref *mc-g* 6) 500)
             (loop for x in *mc-prior* for i from 0 do (setf (aref *mc-w* i) x))
             (fill *mc-legal* 1) (fill *mc-legal2* 1)
             (mc-seed 12345))
           (val (o) (aref (svref *mc-vals* 0) o)))
    ;; a reeling opponent at 1.5 m: Kenpachi's J1 lands before he can act, worth exactly the NA hit
    (setup 1500 +k-reel+ 0 60)
    (check (= (mc-rollout 0 -1) (val +o-na+)))
    ;; he is lying (invulnerable) through the horizon: nothing connects
    (setup 1500 +k-lie+ 0 90)
    (check (and (zerop (mc-rollout 0 -1)) (zerop (mc-rollout 1 -1))))
    ;; his NS segment's startup (frame 0) at 1.2 m: Kenpachi's J1 (NA) meets it first: the triangle's cancel, 0
    (setup 1200 +k-move+ 0 (aref ins1 +r-end+) ins1)
    (check (< (aref kj1 +r-from+) (aref ins1 +r-from+)))
    (check (zerop (mc-rollout 0 -1)))
    ;; his J1 (NA) 5 frames before its window: Kenpachi's Hoho now is perfect: the counter's value
    (setup 1200 +k-move+ (max 0 (- (aref ij1 +r-from+) 5)) (aref ij1 +r-end+) ij1)
    (check (= (mc-rollout 2 -1) (val +o-counter+)))
;; she waits with her Hoho ready and always answers (react 1000): Kenpachi's J1 at 1.2 m meets her perfect Hoho: minus her counter
    (setup 1200 +k-wait+ 0 60)
    (setf (aref *mc-g* 1) 1000)
    (check (= (mc-rollout 0 -1) (- (aref (svref *mc-vals* 1) +o-counter+))))
        ;; the same seed gives the same values (the search is deterministic)
    (setup 2500 +k-free+ 0 0)
    (mc-search 60)
    (let ((n (copy-seq *mc-n*)) (sum (copy-seq *mc-sum*)))
      (setup 2500 +k-free+ 0 0)
      (mc-search 60)
      (check (and (equalp n *mc-n*) (equalp sum *mc-sum*)))
      (check (= (reduce #'+ n) 60))
      (check (every #'plusp n)))))
;; the selection modes (decoupled UCT, regret matching): each plays every rollout, the same seed the same values
(let* ((kk (kit :kenpachi :base)) (ik (kit :ichigo :base)))
  (dolist (mode '(:duct :rm :deep))
    (let ((*mc-select* mode) (runs nil))
      (dotimes (k 2)
        (fill *mc-slots* nil)
        (setf (svref *mc-slots* 0) (mc-move-rec kk (kit-command-move kk :q)) (svref *mc-slots* 1) (mc-move-rec kk (kit-core-move kk :ns 1))
              (svref *mc-slots* 8) (mc-move-rec ik (kit-command-move ik :q)) (svref *mc-slots* 9) (mc-move-rec ik (kit-core-move ik :ns 1)))
        (mc-init-fighter (svref *mc-i* 0) +k-free+ 0 0 350 73 1 0)
        (mc-init-fighter (svref *mc-i* 1) +k-free+ 0 0 350 70 1 0)
        (setf (aref *mc-g* 0) 2500 (aref *mc-g* 1) 20 (aref *mc-g* 3) 60 (aref *mc-g* 4) 14 (aref *mc-g* 5) 700 (aref *mc-g* 6) 500)
        (loop for x in *mc-prior* for i from 0 do (setf (aref *mc-w* i) x))
        (fill *mc-legal* 1) (fill *mc-legal2* 1) (mc-seed 777)
        (mc-search 60)
        (push (list (copy-seq *mc-n*) (copy-seq *mc-sum*)) runs))
      (check (equalp (first runs) (second runs)))
      (check (= (reduce #'+ (first (first runs))) 60)))))
;; a J1 into a raised guard ends at the block's value (blocks going on, *MC-BLOCK-CONT*, off: g 7 = 0)
(let* ((kk (kit :kenpachi :base)) (ik (kit :ichigo :base)))
  (fill *mc-slots* nil)
  (setf (svref *mc-slots* 0) (mc-move-rec kk (kit-command-move kk :q)) (svref *mc-slots* 8) (mc-move-rec ik (kit-command-move ik :q)))
  (loop for v in (mc-outcomes-of :kenpachi :base) for i from 0 do (setf (aref (svref *mc-vals* 0) i) (round (* 1000 v))))
  (mc-init-fighter (svref *mc-i* 0) +k-free+ 0 0 350 73 1 0)
  (mc-init-fighter (svref *mc-i* 1) +k-guard+ 4 60 350 70 0 0)
  (fill *mc-g* 0) (setf (aref *mc-g* 0) 1200 (aref *mc-g* 3) 60 (aref *mc-g* 4) 14) (mc-seed 5)
  (check (= (mc-rollout 0 -1) (aref (svref *mc-vals* 0) +o-block+))))
