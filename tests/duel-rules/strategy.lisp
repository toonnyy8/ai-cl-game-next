;; ================================================================ strategies as data (duel/lisp/strategy.lisp, DUEL_AI_STRATEGY §2)
(in-package :duel)
(let ((st '(:id :t1 :base (:range 1.0 :b-j1 0.0)
            :rules ((((:dj :in)) (:b-j1 0.2 :ns 0.9))
                    (((:dj :afar) (:ost :free)) (:range 0.7))))))
  ;; a rule that holds answers; no rule: the base; neither names the key: NIL (the CPU's own value)
  (check (~= 0.2 (strat-value st :b-j1 '(:dj 0.5))))
  (check (~= 0.0 (strat-value st :b-j1 '(:dj 3.0))))
  (check (~= 0.7 (strat-value st :range '(:dj 3.0 :ost 0))))
  (check (~= 1.0 (strat-value st :range '(:dj 3.0 :ost 2))))
  (check (null (strat-value st :hoho '(:dj 0.5))))
  ;; halfway on a slope: weighted toward the base? no: one rule firing at any strength gives its value alone
  (check (~= 0.9 (strat-value st :ns '(:dj 0.9))))
  ;; no active strategy: the CPU's own value, and a chance unchanged
  (check (and (= 0.3 (strat-out nil :ns 0.3)) (= 0.3 (strat-scale nil :hoho 0.3))))
  (let ((now (cons '(:base (:hoho 2.0 :ns 0.1)) nil)))
    (check (and (~= 0.1 (strat-out now :ns 0.3)) (~= 0.6 (strat-scale now :hoho 0.3)) (~= 1.0 (strat-scale now :hoho 0.7)))))
  ;; fingerprints: a strategy is the same as itself, and a changed output lowers the similarity
  (let* ((grid '((:dj 0.5) (:dj 3.0 :ost 0) (:dj 1.1 :ost 2))) (keys '(:b-j1 :range :ns))
         (fa (strat-fingerprint st keys grid))
         (fb (strat-fingerprint '(:base (:range 1.0 :b-j1 0.0) :rules ((((:dj :in)) (:b-j1 0.2 :ns 0.9)))) keys grid)))
    (check (~= 1.0 (strat-similarity fa fa)))
    (check (< 0.5 (strat-similarity fa fb) 1.0))))

;; the strategy layer's pure parts (DUEL_AI_STRATEGY §5, §8.4): arms by :APPLY, seeds from the payoff matrix (B's view 1 - M transposed), PUCT, the pick
(check (equal '(:s0-generic :s1-brawler :s3-zoner :ki-ken :q1-ken-ichigo :qks-ichigo :qks2-ichigo :qks3-ichigo) (mapcar (lambda (s) (getf s :id)) (strat-arms :kenpachi :ichigo))))   ; (+ §8.18's table, as IK's q1; §8.19 round 4's)
(check (equal '(:s0-generic :s1-brawler :s3-zoner :q1-ken-hisagi :qks-hisagi :qks2-hisagi :qks3-hisagi :qks4-hisagi :qks5-hisagi) (mapcar (lambda (s) (getf s :id)) (strat-arms :kenpachi :hisagi))))
(check (~= 0.7 (strat-seed-value :kenpachi :ichigo :ki-ken)))           ; (against her equilibrium column, :ki-ichigo)
(check (~= 0.3 (strat-seed-value :ichigo :kenpachi :ki-ichigo)))        ; (the column side: 1 - his equilibrium row's cell)
(check (~= 0.0 (strat-seed-value :ichigo :kenpachi :s0-generic)))       ; (her s0 against his equilibrium row :ki-ken: 1 - 1.0)
(check (~= 0.5 (strat-seed-value :ichigo :ichigo :s0-generic)))         ; (no matrix for the mirror)
(check (= 0 (strat-puct (vector 3.0 2.0) (vector 4.0 4.0) (vector 0.5 0.5) 1.0)))     ; (the better mean, equal visits)
(check (= 1 (strat-puct (vector 3.0 0.0) (vector 4.0 0.0) (vector 0.5 0.5) 1.0)))     ; (an unvisited arm is tried)
(check (= 0 (strat-final (vector 3.0 2.0) (vector 4.0 4.0) (vector 0.2 0.8) 0.0)))    ; (HARD-like: the values)
(check (= 1 (strat-final (vector 3.0 2.0) (vector 4.0 4.0) (vector 0.2 0.8) 1.0)))    ; (all prior)
(check (~= 1.5 (strat-prior (second *strat-library*) '(:lead -3 :or 0.9))))  ; (the brawler behind on Konpaku)
;; the lookup (DUEL_AI_STRATEGY §8.6): HARD only, every entry names a library strategy
(check (eq :qhs3-ichigo (getf (strat-lookup :hisagi :ichigo :hard) :id)))   ; (§8.19 round 4: the learnable Shikai preference; the older tables stay)
(let* ((fq (getf (strat-lookup :hisagi :ichigo :hard) :fq))               ; (press wins in the Shikai by less than 0.1 here: not a +1.0 pin)
       (fs '(:lead 0 :ored 0 :ost 0 :awk 0 :prev 0 :form 0 :dm 2.0 :gauge 0.0 :wall 9.0 :oawk 0)) (q (strat-fq-q fq fs)))
  (check (= 0 (strat-fq-pick fq fs)))
  (check (< (- (svref q 0) (reduce #'max (subseq q 1))) 0.1))
  (check (= 448 (length (fq-encode fq fq 0)))))
(let ((fq (getf (find :qhs-ichigo *strat-library* :key (lambda (st) (getf st :id))) :fq)))   ; (the pilot: six arms, the last aimed at Ichigo, kept state)
  (check (= 6 (length (getf fq :arms))))
  (check (eq :a-ken-ki (getf (sixth (getf fq :arms)) :id)))                ; (the arm aimed at Ichigo: Kenpachi's KI style code, a unit since §10)
  (check (and (eql 30 (getf fq :period)) (getf fq :keep-state) (getf fq :xfeats) (eql 0.966 (getf fq :gamma)))))
(let ((fq (getf (find :qhs2-ichigo *strat-library* :key (lambda (st) (getf st :id))) :fq)))   ; (round 2's refit: five arms, four general then one aimed at Ichigo; 89 rules in
  (check (= 5 (length (getf fq :arms))))                                  ;  5 groups; 0.5 s; no kept state, no s3-zoner)
  (check (eq :a-hisagi-pressd (getf (first (getf fq :arms)) :id)))
  (check (eq :a-ken-ki (getf (fifth (getf fq :arms)) :id)))
  (check (every (lambda (a) (equal (getf a :apply) '(:hisagi))) (butlast (getf fq :arms))))
  (check (notany (lambda (a) (eq (getf a :id) :a-zoner)) (getf fq :arms)))
  (check (= 89 (length (getf fq :rules)) (reduce #'+ (getf fq :groups))))
  (check (every (lambda (r) (= 6 (length r))) (getf fq :rules)))
  (check (and (eql 30 (getf fq :period)) (not (getf fq :keep-state)) (getf fq :xfeats) (eql 0.98 (getf fq :gamma))))
  (check (= 0 (strat-fq-pick fq '(:lead 0 :ored 0 :ost 0 :awk 0 :prev 3 :form 0 :dm 2.0 :gauge 0.0 :wall 9.0 :oawk 0))))   ; (the Shikai: arm 0, pinned)
  (let ((codes (fq-encode fq fq 3)))
    (check (= 448 (length codes)))                                        ; (the page's online copy: 3 + 5 x 89 integers)
    (check (equal (getf fq :rules) (getf (fq-decode codes fq) :rules)))))   ; (read back equal)
(check (null (strat-lookup :hisagi :ichigo :normal)))                  ; (EASY / NORMAL keep their designed strength)
(check (eq :qis-hisagi (getf (strat-lookup :ichigo :hisagi :hard) :id)))   ; (§8.19 round 5; before it §8.18: a table whose arm 0 is round 1's :ki-ichigo, §8.8)
(check (eq :qhs-ken (getf (strat-lookup :hisagi :kenpachi :hard) :id)))      ; (§8.19 round 5's co-refit; :qh-ken stays in the library)
(check (eq :qhs4-mirror (getf (strat-lookup :hisagi :hisagi :hard) :id)))   ; (§8.19 round 5 step 3; the older mirror tables stay in the library)
(let* ((fq (getf (strat-lookup :hisagi :hisagi :hard) :fq))               ; (ranged close: Kenpachi's KI style code, as the data put it, no pin:
       (fs '(:lead 0 :ored 0 :ost 0 :awk 1 :prev 1 :form 1 :dm 1.5 :gauge 0.0 :wall 9.0 :oawk 0)))   ;  「拿掉，照資料用 KI 風格」)
  (check (eq 'ken-ki-style (getf (nth (strat-fq-pick fq fs) (getf fq :arms)) :fn))))
(let ((fq (getf (strat-lookup :hisagi :hisagi :hard) :fq)))              ; (five arms: the kite first, four general, one KI style code; 89 rules)
  (check (= 5 (length (getf fq :arms))))
  (check (eq :a-hisagi-kite (getf (first (getf fq :arms)) :id)))
  (check (eq :a-ken-ki (getf (fifth (getf fq :arms)) :id)))
  (check (= 89 (length (getf fq :rules)) (reduce #'+ (getf fq :groups))))
  (check (and (eql 30 (getf fq :period)) (not (getf fq :keep-state)) (getf fq :xfeats) (eql 0.98 (getf fq :gamma))))
  (check (= 448 (length (fq-encode fq fq 0)))))
(dolist (id '(:qh-ichigo :qh-ken :qh-mirror))                           ; (arm 0 the merged style; ahead, free, no flags: arm 0)
  (let ((fq (getf (find id *strat-library* :key (lambda (st) (getf st :id))) :fq)))
    (check (eq 'hisagi-merged-style (getf (first (getf fq :arms)) :fn)))
    (check (= 48 (length (getf fq :rules))))
    (check (= 0 (strat-fq-pick fq '(:lead 99))))))
;; the library's units (DUEL_AI_STRATEGY §10): no cap; every unit id unique, every arm unit a different strategy, every
;; table's arms resolved (each once) and its rules one per antecedent of its rule base with a q per arm; *strat-picks* sized from the library
(let ((ids (mapcar (lambda (u) (getf u :id)) (append *strat-styles* *strat-data* *strat-units* *strat-rule-bases* *strat-library*))))
  (check (= (length ids) (length (remove-duplicates ids)))))
(let ((plays (mapcar (lambda (u) (loop for (k v) on u by #'cddr unless (member k '(:id :apply)) append (list k v))) *strat-units-expanded*)))
  (check (= (length plays) (length (remove-duplicates plays :test #'equal)))))
(dolist (st *strat-library*)
  (let ((fq (getf st :fq)))
    (when fq
      (let ((arms (getf fq :arms)))
        (check (every (lambda (a) (or (null a) (and (consp a) (getf a :id)))) arms))
        (check (= (length arms) (length (remove-duplicates arms :test #'eq))))
        (check (every (lambda (r) (= (length r) (1+ (length arms)))) (getf fq :rules)))
        (check (or (null (getf fq :groups)) (= (length (getf fq :rules)) (reduce #'+ (getf fq :groups)))))))))
(check (= (length *strat-picks*) (* 2 (length *strat-library*))))
(check (eq :q1-ichigo-ken (getf (strat-lookup :ichigo :kenpachi :hard) :id)))   ; (§8.19 round 5 step 3: back from :qis-ken, kept in the library)
(let ((fq (getf (find :qis-ken *strat-library* :key (lambda (st) (getf st :id))) :fq)))
  (check (and (= 5 (length (getf fq :arms))) (= 89 (length (getf fq :rules))) (eql 30 (getf fq :period))))
  (check (eq 'ken-ki-style (getf (first (getf fq :arms)) :fn)))
  (check (= 448 (length (fq-encode fq fq 0)))))
(let ((c (find :c1-ichigo-ken *strat-library* :key (lambda (st) (getf st :id)))))   ; (c1: her own style behind / on his red, else Kenpachi's)
  (check (eq 'ichigo-ki-style (getf (strat-judge c '(:ost 0 :lead -2)) :fn)))
  (check (eq 'ken-ki-style (getf (strat-judge c '(:ost 0 :lead 2 :ored 0)) :fn))))
;; the Q tables of §8.18: every pairing with Kenpachi or Ichigo as me plays one at HARD, keyed by :apply (the online learner's key); 48 crisp
;; rules over two arms; where the incumbent is the shipped CPU (no strategy) arm 0 is NIL (core-ai.lisp: no strategy, never the lookup)
;; §8.19 round 4: Kenpachi vs Ichigo / Hisagi play rebuilt tables (6 / 5 arms, arm 0 still NIL: no strategy; 89 rules in 5 groups; 0.5 s)
(dolist (r '((:kenpachi :ichigo :qks3-ichigo 6) (:kenpachi :hisagi :qks5-hisagi 8) (:kenpachi :kenpachi :qks-ken 5)))
  (destructuring-bind (me vs id na) r
    (let* ((st (strat-lookup me vs :hard)) (fq (getf st :fq)))
      (check (eq id (getf st :id)))
      (check (equal (list me vs) (getf st :apply)))
      (check (and (= na (length (getf fq :arms))) (null (first (getf fq :arms)))))
      (check (= 89 (length (getf fq :rules)) (reduce #'+ (getf fq :groups))))
      (check (and (eql 30 (getf fq :period)) (getf fq :xfeats) (not (getf fq :keep-state))))
      (check (= (+ 3 (* na 89)) (length (fq-encode fq fq 0)))))))
;; §8.19 round 5 step 4: Kenpachi vs Hisagi's table gains the joint KH / HK search's arm, Ichigo's KI style code (:a-ichigo-ki), as arm 5
(check (eq 'ichigo-ki-style (getf (nth 5 (getf (getf (strat-lookup :kenpachi :hisagi :hard) :fq) :arms)) :fn)))
;; §8.19 round 5 step 5: and the dream-rsi search's kept style code (cpu-kh-ken.lisp, the style unit :st-ken-kh) as arm 6
(check (eq 'ken-kh-style (getf (nth 6 (getf (getf (strat-lookup :kenpachi :hisagi :hard) :fq) :arms)) :fn)))
(check (eq 'ken-kh-style (getf (find :st-ken-kh *strat-styles* :key (lambda (u) (getf u :id))) :fn)))
(dolist (id '(:q1-ken-ichigo :q1-ken-hisagi :q1-ken-ken))              ; (§8.18's three, out of the lookup since §8.19 round 4, kept in the library)
  (let ((fq (getf (find id *strat-library* :key (lambda (st) (getf st :id))) :fq)))
    (check (and (= 2 (length (getf fq :arms))) (= 48 (length (getf fq :rules)))))))
(let* ((st (strat-lookup :ichigo :hisagi :hard)) (fq (getf st :fq)))   ; (§8.19 round 5: Ichigo vs Hisagi's rebuilt table, 5 arms, learnable prior)
  (check (eq :qis-hisagi (getf st :id)))
  (check (equal '(:ichigo :hisagi) (getf st :apply)))
  (check (and (= 5 (length (getf fq :arms))) (= 89 (length (getf fq :rules)) (reduce #'+ (getf fq :groups)))))
  (check (eq 'ken-ki-style (getf (nth (strat-fq-pick fq '(:lead 0 :ored 0 :ost 0 :awk 0 :prev 1 :form 0 :dm 2.0 :gauge 0.0 :wall 9.0 :oawk 0)) (getf fq :arms)) :fn)))
  (check (= 448 (length (fq-encode fq fq 0)))))
(let ((fq (getf (find :q1-ichigo-hisagi *strat-library* :key (lambda (st) (getf st :id))) :fq)))   ; (§8.18's, kept in the library)
  (check (and (= 2 (length (getf fq :arms))) (= 48 (length (getf fq :rules))))))
(dolist (r '((:ichigo :ichigo :q1-ichigo-ichigo t)))
  (destructuring-bind (me vs id nil0) r
    (let* ((st (strat-lookup me vs :hard)) (fq (getf st :fq)))
      (check (eq id (getf st :id)))
      (check (equal (list me vs) (getf st :apply)))
      (check (and (= 2 (length (getf fq :arms))) (= 48 (length (getf fq :rules)))))
      (check (eq nil0 (null (first (getf fq :arms)))))
      (check (null (strat-lookup me vs :normal))))))
(check (eq 'ichigo-ki-style (getf (second (getf (getf (strat-lookup :kenpachi :ichigo :hard) :fq) :arms)) :fn)))   ; (KI's arm 1: the whole-game replacement, still in :qks-ichigo)
(check (every (lambda (r) (and (eq (third r) :hard) (strat-lookup (first r) (second r) (third r)))) *strat-lookup*))
;; a composite (DUEL_AI_STRATEGY §8.7): the first entry whose OWN fires at >= 0.5, else :ELSE, else NIL; OR across antecedents, AND within
(let* ((a '(:id :a)) (b '(:id :b)) (c '(:id :c))
       (sw (list :id :sw :switch (list (cons '(((:lead :behind) (:mr :low))) a) (cons '(((:lead :even) (:dj :in)) ((:lead :ahead))) b)))))
  (check (eq a (strat-judge sw '(:lead -5 :mr 0.1 :dj 9))))                       ; (behind and low)
  (check (eq b (strat-judge sw '(:lead 5 :mr 0.9 :dj 9))))                        ; (the OR's second antecedent)
  (check (null (strat-judge sw '(:lead -5 :mr 0.9 :dj 9))))                       ; (behind, not low; no :else)
  (check (= 1 (nth-value 1 (strat-judge sw '(:lead 0 :dj 0.5)))))                 ; (even and in range)
  (check (= -1 (nth-value 1 (strat-judge sw '(:lead -5 :mr 0.9 :dj 9)))))
  (check (eq a (strat-judge sw '(:lead -5 :mr 0.1 :dj 9))))
  (check (eq c (strat-judge (append sw (list :else c)) '(:lead -5 :mr 0.9 :dj 9))))   ; (:else)
  (check (eq a (strat-judge (append sw (list :else c)) '(:lead -5 :mr 0.1))))          ; (an entry before :else)
  (check (null (strat-judge '(:switch (((((:lead :ahead) (:lead :behind))) . (:id :n)))) '(:lead 5)))))   ; (an OWN that never fires)
;; a fuzzy Q selector (DUEL_AI_STRATEGY §8.12): Q = the rules' q averaged by firing strength, the arm = argmax (ties: the first), :MARGIN keeps :PREV
(let* ((a '(:id :a)) (b '(:id :b))
       (fq (list :arms (list a b) :rules '((((:mr :low)) 1.0 0.0) (((:mr :high)) 0.0 2.0) (() 0.5 0.5)))))
  (check (equalp #(0.75 0.25) (strat-fq-q fq '(:mr 0.1))))                          ; (low at 1, the empty antecedent at 1)
  (check (equalp #(0.25 1.25) (strat-fq-q fq '(:mr 0.9))))
  (check (~= 0.6666667 (svref (strat-fq-q fq '(:mr 0.375)) 0)))                     ; (low at 0.5: (0.5 + 0.5) / 1.5)
  (check (= 0 (strat-fq-pick fq '(:mr 0.1))))
  (check (= 1 (strat-fq-pick fq '(:mr 0.9))))
  (check (= 0 (strat-fq-pick (list :arms (list a b) :rules '((((:mr :low)) 1.0 1.0))) '(:mr 0.1))))   ; (a tie: the first)
  (check (= 0 (strat-fq-pick (list :arms (list a b) :rules '((((:mr :low)) 0.0 1.0))) '(:mr 0.9))))   ; (none fires: arm 0)
  (check (= 0 (strat-fq-pick (append fq '(:margin 1.5)) '(:mr 0.9 :prev 0))))   ; (b leads by 1 < the margin: kept)
  (check (= 1 (strat-fq-pick (append fq '(:margin 0.5)) '(:mr 0.9 :prev 0))))
  (check (= 1 (strat-fq-pick (list :arms (list a b) :rules '((((:prev :yes)) 0.0 1.0) (((:prev :no)) 1.0 0.0))) '(:prev 1))))
  (multiple-value-bind (st k) (strat-judge (list :id :q :fq fq) '(:mr 0.9)) (check (and (eq st b) (= k 1)))))
;; a crisp partition reproduces the composite c1 on every state of its cues (the Q selector's start, docs/research/strategy-drsi/fq/)
(let* ((c (find :c1-ichigo-ken *strat-library* :key (lambda (st) (getf st :id))))
       (fq (list :arms (list (getf c :else) (cdr (first (getf c :switch))))
                 :rules '((((:ost :free) (:lead :behind)) 0.0 1.0) (((:ost :free) (:lead :even) (:ored :yes)) 0.0 1.0)
                          (((:ost :free) (:lead :ahead) (:ored :yes)) 0.0 1.0) (((:ost :free) (:lead :even) (:ored :no)) 1.0 0.0)
                          (((:ost :free) (:lead :ahead) (:ored :no)) 1.0 0.0) (((:ost :busy)) 1.0 0.0)))))
  (check (loop for lead from -9 to 9 always
           (loop for ored in '(0 1) always
             (loop for ost from 0 to 4 always
               (let ((ft (list :lead lead :ored ored :ost ost)))
                 (eq (strat-judge c ft) (strat-judge (list :fq fq) ft))))))))
;; the online fuzzy Q against a human (DUEL_AI_STRATEGY §8.14): transitions, the TD update by firing strength, the clamp, the page round trip
(let* ((base (list :arms '((:id :a) (:id :b)) :rules (list (list '((:mr :low)) 0.1 0.2) (list '((:mr :high)) 0.3 0.0))))
       (f0 (strat-fq-fire base '(:mr 0.1))) (f1 (strat-fq-fire base '(:mr 0.9))) (fh (vector 0.75 0.25)))
  (check (equalp #(1.0 0.0) f0))
  (let ((w (strat-fq-fire (list :rules (list (list '((:mr :low)) 0.0) (list '() 0.0))) '(:mr 0.375))))   ; (low at 0.5, the empty one at 1)
    (check (and (~= (/ 1 3.0) (svref w 0)) (~= (/ 2 3.0) (svref w 1)))))
  (check (every #'zerop (strat-fq-fire (list :rules (list (list '((:mr :low)) 1.0))) '(:mr 0.9))))   ; (none fires: all 0)
  ;; r = scale x the balance's change to the next judgement; the last: to the end's, plus the result
  (let ((tr (fq-transitions (list (list f0 0 1.0) (list f1 1 1.5)) 0.5 -1.0 0.1)))
    (check (and (= 2 (length tr)) (~= 0.05 (third (first tr))) (eq f1 (fourth (first tr)))))
    (check (and (~= -1.1 (third (second tr))) (null (fourth (second tr))) (= 1 (second (second tr))))))
  (check (null (fq-transitions nil 0.0 1.0)))
  ;; one step: delta = r + gamma V(s') - Q(s, a) = 0.05 + 0.9 x 0.3 - 0.1 = 0.22; q += eta x alpha x delta, the rest untouched
  (let ((fq (copy-tree base)))
    (fq-td-update! fq base (list (list f0 0 0.05 f1)) :eta 0.5 :gamma 0.9 :cap 1.0)
    (check (~= 0.21 (second (first (getf fq :rules))) 1e-5))
    (check (equal (rest (second (getf fq :rules))) '(0.3 0.0)))
    (check (= 0.2 (third (first (getf fq :rules))))))
  ;; the clamp: a huge reward moves q only to the offline value + cap (and - cap the other way)
  (let ((fq (copy-tree base)))
    (fq-td-update! fq base (list (list f0 1 50.0 nil) (list f0 1 50.0 nil)) :eta 0.5 :cap 0.05)
    (check (~= 0.25 (third (first (getf fq :rules))) 1e-5))
    (fq-td-update! fq base (list (list f1 0 -50.0 nil)) :eta 0.5 :cap 0.05)
    (check (~= 0.25 (second (second (getf fq :rules))) 1e-5)))
  ;; a no-op match (no judgement) leaves the table equal; so does a transition whose delta is 0
  (let ((fq (copy-tree base)))
    (fq-td-update! fq base nil)
    (check (equal fq base))
    (fq-td-update! fq base (list (list f1 0 0.3 nil)))                                 ; (delta = 0.3 - 0.3)
    (check (equal fq base)))
  ;; split firing: each rule moves by its share
  (let ((fq (copy-tree base)) (x (svref fh 0)))
    (fq-td-update! fq base (list (list fh 0 1.0 nil)) :eta 0.1 :cap 1.0)
    (let ((d (- 1.0 (+ (* x 0.1) (* (- 1 x) 0.3)))))
      (check (~= (+ 0.1 (* 0.1 x d)) (second (first (getf fq :rules))) 1e-4))
      (check (~= (+ 0.3 (* 0.1 (- 1 x) d)) (second (second (getf fq :rules))) 1e-4))))
  ;; the page: format, the offline table's checksum, the matches, every q; read back equal; another offline table or format: none
  (let ((fq (copy-tree base)))
    (fq-td-update! fq base (list (list fh 0 1.0 f1) (list f1 1 -0.4 nil)))
    (let ((codes (fq-encode fq base 7)))
      (check (= (+ 3 4) (length codes)))
      (multiple-value-bind (back n) (fq-decode codes base)
        (check (and (equal back fq) (= n 7))))
      (check (null (fq-decode codes fq)))                                              ; (saved from another offline table)
      (check (null (fq-decode (cons 99 (rest codes)) base)))
      (check (null (fq-decode nil base)))
      (check (null (fq-decode (butlast codes) base))))))
;; the shipped table: its copy decodes from its own encoding, and the library entry is never written by an update of a copy
(let* ((lib (find :q1-ichigo-ken *strat-library* :key (lambda (st) (getf st :id)))) (base (getf lib :fq)) (keep (copy-tree base))
       (fq (copy-tree base)) (f (strat-fq-fire base '(:lead -1 :ored 0 :ost 0 :awk 0 :prev 0))))
  (check (= 1 (count-if #'plusp f)))                                                   ; (crisp: one rule fires)
  (fq-td-update! fq base (list (list f 0 -2.0 nil)))
  (check (and (equal base keep) (not (equal fq base))))
  (check (equal fq (fq-decode (fq-encode fq base 1) base))))

;; the CPU's DRIVE switch (DUEL_AI_STRATEGY §8.16): the target by an explicit pointer or the openers' bands, the stick's sign
(let ((bk '((0.0 3.4) (2.5 4.55)))                                      ; (Hisagi's Bankai: WA 0-3 + slack, TABA 2.5-4.15 + slack)
      (sh '((3.6 6.6) (0.0 2.4) (0.0 4.9))))                            ; (a three-pointer kit)
  (check (eql 2 (strat-switch-to 1 2 4.5 bk 2)))                        ; (WA pushed him to 4.5: TABA reaches)
  (check (null (strat-switch-to 1 2 1.5 bk 2)))                         ; (WA whiffed, he is close: TABA's dead zone)
  (check (null (strat-switch-to 2 2 3.0 bk 2)))                         ; (the pointer he is on is no target)
  (check (eql 2 (strat-switch-to 1 2 3.0 bk)))                          ; (no map: the next pointer that reaches)
  (check (eql 3 (strat-switch-to 1 3 4.5 sh)))                          ; (the next, 2, does not reach; 3 does)
  (check (eql 2 (strat-switch-to 3 3 2.0 sh)))                          ; (cyclic: from 3 the next is 1 (no), then 2)
  (check (null (strat-switch-to 1 3 7.0 sh)))
  (check (= 1 (strat-switch-dir 1 2 2)))
  (check (= 1 (strat-switch-dir 2 1 2)))
  (check (= 1 (strat-switch-dir 3 1 3)))
  (check (= -1 (strat-switch-dir 1 3 3))))
(check (member :h1-range (mapcar (lambda (s) (getf s :id)) (strat-arms :hisagi :ichigo))))   ; (:apply (:hisagi): against anyone)
;; an additive Q selector (:GROUPS, DUEL_AI_STRATEGY §8.19): each group averaged on its own, Q their sum; a group with no rule firing adds 0;
;; the firing vector normalised per group, so FQ-Q-AT gives the same sum (the online learner sees the runtime's Q)
(let ((fq (list :arms '(a b) :groups '(2 2)
                :rules (list (list '((:mr :low)) 1.0 0.0) (list '((:mr :high)) 0.0 1.0)            ; (group 0)
                             (list '((:dm :m-close)) 0.0 0.5) (list '((:dm :m-far)) 0.25 0.0)))))  ; (group 1)
  (check (equalp #(1.0 0.5) (strat-fq-q fq '(:mr 0.1 :dm 2.0))))
  (check (equalp #(1.25 0.0) (strat-fq-q fq '(:mr 0.1 :dm 9.0))))
  (check (equalp #(1.0 0.0) (strat-fq-q fq '(:mr 0.1 :dm 4.0))))                ; (mid: group 1 silent)
  (check (= 1 (strat-fq-pick fq '(:mr 0.9 :dm 2.0))))
  (let ((w (strat-fq-fire fq '(:mr 0.1 :dm 3.15))))                               ; (close and mid half way: close 0.5, far 0)
    (check (equalp #(1.0 0.0 1.0 0.0) w))
    (check (~= 0.5 (fq-q-at fq w 1)))
    (check (~= 1.0 (fq-v-at fq w)))))                                            ; (max_a Q = 1.0, not the per-group maxima's 1.0 + 0.5)                                         ; (= STRAT-FQ-Q: 0.0 + 0.5)
;; a grouped table whose extra groups are all 0 plays the shipped table: Hisagi vs Ichigo's 48 rules + 3 more groups, on every crisp cell
(let* ((ship (getf (find :qh-ichigo *strat-library* :key (lambda (st) (getf st :id))) :fq))
       (rules (append (mapcar (lambda (r) (append r (list (- (reduce #'min (rest r)) 1.0)))) (getf ship :rules))
                      (list (list '((:form :no) (:dm :m-close)) 0.0 0.0 0.0) (list '((:form :yes) (:dm :m-close)) 0.0 0.0 0.0)
                            (list '((:gauge :g-high)) 0.0 0.0 0.0) (list '((:wall :w-near)) 0.0 0.0 0.0))))
       (g (list :arms '(a b c) :groups '(48 2 1 1) :xfeats t :keep-state t :period 30 :rules rules)))
  (check (loop for lead in '(-1 0 1) always
           (loop for ored in '(0 1) always
             (loop for ost in '(0 2) always
               (loop for awk in '(0 1) always
                 (loop for prev in '(0 1) always
                   (let ((fs (list :lead lead :ored ored :ost ost :awk awk :prev prev :form 1 :dm 2.0 :gauge 0.5 :wall 1.0)))
                     (= (strat-fq-pick ship fs) (strat-fq-pick g fs))))))))))
;; §8.19 round 5 step 5: Kenpachi's style code against Hisagi (duel/lisp/cpu-kh-ken.lisp, KEN-KH-STYLE). Off by default: the file holds only
;; definitions (no CAI-DEFSTYLE or any other top-level call that would register it), KEN-KH-STYLE takes the :fn contract's six arguments,
;; and every difficulty plist of chances it defines (values within 0-1; a threshold in frames may fall) rises EASY <= NORMAL <= HARD.
(dolist (ff '(("cpu-kh-ken" ken-kh-style) ("cpu-hk-hisagi" hisagi-hk-style)))   ; (a style file the hkfn search keeps joins this list, DUEL_AI_STRATEGY §8.19 step 7)
 (let ((forms (with-open-file (in (merge-pathnames (format nil "../../duel/lisp/~a.lisp" (first ff)) *load-truename*))
               (let ((*package* (find-package :duel))) (loop for x = (read in nil in) until (eq x in) collect x)))))
  (check (every (lambda (x) (member (car x) '(in-package defparameter defvar defconstant defun defmacro defstruct inline-readers))) forms))
  (check (find-if (lambda (x) (and (eq (car x) 'defun) (eq (second x) (second ff)) (= 6 (length (third x))))) forms))
  (dolist (x forms)
    (let ((v (and (eq (car x) 'defparameter) (third x))))
      (when (and (consp v) (eq (car v) 'quote) (consp (second v)) (eq (car (second v)) :easy))
        (let ((p (second v)))
          (when (every (lambda (k) (let ((x (getf p k))) (and (realp x) (<= 0 x 1)))) '(:easy :normal :hard))
            (check (<= (getf p :easy) (getf p :normal) (getf p :hard))))))))))
;; §8.19 round 5 step 6: the event layer's window (STRAT-EVENT-ARM; strategy-glue.lisp STRAT-EVENT-STEP keeps LAST in the brain). It fires when the
;; opponent is perceived down (launched / down / waking up), holds the brain's perception delay + *STRAT-EVENT-GRACE* frames after, then hands
;; back; a table without :EVENT-ARMS never fires (and leaves LAST alone).
(let* ((arm '(:id :ev-test :fn ken-kh-style)) (fq (list :arms '(nil) :event-arms (list (list :knockdown arm)))) (delay 8))
  (multiple-value-bind (on last) (strat-event-arm fq :idle 100 -1 delay) (check (and (null on) (= last -1))))      ; (never down: off)
  (multiple-value-bind (on last) (strat-event-arm fq :down 100 -1 delay) (check (and (eq on arm) (= last 100))))  ; (knocked down: fires)
  (multiple-value-bind (on last) (strat-event-arm fq :wakeup 130 100 delay) (check (and (eq on arm) (= last 130))))   ; (waking up: holds)
  (multiple-value-bind (on last) (strat-event-arm fq :idle (+ 130 delay *strat-event-grace*) 130 delay) (check (and (eq on arm) (= last 130))))
  (multiple-value-bind (on last) (strat-event-arm fq :idle (+ 131 delay *strat-event-grace*) 130 delay) (check (and (null on) (= last 130))))   ; (hands back)
  (multiple-value-bind (on last) (strat-event-arm fq :hoho 50 130 delay) (check (and (null on) (= last -1))))    ; (a tick from an earlier match)
  (multiple-value-bind (on last) (strat-event-arm '(:arms (nil)) :down 100 -1 delay) (check (and (null on) (= last -1)))))   ; (no key: nothing)
;; and a library table's :EVENT-ARMS ids expand to their units' plists (STRAT-EXPAND)
(let ((st (strat-expand '(:id :ev-x :fq (:arms (nil :a-ken-ki) :rules ((((:lead :even)) 0.0 0.0)) :event-arms ((:knockdown :a-ken-kh)))))))
  (check (eq 'ken-kh-style (getf (second (assoc :knockdown (getf (getf st :fq) :event-arms))) :fn))))
;; §8.19 round 5 step 6: the stand-off breaker is its own style unit and arm (cpu-kh-ken.lisp KEN-KH-STANDOFF-STYLE)
(check (eq 'ken-kh-standoff-style (getf (strat-arm :a-ken-kh-standoff) :fn)))
;; and Kenpachi vs Hisagi's table since step 6 (step 7: the no-refit :qks5-hisagi, whose q are :qks3-hisagi's + the stand-off column): the stand-off breaker as arm 7, the bait as its :KNOCKDOWN event layer (no other table has one)
(let ((fq (getf (strat-lookup :kenpachi :hisagi :hard) :fq)))
  (check (eq 'ken-kh-standoff-style (getf (nth 7 (getf fq :arms)) :fn)))
  (check (eq 'ken-kh-style (getf (second (assoc :knockdown (getf fq :event-arms))) :fn))))
(check (= 1 (count-if (lambda (st) (getf (getf st :fq) :event-arms)) (mapcar (lambda (r) (strat-lookup (first r) (second r) :hard)) *strat-lookup*))))
;; §8.19 round 5 step 7: :qks5-hisagi = :qks3-hisagi's q with the stand-off arm's column 1 below every row (so it never leads)
(let ((q5 (getf (find :qks5-hisagi *strat-library* :key (lambda (st) (getf st :id))) :fq))
      (q3 (getf (find :qks3-hisagi *strat-library* :key (lambda (st) (getf st :id))) :fq)))
  (check (every (lambda (r5 r3) (and (equal (butlast (cdr r5)) (cdr r3)) (< (car (last r5)) (reduce #'min (cdr r3)))))
                (getf q5 :rules) (getf q3 :rules))))
;; §8.19 round 5 step 10 (the user, 2026-11-10: 「新增一鍵開多條規則」): an arm turns several one-job rules on together by naming several data
;; units. :A-HK-ALL expands to the plist step 9's fidelity run played (hksplit/allon.arms; 400 of 400 seeds = round 3's b3_a1), each one-job
;; arm carries only its own key, and with an arm active STRAT-OUT reads exactly the rules it names
(flet ((plays (u) (loop for (k v) on u by #'cddr unless (eq k :id) append (list k v))))
  (check (equal (plays (strat-arm :a-hk-all))
                '(:fn hisagi-hk-style :ken-ranged t :apply (:hisagi) :base (:hk-wake 1.0 :hk-pot 1.0 :hk-kite 1.0))))
  (check (equal (plays (strat-arm :a-hk-wake)) '(:fn hisagi-hk-style :ken-ranged t :apply (:hisagi) :base (:hk-wake 1.0)))))
(dolist (r '((:a-hk-wake t nil nil) (:a-hk-pot nil t nil) (:a-hk-kite nil nil t) (:a-hk-all t t t)))
  (let ((now (cons (strat-arm (first r)) '(:lead 0))))
    (check (equal (rest r) (mapcar (lambda (k) (and (strat-out now k nil) t)) '(:hk-wake :hk-pot :hk-kite))))))
(check (null (strat-out nil :hk-wake nil)))   ; (no strategy: every rule off, the style = his merged style)
;; DUEL_AI_STRATEGY §11.3 (PLAN §7 step 3): the SP cues and :RB-SP, off until a table names it. The cells are crisp full cells (100.0 = one:
;; regen stops there), the burst and exchange cues 0 / 1; every group of :RB-SP covers each cue point once (its firing adds up to 1, no dead
;; band); a hand-written table on it expands, switches on an SP cue alone, and is refused without :XFEATS (its cues are STRAT-XFEATS')
(check (equal (mapcar (lambda (fs) (getf (strat-sp-cues fs 0.0 nil nil -1 -1) :mcell)) '(0.0 99.9 100.0 199.9 200.0 299.9 300.0))
              '(0 0 1 1 2 2 3)))
(check (equal (strat-sp-cues 250.0 100.0 :blue nil 7 7) '(:mcell 2 :ocell 1 :mburst 1 :oburst 0 :xch 1)))
(check (equal (strat-sp-cues 0.0 300.0 nil :orange 7 9) '(:mcell 0 :ocell 3 :mburst 0 :oburst 1 :xch 0)))
(check (equal (strat-sp-cues 0.0 0.0 nil nil -1 -1) '(:mcell 0 :ocell 0 :mburst 0 :oburst 0 :xch 0)))
(let* ((rb (find :rb-sp *strat-rule-bases* :key (lambda (u) (getf u :id)))) (antes (getf rb :antes)))
  (check (and (= 42 (length antes) (reduce #'+ (getf rb :groups))) (getf rb :xfeats)))
  (check (notany (lambda (a) (assoc :gauge a)) antes))
  (let ((ok t))                                                          ; (a grid over every cue's points and the distance's ramps)
    (dolist (lead '(-2 0 1)) (dolist (ost '(0 1 4)) (dolist (prev '(0 1 3)) (dolist (dm '(1.0 3.1 5.0 8.0)) (dolist (c '(0 1 3))
      (let ((feats (list* :lead lead :ost ost :prev prev :form (mod c 3) :dm dm
                          (strat-sp-cues (* 100.0 c) (* 100.0 (- 3 c)) (= c 1) (= c 3) (if (= c 0) 5 -1) 5)))
            (rest antes))
        (dolist (g (getf rb :groups))
          (unless (< (abs (- 1.0 (loop repeat g sum (strat-ante (pop rest) feats)))) 1e-5) (setf ok nil)))))))))
    (check ok))
  (flet ((tbl (&rest keys)
           (strat-expand `(:id :t-rb-sp :fq (:arms (nil :a-generic) :rule-base :rb-sp ,@keys
                                             :q ,(mapcar (lambda (a) (cond ((equal a '((:xch :yes))) '(0.0 2.0))
                                                                           ((member '(:mcell :no) a :test #'equal) '(0.0 1.0))
                                                                           (t '(0.0 0.0))))
                                                         antes))))))
    (let* ((st (tbl :xfeats t :period 30)) (fq (getf st :fq))
           (base '(:lead 0 :ost 0 :prev 0 :form 0 :dm 3.0 :mburst 0 :oburst 0)))
      (check (and (= 42 (length (getf fq :rules))) (equal '(18 9 9 4 2) (getf fq :groups)) (getf fq :xfeats)))
      (check (= 1 (strat-fq-pick fq (list* :mcell 0 :ocell 2 :xch 0 base))))   ; (my gauge empty: arm 1)
      (check (= 0 (strat-fq-pick fq (list* :mcell 2 :ocell 2 :xch 0 base))))   ; (two cells: arm 0, the tie's first)
      (check (= 1 (strat-fq-pick fq (list* :mcell 3 :ocell 0 :xch 1 base))))   ; (an exchange open: arm 1)
      (check (eq :a-generic (getf (strat-judge st (list* :mcell 0 :ocell 0 :xch 0 base)) :id)))
      (check (= (+ 3 (* 2 42)) (length (fq-encode fq fq 0)))))
    (check (handler-case (progn (tbl :period 30) nil) (error () t)))))
