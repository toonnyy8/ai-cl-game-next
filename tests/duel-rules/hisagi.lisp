                (equal (route kr :q '((:q) (:f))) '(:hs-r-j1 :hs-r-j2 :hs-r-k3))
                (equal (route kr :q '((:f) (:f))) '(:hs-r-j1 :hs-r-k2s :hs-r-k3))
