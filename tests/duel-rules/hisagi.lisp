                        (not (core-kikon-p (make-fighter :kit k) mv))))))
        (check (core-kikon-p (make-fighter :kit k) (kit-core-move k :as 1)))
        (check (every (lambda (n) (>= (let ((x (kit-move k n))) (- (mv-s x) (mv-enter x))) 14))
