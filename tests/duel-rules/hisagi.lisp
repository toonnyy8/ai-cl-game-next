    (check (and (equal (mapcar #'core-segments (getf (kit-core kr) :ns)) '((:hs-r-n1a :hs-r-n1b :hs-r-n1c) (:hs-r-n2a :hs-r-n2b :hs-r-n2c)))
                (equal (mapcar #'core-segments (getf (kit-core kr) :as)) '((:hs-r-as1) (:hs-r-as2 :hs-r-as2b) (:hs-r-as3 :hs-r-as3b :hs-r-as3c)))
                (equal (mapcar #'core-segments (getf (kit-core kb) :ns)) '((:hs-b-n1a :hs-b-n1b :hs-b-n1c) (:hs-b-n2a :hs-b-n2b :hs-b-n2c)))
                (equal (mapcar #'core-segments (getf (kit-core kb) :as)) '((:hs-b-as1) (:hs-b-as2 :hs-b-as2b) (:hs-b-as3 :hs-b-as3b :hs-b-as3c)))))
    ;; §28.3's numbers: the effective startups (S - :enter) and the damage (before :mult)
    (flet ((eff (n) (let ((x (m n))) (- (mv-s x) (mv-enter x))))
