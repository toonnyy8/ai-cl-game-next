                      (in-p :hs-r-k1 4.8) (not (in-p :hs-r-k1 4.9)) (in-p :hs-r-k1 0.0 :side 3.5)   ; (§25.35: 2.5-4.86)
                      (~= 2.5 (hw-min (svref (mv-hits (m :hs-r-k1)) 0)))
                      (in-p :hs-r-sp2 0.3) (in-p :hs-r-sp2 0.8 :i 1) (in-p :hs-r-sp2c 1.0) (in-p :hs-r-sp2 10.3 :i 1)
                      (notany #'hw-min (mv-hits (m :hs-r-sp2))) (notany #'hw-min (mv-hits (m :hs-r-sp2c)))
                      (eq :stagger (hw-react (svref (mv-hits (m :hs-r-k1)) 0)))
                      (equal '(27 33) (map 'list #'hw-from (mv-hits (m :hs-r-k2)))) (equal '(31 37) (map 'list #'hw-to (mv-hits (m :hs-r-k2))))
                      (equal '(:stagger :launch) (map 'list #'hw-react (mv-hits (m :hs-r-k2))))
                      (= 37 (+ (mv-s (m :hs-r-k2)) (mv-a (m :hs-r-k2)))))))
        ;; ... its launch carries the gathered K3G / J3G: the victim still airborne at their hit (the launch's air time) and
        ;; low enough for their 0.2-2.0 m arcs (his feet below 2.0 m)
        (let* ((air (ceiling (* 60 (/ (* 2 (getf *air-vy* :launch)) *gravity*)))) (w2 (svref (mv-hits (m :hs-r-k2)) 1)))
          (dolist (n '(:hs-r-k3g :hs-r-j3g))
            (let* ((tl (/ (- (+ (mv-s (m :hs-r-k2)) (mv-a (m :hs-r-k2)) (- (mv-s (m n)) (mv-enter (m n)))) (hw-from w2)) 60.0))
                   (y (- (* (getf *air-vy* :launch) tl) (* 0.5 *gravity* tl tl))))
              (check (or (and (< (* 60 tl) air) (< 0.2 y 1.6)) (format t "  Hisagi B4c: ~a after K2's launch at ~,2f m~%" n y))))))
        ;; ... the block gaps (the generic walk pins >= the Step's iframes for his J links): spread J2 / J3 8 f, the gathered
        ;; J2s 15 f, J3G 14 (after J2s) / 15 (after K2): every J1 of the roster (7-10) beats a blocked gathered J link
        (check (equal (list (blocked-gap (m :hs-r-j1) (m :hs-r-j2)) (blocked-gap (m :hs-r-j2) (m :hs-r-j3))
                            (blocked-gap (m :hs-r-k1) (m :hs-r-j2s)) (blocked-gap (m :hs-r-j2s) (m :hs-r-j3g))
                            (blocked-gap (m :hs-r-k2) (m :hs-r-j3g)))
                      '(8 8 15 14 15)))
        (setf *t-moved* nil)))
    ;; the drawn reach (the Bankai's clips, DUEL_HISAGI §21.8): each of its clips in *HS-STRIKE-REACH* (the FK test above
    ;; reads that reach) is drawn to it by its let-out crescents (*HS-LETOUT*), chain strikes (*HS-BK-CHAINS*) or lashes
    ;; (*HS-LASHES*, batch A2 §24.2: the ranged route links, their free ends on the keys, each rank's stagger, keys eased
    ;; 4 f apart or more, as %HS-LASH-TIP!): their farthest end out on each hit window's frames; every one of them reaches
    ;; its hit volume's far edge within 0.15 m (the arc's r, the line's end + its r, along his facing; a chain dropped on a
    ;; line within its r), and nothing lands past it; the table holds the first window's
    (flet ((lash-end (clip f cap)                                      ; the farthest lash end at clip frame F (NIL: none)
             (let ((best nil))
               (dolist (x *hs-lashes* best)
                 (destructuring-bind (c mask ds w f0 f1 &rest keys) x
                   (declare (ignore w f0 f1))
                   (when (eq c clip)
                     (dotimes (k (logcount mask))
                       (let ((ff (- f (* k ds))))
                         (when (<= (first (first keys)) ff (first (car (last keys))))
                           (let* ((i (position-if (lambda (y) (> (first y) ff)) keys))
                                  (a (nth (if i (max 0 (1- i)) (1- (length keys))) keys)) (b (if i (nth i keys) a))
                                  (x (if (eq a b) 0 (/ (- ff (first a)) (- (first b) (first a)))))
                                  (u (if (>= (- (first b) (first a)) 4) (* x x (- 3 (* 2 x))) x))
                                  (r (+ (second a) (* u (- (second b) (second a)))))
                                  (a0 (+ (fourth a) (* k (fifth a)))) (a1 (+ (fourth b) (* k (fifth b))))
                                  (az (+ a0 (* u (- (mod (+ (- a1 a0) 180) 360) 180))))
                                  (d (if cap (* r (cos (* az (/ pi 180)))) r)))
                             (setf best (max (or best d) d))))))))))))
      (let ((bk-moves '(:hs-r-j1 :hs-r-j2 :hs-r-j3 :hs-r-l :hs-r-sp1 :hs-r-sp2 :hs-r-kubikake
                        :hs-r-k1 :hs-r-k2s :hs-r-k3 :hs-r-k2 :hs-r-j2s :hs-r-k3g :hs-r-j3g      ; (A2: the route links)
                        :hs-b-j2 :hs-b-k1 :hs-b-k2 :hs-b-k3 :hs-b-sp1 :hs-b-l :hs-b-sp2   ; (A3, §24.3: SP2's own)
                        :hs-b-sj                                                         ; (§25.10: SENGEN)
                        :hs-k1 :hs-j2k :hs-j3k)))   ; (A1, §24.1: the Shikai's K1 sweep and leap J, their let-outs too)
        (dolist (n bk-moves)
          (let* ((mv (m n)) (clip (mv-clip mv)) (sr (third (assoc clip *hs-strike-reach*))))
            (check (null (getf *hs-r-clip-stand-ins* clip)))                ; (its own clip, no stand-in)
            (loop for hw across (mv-hits mv) for wi from 0
                  when (hw-vols hw)                                       ; (KOJO's yank: a :seg-fn window, §25.7)
                  do (let* ((vol (first (hw-vols hw)))
                            (cap (> (aref vol 0) 0.5)) (edge (if cap (+ (aref vol 2) (aref vol 4)) (aref vol 1)))
                            (sp (mv-clip-speed mv)) (c0 (* sp (hw-from hw))) (c1 (* sp (1- (hw-to hw))))   ; (the hit frames in
                            (ends (append (loop for (c nil nil f1 f2 nil r) in *hs-letout*                  ;  the clip's own: B4c's
                                                when (and (eq c clip) (<= f1 c0) (>= f2 c1)) collect r)      ;  J2 / J3 at S 10)
                                          (loop for (c nil nil f1 nil f3 nil r) in *hs-bk-chains*
                                                when (and (eq c clip) (<= f1 c1) (> f3 c0)) collect r)
                                          (remove nil (loop for f from (hw-from hw) below (hw-to hw)
                                                            collect (lash-end clip (* sp f) cap)))))
                            (art (and ends (reduce #'max ends))))
                       (check (or (and art (<= (abs (- art edge)) 0.15) (or (null sr) (> wi 0) (~= sr art)))
                                  (format t "~a ~a (window ~d): the volume ends ~,2f m, the drawn end ~a, the table ~a~%"
                                          n clip wi edge art sr)))))))))
    ;; A3 (DUEL_HISAGI §24.3, the user, 2026-10-18: 「可以，照這個順序開始畫」): the stand-ins all drawn (the list empty); L
    ;; SAHARAI, L KOJO and SP2 KAIBAKU-GEKI on their own clips at speed 1, each clip's :s mark on its move's S and its length
    ;; S + A + R; KAIBAKU-GEKI's sweep inside its 140 deg arc on every hit frame; KOJO's held chain taut before the drag
    (check (null *hs-r-clip-stand-ins*))
    (dolist (n '(:hs-r-l :hs-b-l :hs-b-sp2))
      (let* ((mv (m n)) (cl (mv-clip mv)))
        (check (or (and (~= (mv-clip-speed mv) 1.0) (= (mv-s mv) (round (* 60 (clip-mark cl :s))))
                        (= (+ (mv-s mv) (mv-a mv) (mv-r mv)) (round (* 60 (clip-dur (find-clip cl))))))
                   (format t "  Hisagi A3 ~a (~a): speed ~,2f, not on its S / length~%" n cl (mv-clip-speed mv))))))
    (let ((row (find-if (lambda (r) (and (eq (first r) :hs-kb-kaibaku) (eq (second r) :r))) *hs-letout*))
          (hw (svref (mv-hits (m :hs-b-sp2)) 0)))
      (destructuring-bind (c sd f0 f1 f2 f3 r h az bulge) row
        (declare (ignore c sd f0 f3 r h bulge))
        (check (or (loop for f from (hw-from hw) below (hw-to hw)
                         always (and (<= f1 f) (< f f2)
                                     (<= (abs (+ (second az) (* (/ (- f f1) (- f2 f1)) (- (third az) (second az)))))
                                         (* (aref (first (hw-vols hw)) 2) (/ 180 pi)))))   ; (the half angle)
                   (format t "  Hisagi A3 KAIBAKU-GEKI: its sweep leaves the arc~%")))))
    (check (let ((g (cdr (assoc :hs-kb-kojo (symbol-value '*hs-kb-grips*)))))
             (and g (= (first g) (mv-s (m :hs-b-l))) (< (second g) *hs-kojo-pull-at*))))
    ;; A1 (DUEL_HISAGI §24.1, the user, 2026-10-18: 「可以，照這個順序開始畫」): the Shikai's K string drawn. K1 NAGI: its
    ;; let-out out over every hit frame at r x the charge, on the charged copy's arc edge within 0.15 m at x1.0 and x1.6,
    ;; its sweep's bearing inside the arc (+- *HS-K1-ARC* / 2) on each; K2 NOKO, K2J, K3 TSUI (placed on the victim,
    ;; HS-FOE-SEG): every hit frame on a path segment held at the victim's centre (code 6 to 6), its points known codes
    (let ((row (find-if (lambda (r) (and (eq (first r) :hs-s-nagi) (eq (second r) :l))) *hs-letout*)))
      (destructuring-bind (c sd f0 f1 f2 f3 r h az bulge) row
        (declare (ignore c sd f3 h bulge))
        (flet ((bearing (f) (cond ((< f f1) (+ (first az) (* (/ (- f f0) (- f1 f0)) (- (second az) (first az)))))
                                  ((< f f2) (+ (second az) (* (/ (- f f1) (- f2 f1)) (- (third az) (second az)))))
                                  (t (third az)))))
          (dolist (n '(0 60))
            (let* ((mv (hs-scaled :hs-k1 n)) (hw (svref (mv-hits mv) 0)) (edge (aref (first (hw-vols hw)) 1))
                   (art (* r (hs-charge-scale n))))
              (check (or (and (eq (mv-clip mv) :hs-s-nagi) (<= (abs (- art edge)) 0.15)
                              (loop for f from (hw-from hw) below (hw-to hw)
                                    always (and (<= f1 f f2) (<= (abs (bearing f)) (/ *hs-k1-arc* 2)))))
                         (format t "  Hisagi A1 K1 x~,2f: the arc ends ~,2f, the sweep at ~,2f, bearings ~a~%" (hs-charge-scale n)
                                 edge art (loop for f from (hw-from hw) below (hw-to hw) collect (bearing f))))))))))
    (dolist (n '(:hs-k2 :hs-k2j :hs-k3))
      (let* ((mv (m n)) (hw (svref (mv-hits mv) 0)) (path (cdr (assoc (mv-clip mv) *hs-foe-paths*))))
        (check (or (and path (hw-seg hw) (= 1.0 (mv-clip-speed mv))
                        (every (lambda (g) (and (subsetp (list (third g) (fourth g)) '(0 6 7 8 9 10)) (member (fifth g) '(1 3 4))))
                               path)
                        (loop for f from (hw-from hw) below (hw-to hw)
                              always (let ((g (find-if (lambda (g) (and (<= (first g) f) (< f (second g)))) path)))
                                       (and g (= 6 (third g) (fourth g))))))
                   (format t "  Hisagi A1 ~a (~a): not on the victim on its hit frames~%" n (mv-clip mv))))))))

;;; §24.4 (the user, 2026-10-18: 「一套連段只能跳近一次」, 「3.0 m，風車銀接推更遠（推薦）」): K -> J (the leap) -> L -> K looped
;;; (K1 J2K J3 L K1 ..., K1 K2 J3K L K1 ...); his :link-ok hook refuses a second leap while the victim is still in the combo
;;; of the first (the string ends), cleared once the victim is back in neutral; no other kit has the hook; K1's dead zone
;;; 3.0 m and the bridge windmill's push 2.5 m (the neutral windmill's 1.5) so J1 -> L -> K1 still reaches
(let ((k (kit :hisagi :base)))
  (check (and (eq 'hs-link-ok (kit-hook k :link-ok)) (equal *hs-leaps* '(:hs-j2k :hs-j3k))
              (~= 3.0 *hs-k-dead*) (~= 2.5 *hs-bridge-kb*)
              (~= 2.5 (hw-kb (svref (mv-hits (find-move :hs-kaza-j)) 0))) (~= 1.5 (hw-kb (svref (mv-hits (find-move :hs-kaza)) 0)))
              (notany (lambda (cf) (and (not (eq (first cf) :hisagi)) (kit-hook (apply #'kit cf) :link-ok))) *forms*)))
  (multiple-value-bind (a b) (t-pair k (kit :kenpachi :base))
    (let ((st (hs a)))
      (setf (hss-leapt st) nil)
      (check (and (hs-link-ok a (find-move :hs-j2k)) (hs-link-ok a (find-move :hs-j3k))))
      (setf (hss-leapt st) t)
      (check (and (not (hs-link-ok a (find-move :hs-j2k))) (not (hs-link-ok a (find-move :hs-j3k)))
                  (hs-link-ok a (find-move :hs-k2)) (hs-link-ok a (find-move :hs-j3)) (hs-link-ok a (find-move :hs-k3))))
      (setf (fighter-state (fighter b)) :stun (fighter-combo-hits (fighter b)) 2)
      (hs-tick a (fighter a) nil)
      (check (hss-leapt st))                                     ; (the combo goes on: still refused)
      (setf (fighter-state (fighter b)) :idle (fighter-combo-hits (fighter b)) 0)
      (hs-tick a (fighter a) nil)
      (check (null (hss-leapt st)))                              ; (back in neutral: a new combo may leap)
      (setf (hss-leapt st) t)
      (hs-reset a)
      (check (null (hss-leapt st))))))

;;; §25.5 (the user, 2026-10-18: 「卍解的遠距 J / K 能取消 L 的後搖」): the ranged L SAHARAI's recovery is cancelled by J / K
;;; into J1 / K1 (the move's :params :r-cancel, read by MOVE-COMMANDS from its first recovery frame); §25.10: the bind's
;;; Step + J SENGEN into J1; no other move has it
(check (and (equal '(:q :f) (getf (mv-params (find-move :hs-r-l)) :r-cancel))
            (equal '(:q) (getf (mv-params (find-move :hs-b-sj)) :r-cancel))
            (loop for mv being the hash-values of *moves*
                  always (or (member (mv-name mv) '(:hs-r-l :hs-b-sj :ru-shimobashira :ru-hyoshin :ru-reido))   ; (+ Rukia's awakened L, 2026-10-26)
                             (null (getf (mv-params mv) :r-cancel))))))

;;; §25.5 (the user, 2026-10-18: 「卍解遠距的鎖鏈尾端除了傷害加成以外也增加 SP 恢復量的加成」): a tip hit (HS-DMG-MULT x1.3) marks his
;;; Reiatsu; his :hit hook pays the gain since the mark x *HS-R-TIP-SP-MULT* on top; a non-tip hit leaves no mark. §25.11
;;; (the user, 2026-10-19: 「幫我把遠距 J1 起手的散路線再增加額外的 SP 回收量」, x1.3, 「起手也加」): a spread-route hit (J1 and
;;; J2 / K2s / J3 / K3) is marked too, its gain x *HS-R-SPREAD-SP-MULT*, x the tip's on a tip hit (x1.69); the gathered
;;; route's guard x *HS-R-GATHER-GUARD-MULT* (the table above)
(check (and (~= 1.3 *hs-r-spread-sp-mult*) (~= 1.3 *hs-r-gather-guard-mult*)
            (loop for (n g0) in '((:hs-r-k1 14) (:hs-r-k2 14) (:hs-r-j2s 8) (:hs-r-k3g 18) (:hs-r-j3g 12))
                  always (loop for w across (mv-hits (find-move n)) always (= (hw-guard w) (round (* g0 *hs-r-gather-guard-mult*)))))))
(multiple-value-bind (h o) (t-pair (kit :hisagi :bankai) (kit :kenpachi :base))
  (let ((fh (fighter h)) (st (hs h)) (g (gauges h)))
    (t-at h 0 0) (t-at o 0 -4.5)
    (setf (fighter-form fh) :bankai)
    (flet ((try (n d2 mult r1)                                  ; (the hit's own gain: 10, from 100)
             (setf (gauges-reiatsu g) 100f0)
             (let ((x (hs-dmg-mult h o (svref (mv-hits (find-move n)) 0) (find-move n) nil d2)) (marked (hss-tip-r st)))
               (setf (gauges-reiatsu g) 110f0)
               (hs-bk-hit h o :hit nil (find-move n) nil t)
               (or (and (~= x mult) (eq (null marked) (~= r1 110.0)) (~= r1 (gauges-reiatsu g)) (null (hss-tip-r st)))
                   (format t "  Hisagi tip / spread SP ~a ~,2f: x~,2f, Reiatsu ~,2f~%" n d2 x (gauges-reiatsu g))))))
      (check (try :hs-r-k1 18.0625 1.71 113.0))                 ; (K1 at 4.25 m: the tip only: the damage x1.71, the SP x1.3)
      (check (try :hs-r-k1 9.0 1.0 110.0))                      ; (K1 at 3.0 m: no mark)
      (t-at o 0 -3.0)
      (check (try :hs-r-k2 9.0 1.0 110.0))                      ; (a gathered link at 3.0 m along its line: no SP extra)
      (t-at o 0 -5.75)
      (check (try :hs-r-j1 33.0625 1.71 116.9))                 ; (J1 at 5.75 m: the tip and the spread, the SP x1.69)
      (t-at o 0 -5.0)
      (check (try :hs-r-j1 25.0 1.0 113.0))                     ; (J1 at 5.0 m: the spread only)
      (check (try :hs-r-k2s 9.0 1.0 113.0)))))                  ; (a spread link: x1.3)

;;; >>> BEGIN HISAGI-CPU-TESTS: the checks of Hisagi's own CPU's shipped values and pure HS-AI-* / HS-R-AI-* / HS-B-AI-*
;;; functions (his CPU search, DUEL_HISAGI §25: a cell may rewrite THIS section only, to pin its own CPU; the lines between
;;; the markers are spliced into the frozen test by docs/research/hisagi-ai-drsi/splice-tests.py; nothing outside them).
(let* ((k (kit :hisagi :base)) (kr (kit :hisagi :bankai)))
  (flet ((m (n) (find-move n))
         (ordered (pl) (<= (getf pl :easy) (getf pl :normal) (getf pl :hard))))
    ;; which of his forms has the CPU's :move-reflex: the Shikai's HS-AI-MOVE, the ranged mode's HS-R-AI-MOVE, the bind's
    ;; HS-B-AI-MOVE (round01 b2a0 / b2a1's TODOME and cinching route, ported by cell b3a2)
    (check (and (eq 'hs-ai-move (getf (kit-ai k) :move-reflex)) (eq 'hs-r-ai-move (getf (kit-ai kr) :move-reflex))
                (eq 'hs-b-ai-move (getf (kit-ai (kit :hisagi :bankai-bind)) :move-reflex))))
    ;; the styles: RENSA / KARIBA by weight (one roll a match); every chance EASY <= NORMAL <= HARD, per style where it has one
    ;; (round01 cell b3a0: the weights by difficulty, HARD RENSA 0.8, EASY / NORMAL 0.55 / 0.45)
    (check (and (equal '(:easy :normal :hard) (loop for (dl nil) on *hs-ai-styles* by #'cddr collect dl))
                (every (lambda (dl) (let ((w (getf *hs-ai-styles* dl)))
                                      (and (equal '(:rensa :kariba) (loop for (st nil) on w by #'cddr collect st))
                                           (~= 1.0 (loop for (nil x) on w by #'cddr sum x)))))
                       '(:easy :normal :hard))
                (equal (getf *hs-ai-styles* :hard) '(:rensa 0.8 :kariba 0.2))
                (equal (getf *hs-ai-styles* :normal) '(:rensa 0.55 :kariba 0.45))
                (<= (getf (getf *hs-ai-styles* :normal) :rensa) (getf (getf *hs-ai-styles* :hard) :rensa))
                (every (lambda (pl) (and (ordered (getf pl :rensa)) (ordered (getf pl :kariba))))
                       (list *hs-ai-bridge-p* *hs-ai-jk-p* *hs-ai-style-leap-p* *hs-ai-k1-punish-p* *hs-ai-o-ender-p*))
                (ordered *hs-ai-o-ender-mash-p*)
                (every #'ordered (list *hs-ai-windmill-p* *hs-ai-kaza-k-p* *hs-ai-sp-ender-p* *hs-ai-throw-p*
                                       *hs-ai-guard-wait-p* *hs-ai-anti-breaker-p* *hs-ai-release-p* *hs-ai-kojo-p*
                                       *hs-ai-bind-sp-p* *hs-ai-modoshi-p*))
                (< (getf (getf *hs-ai-bridge-p* :kariba) :hard) (getf (getf *hs-ai-bridge-p* :rensa) :hard))   ; RENSA bridges
                (> (getf (getf *hs-ai-k1-punish-p* :kariba) :hard) (getf (getf *hs-ai-k1-punish-p* :rensa) :hard))))   ; KARIBA reaps
    ;; the Shikai's :ai: the awakening gate (round01 cell b3a0: 4500 -> 3000 taken), no neutral / reeling Kikon rush (the O ender only), the generic string-k 0
    ;; (HS-AI-MOVE picks every link), no neutral SHIBARI or Breaker
    (check (and (equal '(:min-taken 3000) (getf (kit-ai k) :awaken)) (eq (getf (kit-ai k) :awaken) *hs-ai-awaken*)
                (~= 0.0 (getf (kit-ai k) :kikon-range)) (~= 0.0 *hs-ai-string-k*)
                (~= 0.0 (getf (kit-ai k) :o-ender))   ; (his O ender: HS-AI-ENDER's roll by style)
                (notany (lambda (bd) (or (getf (cddr bd) :sp2) (getf (cddr bd) :breaker))) (getf (kit-ai k) :moves))))
    ;; his CPU (HS-AI-MOVE, the Shikai's :move-reflex): on a K1 / K2 hit's land step, beyond the dead zone, his intent close
    ;; (:approach / :pressure): one roll (*HS-AI-STYLE-LEAP-P*) -> J (the leap), else K; at :zone / :defend, inside the dead
    ;; zone: K, no roll; off any other step, a block or another link (K2J: no J after it): nothing (a J1 / J2 hit rolls the
    ;; bridge: not on the host, it has no sim stream)
    (check (and (hs-ai-leap-wanted-p 5.0 :approach) (hs-ai-leap-wanted-p 9.6 :pressure) (hs-ai-leap-wanted-p 3.1 :approach)
                (not (hs-ai-leap-wanted-p 3.0 :approach)) (not (hs-ai-leap-wanted-p 5.0 :zone)) (not (hs-ai-leap-wanted-p 5.0 :defend))))
    (multiple-value-bind (a b) (t-pair k (kit :kenpachi :base))   ; (the steps that roll nothing: the host has no sim stream)
      (declare (ignore b))
      (let ((fa (fighter a)) (br (make-brain)))
        (unless (fboundp 'why) (setf (symbol-function 'why) (lambda (b r c) (declare (ignore b r)) c)))
        (setf (hss-ai-style (hs a)) :rensa)
        (flet ((cpu (name intent d &key (sf 22) (land 22) (contact :hit))
                 (setf (fighter-state fa) :move (fighter-move fa) (m name) (fighter-sf fa) sf (fighter-land-sf fa) land
                       (fighter-contact fa) contact (fighter-queued fa) nil (fighter-dist fa) d (brain-intent br) intent)
                 (let ((*hs-ai-plan-p* '(:easy 0.0 :normal 0.0 :hard 0.0)))   ; (cell b0a2: no route plan, so no roll)
                   (hs-ai-move a br fa (m name)))))
          (check (and (eq :f (cpu :hs-k1 :zone 5.0)) (eq :f (cpu :hs-k2 :defend 8.0)) (eq :f (cpu :hs-k1 :approach 1.9))
                      (null (cpu :hs-k1 :approach 5.0 :sf 23)) (null (cpu :hs-k1 :approach 5.0 :contact :block))
                      (null (cpu :hs-k2j :approach 5.0)) (null (cpu :hs-j1 :approach 1.5 :contact :block))
                      (null (cpu :hs-k3 :approach 5.0))))
