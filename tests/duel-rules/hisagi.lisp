      (check (equal (mapcar #'react '(:hs-r-n1c :hs-r-n2c :hs-r-as1 :hs-r-as2b :hs-b-n1c :hs-b-n2c :hs-b-as1 :hs-b-as2b :hs-b-as3c
                                      :hs-r-n1a :hs-r-n2a :hs-r-as2 :hs-r-as3 :hs-r-as3c :hs-b-n1a :hs-b-n2a :hs-b-as3 :hs-b-as3b))
