                               (dmg :hs-r-k1 :hs-r-k2 :hs-r-k3g) (dmg :hs-r-k1 :hs-r-k2 :hs-r-j3g) (dmg :hs-r-k1 :hs-r-j2s :hs-r-j3g)))))
