                      (free (+ (hw-from w) hs 1 (if (eq (hw-react w) :launch)                    ;  gathered K2's launch, the
                                                    (ceiling (* 60 (/ (* 2 (getf *air-vy* :launch)) *gravity*)))   ;  air time)
                                                    (or (hw-stun w) (hitstun (hw-react w))))))
                      (hit (+ (mv-s ma) (mv-a ma) hs (- (mv-s mb) (mv-enter mb)))))
