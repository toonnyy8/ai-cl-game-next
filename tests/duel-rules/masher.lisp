;;;; masher.lisp — the seeded button-masher's pure pick and event clock (duel/lisp/masher.lisp; PLAN4 §5, the user 2026-11-15)
(in-package :duel)

;; the rates are the pre-registered ones and sum to 1
(check (equal (mapcar (lambda (r) (list (first r) (second r))) *masher-buttons*)
              '((:j 0.50) (:sp 0.15) (:step 0.10) (:hoho 0.07) (:burst 0.04) (:awaken 0.04) (nil 0.10))))
(check (equal (mapcar (lambda (r) (list (first r) (second r))) *masher-sticks*)
              '((:toward 0.55) (:away 0.15) (:left 0.10) (:right 0.10) (:neutral 0.10))))
(check (< (abs (- 1.0 (reduce #'+ (mapcar #'second *masher-buttons*)))) 1e-6))
(check (< (abs (- 1.0 (reduce #'+ (mapcar #'second *masher-sticks*)))) 1e-6))
;; a press is the command it names (control.lisp *COMMANDS*: J / Mod+J SP, Space Step / Mod+Space Hoho, P Burst / Mod+P awaken)
(check (equal (mapcar #'cddr *masher-buttons*)
              '((:quick nil) (:quick t) (:step nil) (:step t) (:awaken nil) (:awaken t) (nil nil))))
;; the stick: (strafe toward) relative to him, as a CPU's (VPAD-STICK! x = strafe, y = toward)
(check (equal (mapcar #'cddr *masher-sticks*) '((0f0 1f0) (0f0 -1f0) (-1f0 0f0) (1f0 0f0) (0f0 0f0))))

;; the pick's distribution over an even grid of u matches the rates (button by U1, stick by U3)
(flet ((shares (n key)
         (let ((h (make-hash-table)))
           (dotimes (i n) (incf (gethash (funcall key (masher-pick (/ (+ i 0.5) n) 0.5 (/ (+ i 0.5) n) t)) h 0)))
           h)))
  (let ((n 10000))
    (let ((b (shares n #'first)))
      (check (every (lambda (r) (< (abs (- (/ (gethash (first r) b 0) n) (second r))) 2e-3)) *masher-buttons*)))
    (let ((s (shares n #'fourth)))
      (check (every (lambda (r) (< (abs (- (/ (gethash (first r) s 0) n) (second r))) 2e-3)) *masher-sticks*)))))
;; the hold 2-12 and the gap 0-10 from U2: every (hold, gap) pair equally often over an even grid (uniform and independent)
(let ((h (make-hash-table :test 'equal)) (n (* 121 50)))
  (dotimes (i n) (let ((p (masher-pick 0.5 (/ (+ i 0.5) n) 0.5 t))) (incf (gethash (list (second p) (third p)) h 0))))
  (check (= (hash-table-count h) 121))
  (check (loop for v being the hash-values of h always (= v 50)))
  (check (loop for k being the hash-keys of h always (and (<= 2 (first k) 12) (<= 0 (second k) 10)))))
;; the ends of [0,1)
(check (equal (masher-pick 0.0 0.0 0.0 t) '(:j 2 0 :toward)))
(check (equal (masher-pick 0.9999999 0.9999999 0.9999999 t) '(nil 12 10 :neutral)))
(check (equal (masher-pick 0.5 0.5 0.5 t) '(:sp 7 5 :toward)))       ; (0.5 is past J's 0.50: SP)
;; no decision between events
(check (null (masher-pick 0.1 0.1 0.1 nil)))

;; one decision per event: over many steps the clock draws exactly three uniforms per event, only on the event's first step, and an
;; event lasts hold + 1 (the release) + gap steps
(let ((seed 12345) (draws 0) (events 0) (left 0) (ok t) (since 0) (len 0) (holds nil))
  (flet ((draw () (incf draws) (setf seed (mod (+ (* seed 1103515245) 12345) 2147483648)) (/ seed 2147483648.0)))
    (dotimes (step 20000)
      (let ((d0 draws))
        (multiple-value-bind (p l) (masher-next left #'draw)
          (cond (p (unless (or (zerop events) (= since len)) (setf ok nil))   ; (the last event lasted exactly its length)
                   (incf events) (setf since 1 len (+ (second p) 1 (third p))) (push (second p) holds)
                   (unless (= (- draws d0) 3) (setf ok nil)))
                (t (incf since) (unless (= draws d0) (setf ok nil))))
          (setf left l)))))
  (check ok)
  (check (= draws (* 3 events)))
  (check (< 1000 events 3000))                                         ; (mean length 7 + 1 + 5 = 13 steps: ~1540 in 20000)
  (check (every (lambda (h) (<= 2 h 12)) holds)))
