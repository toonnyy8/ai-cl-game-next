;; Kenpachi KK (DUEL_AI_STRATEGY 8.19 round 4): one arm plist a line, in arm order; arms 0 / 1 are the shipped :q1-ken-* table's
;; (its 48 rules embed as the start table); arm 0 nil = no strategy, his shipped CPU with its matchup style CPU
nil
;; general: his KI style code (the shipped arm 1)
(:id :kp1-ken :fn ken-ki-style :apply (:kenpachi))
;; general: + the brawler's data
(:id :kp2-press :fn ken-ki-style :apply (:kenpachi) :base (:range 0.7 :ns 0.35 :hoho 0.5 :cont 1.3 :awaken 3.0 :p 1.0 :b-walk-in 0.06 :b-j1 0.05 :b-step-in 0.03 :b-wait -0.05 :b-walk-out -0.08 :b-step-out -0.05) :rules ((((:ost :down)) (:b-walk-in 0.14 :b-j1 0.12 :b-wait -0.12)) (((:dj :in)) (:b-j1 0.12 :b-step-out -0.1)) (((:dj :afar)) (:b-walk-in 0.12 :b-step-in 0.08)) (((:ost :active) (:dj :in)) (:b-hoho -0.05))))
;; general: + s7-kite's data
(:id :kp3-kite :fn ken-ki-style :apply (:kenpachi) :base (:range 3.2 :ns 1.0 :hoho 1.0 :kikon 0.4 :cont 1.3 :awaken 4.0 :p 1.0 :b-walk-out 0.05 :b-wait 0.04 :b-j1 -0.3 :b-walk-in -0.08 :b-step-in -0.05) :rules ((((:dn :reach)) (:b-sp 0.2 :b-walk-in -0.05)) (((:dn :out)) (:b-sp 0.15)) (((:dn :afar) (:wave :yes)) (:b-sp 0.22 :b-walk-in -0.06)) (((:do :in)) (:b-walk-out 0.2 :b-step-out 0.18 :b-j1 -0.1)) (((:do :reach)) (:b-walk-out 0.1 :b-step-out 0.08))))
;; general: + s3-zoner's data
(:id :kp4-zone :fn ken-ki-style :apply (:kenpachi) :base (:range 1.5 :ns 0.9 :hoho 1.1 :kikon 0.4 :cont 0.8 :p 1.0 :b-walk-out 0.02 :b-wait 0.02 :b-j1 -0.08 :b-walk-in -0.04) :rules ((((:dn :reach)) (:b-sp 0.15 :b-walk-in -0.05)) (((:dn :out)) (:b-sp 0.1 :b-walk-in 0.04)) (((:dn :afar) (:wave :yes)) (:b-sp 0.18 :b-walk-in -0.04)) (((:do :in)) (:b-walk-out 0.12 :b-step-out 0.1 :b-j1 -0.05)) (((:dj :in)) (:b-step-out 0.08 :b-j1 0.05))))
