;; the Hisagi mirror (DUEL_AI_STRATEGY 8.19, 「照試做方式重做，含 press」): one arm plist a line, in arm order; arm 0 the kite (the best
;; whole-game arm against the shipped mirror table, the start table)
;; general: the kite, the merged code + s7-kite's data
(:id :hm4-kite :fn hisagi-merged-style :ken-ranged t :apply (:hisagi) :base (:range 3.2 :ns 1.0 :hoho 1.0 :kikon 0.4 :cont 1.3 :awaken 4.0 :p 1.0 :b-walk-out 0.05 :b-wait 0.04 :b-j1 -0.3 :b-walk-in -0.08 :b-step-in -0.05) :rules ((((:dn :reach)) (:b-sp 0.2 :b-walk-in -0.05)) (((:dn :out)) (:b-sp 0.15)) (((:dn :afar) (:wave :yes)) (:b-sp 0.22 :b-walk-in -0.06)) (((:do :in)) (:b-walk-out 0.2 :b-step-out 0.18 :b-j1 -0.1)) (((:do :reach)) (:b-walk-out 0.1 :b-step-out 0.08))))
;; general: all-round, the ranged mode's distance rule
(:id :hm1-merged :fn hisagi-merged-style :ken-ranged t :apply (:hisagi))
;; general: close pressure, the merged code + the brawler's data
(:id :hm3-press :fn hisagi-merged-style :ken-ranged t :apply (:hisagi) :base (:range 0.7 :ns 0.35 :hoho 0.5 :cont 1.3 :awaken 3.0 :p 1.0 :b-walk-in 0.06 :b-j1 0.05 :b-step-in 0.03 :b-wait -0.05 :b-walk-out -0.08 :b-step-out -0.05) :rules ((((:ost :down)) (:b-walk-in 0.14 :b-j1 0.12 :b-wait -0.12)) (((:dj :in)) (:b-j1 0.12 :b-step-out -0.1)) (((:dj :afar)) (:b-walk-in 0.12 :b-step-in 0.08)) (((:ost :active) (:dj :in)) (:b-hoho -0.05))))
;; general: the DRIVE switch route
(:id :hm2-dswitch :fn hisagi-merged-style :ken-ranged t :apply (:hisagi) :base (:dswitch 1.0) :dswitch-map ((:base 1 3)))
;; targeted: Kenpachi's KI style code (no style code aimed at Hisagi exists; this is the only other style function)
(:id :ht3-ki :fn ken-ki-style :apply (:hisagi :hisagi) :base (:p 1.3))
