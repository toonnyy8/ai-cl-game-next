;;;; scene.lisp — the late-match finish's scripted check (arms5/finish.md §3): one set-up state, only the clock and the score changed.
;;;; P1 a HARD CPU Kenpachi in Nozarashi (arms5 `t0-kh-kenpachi`), P2 a HARD CPU Hisagi in the bind mode (arms5 `t0-kh-hisagi`): the kh5
;;;; stare's forms and tables. Both full Reishi and flash-step, idle 1.4 m apart, P1 / P2 Konpaku K1 / K2, LEFT seconds on the timer; then
;;;; SECS seconds of play. Per 30 steps a "sc" line per side (seconds left, FINISH-ROLE as CAI-FINISH reads it, quiet, distance, state), each
;;;; move start ("mv"), the CPU's finish decisions (the combat log's "cpu finish"), and an end line: per side the move starts and the first.
;;;; Usage: ecl-host --norc --load docs/research/strategy-drsi/sp/arms5/finish/scene.lisp -- <duel.fas> LEFT K1 K2 [SECS [R1 [DIST]]]
;;;; (R1: P1's Reishi in % of his bar, default 100; DIST: the start distance in dm, default 14)
(load (merge-pathnames "tools/simgate/prelude.lisp" (truename "./")) :verbose nil)
(in-package :duel)
(defvar *sc-args* (mapcar #'parse-integer (rest cl-user::*sg-args*)))
(defvar *sc-t5* "docs/research/strategy-drsi/sp/arms5/t0/")
(defvar *sc-n* (vector 0 0)) (defvar *sc-first* (vector nil nil)) (defvar *sc-was* (vector nil nil)) (defvar *sc-t0* 0)
(cl-user::sg-init)
(engine::%frame)
(ensure-battle :kenpachi :hisagi :cpu t)
(destructuring-bind (left k1 k2 &optional (secs 12) (r1 100) (dist 14)) *sc-args*
  (dolist (e (list *p1* *p2*)) (full-gauges! e))
  (let ((g1 (gauges *p1*)))
    (setf (gauges-awakened g1) t (gauges-awaken g1) 0f0 (gauges-evolution g1) nil)
    (set-form *p1* :nozarashi))
  (hs-awaken-now! *p2*) (hs-bind-start! *p2*) (set-form *p2* :bankai-bind)
  (setf (gauges-konpaku (gauges *p1*)) k1 (gauges-konpaku (gauges *p2*)) k2)
  (setf (gauges-reishi (gauges *p1*)) (floor (* r1 (gauges-reishi-max (gauges *p1*))) 100))
  (place *p1* *p2* (/ dist 10.0))
  (loop for e in (list *p1* *p2*) for file in '("t0-kh-kenpachi.lisp" "t0-kh-hisagi.lisp")
        do (let ((b (brain e)))
             (setf (brain-difficulty b) :hard (brain-delay b) (getf *ai-delay* :hard) (brain-off b) nil)
             (brain-set-strat! b (cl-user::sg-read-strat (concatenate 'string *sc-t5* file)))))
  (setf *timer* (* 60 left) *combat-log* t)
  (setf *sc-t0* *match-tick*)
  (let ((n *sc-n*) (first *sc-first*) (was *sc-was*) (t0 *sc-t0*))
    (setf *step-hook*
          (lambda ()
            (when (eq *flow* :battle)
              (do-sides (e)
                (let* ((f (fighter e)) (b (brain e)) (side (fighter-side f)) (g (gauges e)) (go (gauges (fighter-opp f)))
                       (p (pos-of e)) (q (pos-of (fighter-opp f)))
                       (d (sqrt (+ (expt (- (aref p 0) (aref q 0)) 2) (expt (- (aref p 2) (aref q 2)) 2))))
                       (quiet (- *match-tick* (brain-fin-t b))))
                  (when (and (eq (fighter-state f) :move) (not (eq (svref was side) :move)) (fighter-move f))
                    (incf (svref n side))
                    (unless (svref first side) (setf (svref first side) (/ (- *match-tick* t0) 60.0)))
                    (format t "mv ~,2f P~d ~(~a~) d ~,2f~%" (/ (- *match-tick* t0) 60.0) (1+ side) (mv-name (fighter-move f)) d))
                  (setf (svref was side) (fighter-state f))
                  (when (zerop (mod (- *match-tick* t0) 30))
                    (format t "sc ~,1f s left P~d role ~(~a~) quiet ~d d ~,2f st ~(~a~)~%" (/ (match-frames-left) 60.0) (1+ side)
                            (finish-role (match-frames-left) (* 60 *match-seconds*) quiet (+ (getf *cai-think* (brain-difficulty b) 22) 12)
                                         (gauges-konpaku g) (gauges-reishi g) (gauges-reishi-max g)
                                         (gauges-konpaku go) (gauges-reishi go) (gauges-reishi-max go))
                            quiet d (fighter-state f))))))))
    (loop repeat (* 60 secs) while (eq *flow* :battle) do (engine::%frame))
    (format t "end left ~d K ~d-~d: moves P1 ~d (first ~a s) P2 ~d (first ~a s)~%" left k1 k2 (svref *sc-n* 0) (svref *sc-first* 0) (svref *sc-n* 1) (svref *sc-first* 1))))
(finish-output)
(ext:quit 0)
