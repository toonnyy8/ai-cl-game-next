;;;; Rukia's Shikai catalogue trials (tools/combo-trial.py; DUEL_RUKIA_TYBW §17). P2 Kenpachi, a standing dummy unless
;;;; :dummy :guard; P1 2 Reiatsu bars; a press :on :hit waits for its move to land (a cancel), :on :free for her neutral, full flash step. J starts at 1.6 m, K at 2.5 m (their openers' reach).
;; A. the six routes on a hit
(:name "A1 J1 J2 J3" :dist 1.6 :bars 2 :script ((:quick 1) (:quick 1) (:quick 1)) :frames 150)
(:name "A2 J1 J2 K3" :dist 1.6 :bars 2 :script ((:quick 1) (:quick 1) (:flash 1)) :frames 150)
(:name "A3 J1 K2s K3" :dist 1.6 :bars 2 :script ((:quick 1) (:flash 1) (:flash 1)) :frames 150)
(:name "A4 K1 K2 K3" :dist 2.5 :bars 2 :script ((:flash 1) (:flash 1) (:flash 1)) :frames 160)
(:name "A5 K1 K2 J3" :dist 2.5 :bars 2 :script ((:flash 1) (:flash 1) (:quick 1)) :frames 160)
(:name "A6 K1 J2s J3" :dist 2.5 :bars 2 :script ((:flash 1) (:quick 1) (:quick 1)) :frames 160)
;; B. the bursts (L off a link that hit), 3 layers on him, then 1 layer
(:name "B1 J1 +L 霜散 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:sig 1)) :frames 120)
(:name "B2 J1 J2 +L 雪煙 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:quick 1) (:sig 1)) :frames 120)
(:name "B3 J1 J2 J3 +L 霜陣 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:quick 1) (:quick 1) (:sig 1)) :frames 300)
(:name "B4 K1 +L 氷礫 (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:sig 1)) :frames 120)
(:name "B5 K1 K2 +L 氷柱 (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:flash 1) (:sig 1)) :frames 140)
(:name "B6 K1 K2 K3 +L 白漣 (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:flash 1) (:flash 1) (:sig 1)) :frames 200)
(:name "B7 J1 K2s +L 氷柱 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:flash 1) (:sig 1)) :frames 140)
(:name "B8 K1 J2s +L 雪煙 (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:quick 1) (:sig 1)) :frames 140)
(:name "B9 J1 J2 J3 +L 霜陣 (1)" :dist 1.6 :bars 2 :layers 1 :script ((:quick 1) (:quick 1) (:quick 1) (:sig 1)) :frames 300)
(:name "B10 K1 K2 K3 +L 白漣 (1)" :dist 2.5 :bars 2 :layers 1 :script ((:flash 1) (:flash 1) (:flash 1) (:sig 1)) :frames 200)
(:name "B11 K1 K2 K3 +L (0: refused)" :dist 2.5 :bars 2 :layers 0 :script ((:flash 1) (:flash 1) (:flash 1) (:sig 1)) :frames 200)
;; C. SP / O off a link
(:name "C1 J1 SP1" :dist 1.6 :bars 2 :script ((:quick 1) (:flash 1 :modded t :on :hit)) :frames 150)
(:name "C2 J1 SP2" :dist 1.6 :bars 2 :script ((:quick 1) (:sig 1 :modded t :on :hit)) :frames 150)
(:name "C3 J1 J2 J3 SP2 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:quick 1) (:quick 1) (:sig 1 :modded t :on :hit)) :frames 160)
(:name "C4 K1 K2 K3 SP2 (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:flash 1) (:flash 1) (:sig 1 :modded t :on :hit)) :frames 180)
(:name "C5 K1 K2 K3 SP1" :dist 2.5 :bars 2 :script ((:flash 1) (:flash 1) (:flash 1) (:flash 1 :modded t :on :hit)) :frames 180)
(:name "C6 J1 J2 J3 O" :dist 1.6 :bars 2 :script ((:quick 1) (:quick 1) (:quick 1) (:kikon 1 :on :hit)) :frames 200)
(:name "C7 K1 K2 K3 O" :dist 2.5 :bars 2 :script ((:flash 1) (:flash 1) (:flash 1) (:kikon 1 :on :hit)) :frames 220)
(:name "C8 K1 K2 SP2 (2)" :dist 2.5 :bars 2 :layers 2 :script ((:flash 1) (:flash 1) (:sig 1 :modded t :on :hit)) :frames 160)
;; D. ORANGE: a route, the burst, the route again
(:name "D1 K1 K2 K3 ORANGE K1 K2 K3" :dist 2.5 :bars 2 :script ((:flash 1) (:flash 1) (:flash 1) (:quick 1 :modded t :on :hit) (:flash 1) (:flash 1) (:flash 1)) :frames 300)
(:name "D2 J1 J2 J3 ORANGE J1 J2 J3" :dist 1.6 :bars 2 :script ((:quick 1) (:quick 1) (:quick 1) (:quick 1 :modded t :on :hit) (:quick 1) (:quick 1) (:quick 1)) :frames 260)
;; E. the kido and SP2 alone, by distance
(:name "E1 BYAKURAI 3 m" :dist 3.0 :bars 2 :script ((:sig 1)) :frames 90)
(:name "E2 BYAKURAI 6 m" :dist 6.0 :bars 2 :script ((:sig 1)) :frames 90)
(:name "E3 TSUKISHIRO 6 m (hold)" :dist 6.0 :bars 2 :script ((:sig 30)) :frames 160)
(:name "E4 TSUKISHIRO 8 m (hold)" :dist 8.0 :bars 2 :script ((:sig 30)) :frames 160)
(:name "E5 SOKATSUI 3 m" :dist 3.0 :bars 2 :script ((:flash 1 :modded t)) :frames 120)
(:name "E6 SOKATSUI 5 m" :dist 5.0 :bars 2 :script ((:flash 1 :modded t)) :frames 120)
(:name "E7 RIKUJOKORO 4 m (short hold)" :dist 4.0 :bars 2 :script ((:flash 24 :modded t)) :frames 150)
(:name "E8 RIKUJOKORO 5.9 m (held) O" :dist 5.9 :bars 2 :script ((:flash 80 :modded t) (:kikon 30 :on :free)) :frames 260)
(:name "E9 RIKUJOKORO 4 m, Step in, K1 K2 K3" :dist 4.0 :bars 2 :script ((:flash 24 :modded t) (:step 1 :stick 1 :on :free) (:flash 1 :on :free) (:flash 1) (:flash 1)) :frames 300)
(:name "E9b RIKUJOKORO 4 m, walk in, K1 K2 K3 +L" :dist 4.0 :bars 2 :layers 1 :script ((:flash 24 :modded t) (:walk 12 :on :free) (:flash 1) (:flash 1) (:flash 1) (:sig 1)) :frames 320)
(:name "E9c RIKUJOKORO 4 m, O (red by the seal: Kikon)" :dist 4.0 :bars 2 :script ((:flash 24 :modded t) (:kikon 30 :on :free)) :frames 260)
(:name "E10 SP2 4 m (0)" :dist 4.0 :bars 2 :script ((:sig 1 :modded t)) :frames 120)
(:name "E11 SP2 4 m (3)" :dist 4.0 :bars 2 :layers 3 :script ((:sig 1 :modded t)) :frames 120)
(:name "E12 O 6 m" :dist 6.0 :bars 2 :script ((:kikon 1)) :frames 150)
(:name "E13 I (Breaker) 1.2 m" :dist 1.2 :bars 2 :script ((:breaker 1)) :frames 120)
(:name "E14 I K1 K2 K3" :dist 1.2 :bars 2 :script ((:breaker 1) (:flash 1 :on :hit) (:flash 1) (:flash 1)) :frames 220)
;; F. after a burst
(:name "F1 J1 +L 霜散 then BYAKURAI (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:sig 1) (:sig 1 :on :free)) :frames 160)
(:name "F2 K1 K2 +L 氷柱 then TSUKISHIRO (3)" :dist 2.5 :bars 2 :layers 3 :script ((:flash 1) (:flash 1) (:sig 1) (:sig 30 :on :free)) :frames 220)
(:name "F3 J1 J2 J3 +L 霜陣 then J1 J2 J3 (3)" :dist 1.6 :bars 2 :layers 3 :script ((:quick 1) (:quick 1) (:quick 1) (:sig 1) (:quick 1 :on :free) (:quick 1) (:quick 1)) :frames 300)
;; G. against a guard
(:name "G1 J1 J2 J3 / guard" :dist 1.6 :bars 2 :dummy :guard :script ((:quick 1) (:quick 1) (:quick 1)) :frames 120)
(:name "G2 K1 K2 K3 / guard" :dist 2.5 :bars 2 :dummy :guard :script ((:flash 1) (:flash 1) (:flash 1)) :frames 160)
(:name "G3 J1 / guard" :dist 1.6 :bars 2 :dummy :guard :script ((:quick 1)) :frames 80)
(:name "G4 K1 / guard" :dist 2.5 :bars 2 :dummy :guard :script ((:flash 1)) :frames 100)
(:name "G5 BYAKURAI 5 m / guard" :dist 5.0 :bars 2 :dummy :guard :script ((:sig 1)) :frames 100)
(:name "G6 RIKUJOKORO 4 m / guard" :dist 4.0 :bars 2 :dummy :guard :script ((:flash 24 :modded t)) :frames 150)
(:name "G7 SP2 4 m / guard" :dist 4.0 :bars 2 :dummy :guard :script ((:sig 1 :modded t)) :frames 120)
(:name "G8 I 1.2 m / guard" :dist 1.2 :bars 2 :dummy :guard :script ((:breaker 1)) :frames 120)
