;;;; stat-sheet.lisp — one character's forms against the roster's averages, from the kits (host only, no build):
;;;;   $ECL_HOST --norc --load tools/stat-sheet.lisp -- rukia > stats.md
;;;; Columns: each form of the character, then the other characters' awakened forms' average and all their forms' average
;;;; (the retired Lille out). Damage is the hit windows' damage x the form's dealt multiplier; a string sums its links (J1 J2
;;;; J3 / K1 K2 K3 by the :q / :f follow-ups); a hazard move (no hit window) has no damage here. Frame data as written in
;;;; the kit (the user 2026-10-25: 「將露琪亞（覺醒）的數值表與其他角色數值平均列出來給我」).
(dolist (f '("package" "math" "hitvol" "input"))
  (load (merge-pathnames (format nil "../engine/lisp/~a.lisp" f) *load-truename*)))
(defpackage :duel (:use :cl :engine))
(defmacro duel::defcine (&rest r) (declare (ignore r)) nil)
(defmacro engine:defcomponent (name &rest slots) `(defstruct (,name (:copier nil) (:predicate nil)) ,@slots))
(dolist (f '("tuning" "rules" "learn" "kit" "yama" "ken" "rukia-ai" "rukia" "ichigo" "endless-rules" "rogue-rules" "run-mods" "senjumaru"
             "barro" "barro-ai" "hisagi" "hisagi-ai"))
  (load (merge-pathnames (format nil "../duel/lisp/~a.lisp" f) *load-truename*)))
(in-package :duel)
(setf *print-pretty* nil)

(defun st-dmg (kit mv)
  (and mv (plusp (length (mv-hits mv))) (* (kit-mult kit) (loop for h across (mv-hits mv) sum (hw-dmg h)))))
(defun st-first (mv) (and mv (plusp (length (mv-hits mv))) (hw-from (svref (mv-hits mv) 0))))
(defun st-string (kit cmd)
  (let ((mv (kit-command-move kit cmd)) (sum 0))
    (when (and mv (st-dmg kit mv))
      (loop for m = mv then (kit-next kit (mv-name m) cmd) while m do (incf sum (or (st-dmg kit m) 0)))
      sum)))
(defun st-moves (kit)
  (let ((out nil))
    (flet ((add (m) (when (and m (not (member m out))) (push m out))))
      (dolist (c *kit-commands*) (add (kit-command-move kit c)))
      (loop for (nil nil to) in (kit-strings kit) do (add (kit-move kit to))))
    out))
(defun st-adv (mv) (and mv (integerp (mv-adv-block mv)) (mv-adv-block mv)))

(defparameter *st-rows*
  `(("walk (m/s)" ,(lambda (k) (kit-walk k)))
    ("run (m/s)" ,(lambda (k) (kit-run k)))
    ("Reishi" ,(lambda (k) (kit-reishi k)))
    ("x dealt" ,(lambda (k) (kit-mult k)))
    ("x taken" ,(lambda (k) (kit-taken k)))
    ("stun tolerance" ,(lambda (k) (stun-tolerance-of k)))
    ("J1 startup (f)" ,(lambda (k) (st-first (kit-command-move k :q))))
    ("J1 reach (m)" ,(lambda (k) (let ((m (kit-command-move k :q))) (and (st-first m) (move-edge m)))))
    ("J1 damage" ,(lambda (k) (st-dmg k (kit-command-move k :q))))
    ("J1 on block" ,(lambda (k) (st-adv (kit-command-move k :q))))
    ("K1 startup (f)" ,(lambda (k) (st-first (kit-command-move k :f))))
    ("K1 reach (m)" ,(lambda (k) (let ((m (kit-command-move k :f))) (and (st-first m) (move-edge m)))))
    ("K1 damage" ,(lambda (k) (st-dmg k (kit-command-move k :f))))
    ("K1 on block" ,(lambda (k) (st-adv (kit-command-move k :f))))
    ("J string damage" ,(lambda (k) (st-string k :q)))
    ("K string damage" ,(lambda (k) (st-string k :f)))
    ("L startup (f)" ,(lambda (k) (st-first (kit-command-move k :sig))))
    ("L damage" ,(lambda (k) (st-dmg k (kit-command-move k :sig))))
    ("SP1 bars" ,(lambda (k) (and (kit-command-move k :sp1) (kit-command-cost k :sp1))))
    ("SP1 startup (f)" ,(lambda (k) (st-first (kit-command-move k :sp1))))
    ("SP1 damage" ,(lambda (k) (st-dmg k (kit-command-move k :sp1))))
    ("SP2 bars" ,(lambda (k) (and (kit-command-move k :sp2) (kit-command-cost k :sp2))))
    ("SP2 startup (f)" ,(lambda (k) (st-first (kit-command-move k :sp2))))
    ("SP2 damage" ,(lambda (k) (st-dmg k (kit-command-move k :sp2))))
    ("SP2 on block" ,(lambda (k) (st-adv (kit-command-move k :sp2))))
    ("O startup (f)" ,(lambda (k) (st-first (kit-command-move k :kikon))))
    ("O damage" ,(lambda (k) (st-dmg k (kit-command-move k :kikon))))
    ("fastest hit (f)" ,(lambda (k) (let ((l (remove nil (mapcar #'st-first (st-moves k))))) (and l (reduce #'min l)))))
    ("longest reach (m)" ,(lambda (k) (let ((l (mapcar #'move-edge (remove-if-not #'st-first (st-moves k))))) (and l (reduce #'max l)))))))

(defun st-cell (x) (cond ((null x) "—") ((integerp x) (format nil "~d" x)) (t (format nil "~,2f" x))))
(defun st-avg (kits fn)
  (let ((l (remove nil (mapcar fn kits)))) (and l (/ (reduce #'+ l) (float (length l))))))

(let* ((ch (intern (string-upcase (or (second (member "--" ext:*command-args* :test #'string=)) "rukia")) :keyword))
       (mine (mapcar #'cdr (reverse (gethash ch *kits*))))
       (others (loop for c in *roster* unless (or (eq c ch) (member c *retired*))
                     append (mapcar #'cdr (reverse (gethash c *kits*)))))
       (aw (remove-if-not #'kit-awakening others)))
  (format t "# ~(~a~)'s forms against the roster~%~%Generated by `tools/stat-sheet.lisp -- ~(~a~)` from the kits (host). ~
Damage = the move's own hit windows x the form's dealt multiplier (a string: its links summed); a hazard it spawns or a ~
move a hook starts after it is not counted (a hazard-only move: —), so L / SP damage reads low for kits that deal it that ~
way. Averages skip a form without the move. Others' awakened forms (~d): ~{~a~^, ~}. All their forms: ~d.~%~%"
          ch ch (length aw) (mapcar (lambda (k) (format nil "~(~a ~a~)" (kit-character k) (kit-form k))) aw) (length others))
  (format t "| | ~{~a~^ | ~} | others awakened (avg) | others all forms (avg) |~%|---|~{~a~}---|---|~%"
          (mapcar (lambda (k) (format nil "~(~a~)~:[~; (awakened)~]" (kit-form k) (kit-awakening k))) mine)
          (mapcar (constantly "---|") mine))
  (loop for (label fn) in *st-rows*
        do (format t "| ~a | ~{~a~^ | ~} | ~a | ~a |~%" label (mapcar (lambda (k) (st-cell (funcall fn k))) mine)
                   (st-cell (st-avg aw fn)) (st-cell (st-avg others fn)))))
(ext:quit 0)
