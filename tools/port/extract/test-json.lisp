;;;; test-json.lisp — the extractor's JSON writer (json.lisp), host-only, no game image:
;;;;   $ECL_HOST --norc --load tools/port/extract/test-json.lisp      (exit 0 = ALL PASS, 1 = a failure)
(load (merge-pathnames "json.lisp" (directory-namestring *load-truename*)) :verbose nil)
(in-package :cl-user)
(defvar *fails* 0)
(defun check (obj want)
  (let ((got (with-output-to-string (s) (extract-json obj s))))
    (unless (string= got want)
      (incf *fails*)
      (format t "FAIL ~s -> ~a, want ~a~%" obj got want))))
(check 1.4f0 "1.4")
(check -0.0f0 "-0.0")
(check least-positive-single-float "1.4012985e-45")
(check pi "{\"f64\":\"3.141592653589793\"}")
(check '(:b 2 :a 1) "{\"a\":1,\"b\":2}")
(check 'ya-garb-set "\"YA-GARB-SET\"")
(check #(1 2) "[1,2]")
;; the writer's own rules (every float token holds '.' or 'e'; keyword lists stay arrays; nil; strings)
(check 1.0f0 "1.0")
(check 1f10 "1.0e10")
(check '(:a :b) "[\"a\",\"b\"]")
(check '(:a 1 :a 2) "[\"a\",1,\"a\",2]")
(check nil "null")
(check t "true")
(check "a\"b\\c" "\"a\\\"b\\\\c\"")
(check '((1 2) nil) "[[1,2],null]")
(format t "~:[ALL PASS~;~:*~d FAIL~]~%" (and (plusp *fails*) *fails*))
(ext:quit (if (zerop *fails*) 0 1))
