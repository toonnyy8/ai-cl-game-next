;;;; matchup-sheet.lisp — one fighter form against every other character's forms, from the kits (the CPU work's strategy
;;;; base, skill duel-character-cpu "Order"; the user 2026-10-25: 「請先以每個角色的幀數表、攻防距離等等資訊為基礎來規劃策略」).
;;;; Host only:  $ECL_HOST --norc --load tools/matchup-sheet.lisp -- rukia base > matchups.md
;;;; Per opponent form: his J1 / K1 (startup, far edge), his fastest hit, his longest reach, the moves he can't afford to have
;;;; blocked (block advantage at or below minus our J1's / K1's startup: punishable with them, distance allowing), and his
;;;; safe pokes; then the gap between our reach and his. Frame math only; the trials verify.
(dolist (f '("package" "math" "hitvol" "input"))
  (load (merge-pathnames (format nil "../engine/lisp/~a.lisp" f) *load-truename*)))
(defpackage :duel (:use :cl :engine))
(defmacro duel::defcine (&rest r) (declare (ignore r)) nil)
(defmacro engine:defcomponent (name &rest slots) `(defstruct (,name (:copier nil) (:predicate nil)) ,@slots))
(dolist (f '("tuning" "rules" "learn" "kit" "yama" "ken" "rukia-ai" "rukia" "ichigo" "endless-rules" "rogue-rules" "run-mods" "senjumaru"
             "barro" "barro-ai" "hisagi" "hisagi-ai"))
  (load (merge-pathnames (format nil "../duel/lisp/~a.lisp" f) *load-truename*)))
(in-package :duel)
(setf *print-pretty* nil)

(defun mu-moves (kit)
  "KIT's moves a player starts or chains: its commands, grid, strings' and L links' targets (no duplicates)."
  (let ((out nil))
    (flet ((add (m) (when (and m (not (member m out))) (push m out))))
      (dolist (c *kit-commands*) (add (kit-command-move kit c)))
      (dolist (n (getf (kit-spec kit) :grid)) (add (kit-move kit n)) (add (kit-l-link kit n)))
      (loop for (nil nil to) in (kit-strings kit) do (add (kit-move kit to))))
    (nreverse out)))
(defun mu-hit-p (mv) (plusp (length (mv-hits mv))))
(defun mu-first (mv) (hw-from (svref (mv-hits mv) 0)))
(defun mu-name (mv) (string-downcase (symbol-name (mv-name mv))))

(let* ((a (mapcar (lambda (s) (intern (string-upcase s) :keyword)) (rest (member "--" ext:*command-args* :test #'string=))))
       (me (find-kit (or (first a) :rukia) (or (second a) :base)))
       (j1 (kit-command-move me :q)) (k1 (kit-command-move me :f))
       (pj (mv-s j1)) (pk (mv-s k1)))
  (format t "# ~a ~(~a~) against the roster~%~%Generated by `tools/matchup-sheet.lisp` from the kits (frame math; the trials verify). ~
Ours: J1 ~d f, edge ~,2f m; K1 ~d f, edge ~,2f m. **Punish J1 / K1**: his moves blocked at ≤ −~d / ≤ −~d (startup vs his ~
disadvantage; the block's push may leave him out of reach). **Pokes**: his J / K links and L / SP at ≥ −4 on block.~%~%"
          (kit-name me) (kit-form me) pj (move-edge j1) pk (move-edge k1) pj pk)
  (format t "| Opponent | J1 (f, m) | K1 (f, m) | fastest hit | longest reach | punish with J1 (≤ −~d) | + with K1 only (≤ −~d) | his pokes (≥ −4) |~%|---|---|---|---|---|---|---|---|~%" pj pk)
  (dolist (ch *roster*)
    (unless (or (member ch *retired*) (eq ch (kit-character me)))
      (loop for (form . kit) in (reverse (gethash ch *kits*))
            do (let* ((ms (remove-if-not #'mu-hit-p (mu-moves kit)))
                      (oj (kit-command-move kit :q)) (ok (kit-command-move kit :f))
                      (fast (and ms (reduce (lambda (x y) (if (<= (mu-first x) (mu-first y)) x y)) ms)))
                      (far (and ms (reduce (lambda (x y) (if (>= (move-edge x) (move-edge y)) x y)) ms)))
                      (adv (lambda (m) (and (integerp (mv-adv-block m)) (mv-adv-block m))))
                      (pun-j (remove-if-not (lambda (m) (let ((b (funcall adv m))) (and b (<= b (- pj))))) ms))
                      (pun-k (remove-if-not (lambda (m) (let ((b (funcall adv m))) (and b (<= b (- pk)) (not (member m pun-j))))) ms))
                      (pokes (remove-if-not (lambda (m) (let ((b (funcall adv m))) (and b (>= b -4) (member (mv-kind m) '(:quick :flash :sig :sp))))) ms)))
                 (flet ((lst (l) (format nil "~{~a~^, ~}" (mapcar (lambda (m) (format nil "`~a` ~d" (mu-name m) (funcall adv m))) l))))
                   (format t "| ~(~a ~a~) | ~a | ~a | ~a | ~a | ~a | ~a | ~a |~%" ch form
                           (if (and oj (mu-hit-p oj)) (format nil "~d, ~,2f" (mu-first oj) (move-edge oj)) "—")
                           (if (and ok (mu-hit-p ok)) (format nil "~d, ~,2f" (mu-first ok) (move-edge ok)) "—")
                           (if fast (format nil "`~a` ~d f" (mu-name fast) (mu-first fast)) "—")
                           (if far (format nil "`~a` ~,1f m" (mu-name far) (move-edge far)) "—")
                           (lst pun-j) (lst pun-k) (lst pokes))))))))
(ext:quit 0)
