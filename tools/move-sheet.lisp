;;;; move-sheet.lisp — one fighter form's data sheet, printed as Markdown from the kit (the CPU work's step 1: skill
;;;; duel-character-cpu "Order", the user 2026-10-25). Host only, no build:
;;;;   $ECL_HOST --norc --load tools/move-sheet.lisp -- rukia base > sheet.md
;;;; Frame math follows the rules as written (rules.lisp HITSTUN / BLOCKSTUN / RECOVERY-FRAMES / CHAIN-OPEN-P /
;;;; CANCEL-OPEN-P): it is the catalogue's starting point, every combo is then verified in the native sim.
(dolist (f '("package" "math" "hitvol" "input"))
  (load (merge-pathnames (format nil "../engine/lisp/~a.lisp" f) *load-truename*)))
(defpackage :duel (:use :cl :engine))
(defmacro duel::defcine (&rest r) (declare (ignore r)) nil)
(defmacro engine:defcomponent (name &rest slots) `(defstruct (,name (:copier nil) (:predicate nil)) ,@slots))
(dolist (f '("tuning" "rules" "learn" "kit" "yama" "ken" "rukia" "ichigo" "endless-rules" "rogue-rules" "run-mods" "senjumaru"
             "barro" "barro-ai" "hisagi" "hisagi-ai"))
  (load (merge-pathnames (format nil "../duel/lisp/~a.lisp" f) *load-truename*)))
(in-package :duel)
(setf *print-pretty* nil)

(defun ms-args ()
  (let ((a (member "--" ext:*command-args* :test #'string=)))
    (mapcar (lambda (s) (intern (string-upcase s) :keyword)) (rest a))))

(defun ms-hw0 (mv) (and (plusp (length (mv-hits mv))) (svref (mv-hits mv) 0)))
(defun ms-stun (hw) (or (hw-stun hw) (hitstun (hw-react hw))))
(defun ms-down-p (hw) (member (hw-react hw) '(:knockdown :launch)))
(defun ms-hit-adv (mv)
  "Frames the attacker is ahead when MV's first window hits and nothing follows (the defender's stun against the
attacker's frames left; both share the hitstop). NIL for a knockdown / launch (he is down)."
  (let ((w (ms-hw0 mv)))
    (and w (not (ms-down-p w)) (- (ms-stun w) (- (mv-total mv) (hw-from w))))))
(defun ms-vol (mv)
  (let* ((w (ms-hw0 mv)) (v (and w (first (hw-vols w)))))
    (cond ((null v) (if (hw-seg-p mv) "seg" "—"))
          ((= (aref v 0) 1f0) (format nil "line ~,2f–~,2f r~,2f (edge ~,2f)" (aref v 1) (aref v 2) (aref v 4) (move-edge mv)))
          (t (format nil "arc ~,2f ~d°" (aref v 1) (round (* 2 (aref v 2) 57.29578)))))))
(defun hw-seg-p (mv) (let ((w (ms-hw0 mv))) (and w (hw-seg w))))
(defun ms-cell (x) (if x (format nil "~a" x) "—"))

(defun ms-row (kit mv tag)
  (let* ((w (ms-hw0 mv)) (k (mv-kind mv))
         (wr (recovery-frames (mv-r mv) nil (and (plusp (mv-whiff mv)) (mv-whiff mv)) k))
         (br (recovery-frames (mv-r mv) :block nil k)))
    (format t "| ~a | `~(~a~)` | ~(~a~) | ~d/~d/~d~@[ (enter ~d)~] | ~d / ~d | ~a | ~a | ~a | ~a | ~a | ~a | ~a | ~a |~%"
            tag (mv-name mv) k (mv-s mv) (mv-a mv) (mv-r mv) (and (plusp (mv-enter mv)) (mv-enter mv)) wr br
            (if w (format nil "~{~a~^ ~}" (loop for h across (mv-hits mv) collect (format nil "~d–~d:~d" (hw-from h) (1- (hw-to h)) (hw-dmg h))))
                "hazard")
            (if w (format nil "~(~a~) ~a" (hw-react w) (if (ms-down-p w) "down" (ms-stun w))) "—")
            (ms-cell (ms-hit-adv mv)) (ms-cell (mv-adv-block mv)) (ms-vol mv)
            (format nil "~@[slide ~,2f~]~@[ kb ~,2f~]" (and (plusp (mv-slide mv)) (mv-slide mv)) (and w (plusp (hw-kb w)) (hw-kb w)))
            (let ((c (mv-cost mv))) (if c (format nil "~a bar" c) "—"))
            (format nil "~{~(~a~)~^ ~}~@[ hold ~a~]" (remove-if (lambda (x) (consp x)) (mv-params mv)) (mv-hold mv)))))

(defun ms-edge (kit from to trigger)
  "A cancel edge FROM -> TO on a hit: when TO's first hit lands against when he is free (positive margin: a true combo)."
  (let* ((w (ms-hw0 from)) (hs (if w (hw-hs w) 0)) (tw (ms-hw0 to)))
    (when (and w tw)
      (let* ((open (case trigger ((:q :f :l) (+ (mv-s from) (mv-a from))) (t (hw-from w))))   ; chain: S + A; cancels: the hit
             (hit (+ open hs (- (hw-from tw) (mv-enter to))))
             (free (if (ms-down-p w) nil (+ (hw-from w) hs 1 (ms-stun w)))))
        (format t "| `~(~a~)` | ~(~a~) | `~(~a~)` | ~d | ~a | ~a |~%" (mv-name from) trigger (mv-name to) hit (ms-cell free)
                (cond ((null free) "he is down")
                      ((< hit free) (format nil "**combo** (+~d)" (- free hit)))
                      (t (format nil "gap ~d" (- hit free)))))))))

(let* ((args (ms-args)) (ch (or (first args) :rukia)) (form (or (second args) :base)) (kit (find-kit ch form))
       (seen nil))
  (format t "# ~a ~(~a~): data sheet~%~%Generated by `tools/move-sheet.lisp -- ~(~a ~a~)` from the kit (host, no build). Frames at 60 Hz. ~
Hit adv: his stun − her frames left (NIL: down). Whiff / block R: the recovery actually played.~%~%"
          (kit-name kit) form ch form)
  (format t "## Kit~%~%| | |~%|---|---|~%")
  (format t "| walk / run | ~,2f / ~,2f m/s |~%| Reishi | ~d |~%| x dealt / taken | ~,2f / ~,2f |~%| stun tolerance | ~a |~%"
          (kit-walk kit) (kit-run kit) (kit-reishi kit) (kit-mult kit) (kit-taken kit) (kit-stun-tolerance kit))
  (format t "| SP1 / SP2 cost | ~a / ~a bars |~%| awakens into | ~(~a~) |~%| rooted | ~a |~%~%"
          (kit-command-cost kit :sp1) (kit-command-cost kit :sp2) (kit-awaken-form kit) (kit-rooted kit))
  (format t "## Moves~%~%| Input | Move | Kind | S/A/R | whiff / block R | hits (frame: dmg) | reaction / stun | hit adv | block adv | volume | slide / kb | cost | params |~%|---|---|---|---|---|---|---|---|---|---|---|---|---|~%")
  (flet ((row (mv tag) (when (and mv (not (member mv seen))) (push mv seen) (ms-row kit mv tag))))
    (dolist (c '(:q :f :sig :sp1 :sp2 :breaker :kikon)) (row (kit-command-move kit c) (string-upcase (symbol-name c))))
    (loop for n in (getf (kit-spec kit) :grid) for tag in '("J1" "J2" "J3" "K1" "K2" "K3" "J2s" "K2s") do (row (kit-move kit n) tag))
    (loop for (from cmd to) in (kit-strings kit) do (row (kit-move kit to) (format nil "~(~a~) after ~(~a~)" cmd from)))
    (dolist (n (getf (kit-spec kit) :grid))
      (let ((l (kit-l-link kit n))) (when l (row l (format nil "L after ~(~a~)" n))))))
  (format t "~%## Cancels on a hit (frame math; the sim decides)~%~%Hit = the frame TO's first hit lands, counted from FROM's frame 0 at the earliest press; ~
free = the frame he can act. Chains (J / K links, L after a link) open at S + A; SP / Hoho / O cancels from the hit frame.~%~%| From | Via | To | hit | free | |~%|---|---|---|---|---|---|~%")
  (let ((grid (getf (kit-spec kit) :grid)))
    (loop for (from cmd to) in (kit-strings kit)
          when (member cmd '(:q :f)) do (ms-edge kit (kit-move kit from) (kit-move kit to) cmd))
    (dolist (n grid)
      (let ((l (kit-l-link kit n))) (when l (ms-edge kit (kit-move kit n) l :l))))
    (dolist (n (remove-duplicates grid))
      (dolist (c '(:sp1 :sp2))
        (let ((to (kit-command-move kit c))) (when to (ms-edge kit (kit-move kit n) to c))))
      (when (member :ender (mv-flags (kit-move kit n)))
        (let ((o (kit-command-move kit :kikon))) (when o (ms-edge kit (kit-move kit n) o :o))))))
  (format t "~%## Shared rules (tuning.lisp)~%~%| | |~%|---|---|~%")
  (format t "| Step | ~,1f m, ~d f, iframes ~a, J cancel from f~d |~%| Hoho | ~,1f m behind him, ~d f, iframes ~a, ~d flash step, lockout ~d f |~%"
          *step-distance* *step-frames* *step-iframes* *step-j-cancel* *hoho-distance* *hoho-frames* *hoho-iframes* (round *fs-hoho*) *hoho-lockout*)
  (format t "| Flash step | max ~d, +~,1f/s after ~d f idle, +~,2f a point taken |~%| Bursts | ~d flash step to start, drains ~,1f/s; BLUE needs ~d hits on him |~%"
          (round *fs-max*) *fs-regen* *fs-delay* *fs-taken* (round *fs-burst*) *burst-drain* *burst-min-hits*)
  (format t "| ORANGE | the next move within ~d f starts ~d % sooner; scaling restarts, −~d %/hit to ~d % while it runs |~%"
          *chain-window* (round (* 100 *chain-cut*)) (round (* 100 *orange-combo-decay*)) (round (* 100 *orange-combo-floor*)))
  (format t "| Reiatsu | 3 bars of ~d, +~,1f/s, +~,2f a point dealt, +~,2f taken |~%| Combo scaling | hits 1–~d full, −~d %/hit to ~d %; SPs and :unscaled windows full |~%"
          (round *reiatsu-bar*) *reiatsu-regen* *reiatsu-dealt* *reiatsu-taken* *combo-full-hits* (round (* 100 *combo-decay*)) (round (* 100 *combo-floor*)))
  (format t "| Ender push | out of the opener's far edge + slide + his body + ~,2f m, over ~d f |~%| Guard cancel | the last ~d % of a recovery |~%| Chain on block | the last ~d f of recovery |~%"
          *ender-push* *ender-push-frames* (round (* 100 *guard-cancel*)) *chain-lead*))
(ext:quit 0)
